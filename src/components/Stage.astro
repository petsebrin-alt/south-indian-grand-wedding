---
/**
 * Desktop Option B presentation: one phone mockup on maroon velvet inside the invitation card's
 * gold border, with its gold sprays in the corners (PRD §7.2). The velvet, border and sprays are
 * made from the client's card photograph (npm run opening:assets, scripts/opening/stage.ts) and
 * set as CSS backgrounds, so phones never download them.
 */
import QRCode from 'qrcode';
import Ornament from './Ornament.astro';
import velvet from '../assets/stage/velvet.webp';
import frame from '../assets/stage/frame.webp';
import spray from '../assets/stage/spray.webp';
import { wedding } from '../data/wedding';
import { formatDateLong } from '../lib/format';

const { groom, bride } = wedding.couple;
const qr = wedding.site.url
  ? await QRCode.toString(wedding.site.url, { type: 'svg', margin: 0, color: { dark: '#4B3026', light: '#FFFDF8' } })
  : null;
---

<div class="stage">
  <div class="stage__bg" aria-hidden="true" style={`--velvet:url("${velvet.src}");--frame:url("${frame.src}");--spray:url("${spray.src}")`}>
    <span class="stage__frame"></span>
    <span class="stage__spray stage__spray--tl"></span>
    <span class="stage__spray stage__spray--tr"></span>
    <span class="stage__spray stage__spray--bl"></span>
    <span class="stage__spray stage__spray--br"></span>
  </div>
  <aside class="stage__aside stage__aside--left" aria-hidden="true">
    <p class="stage__names">{groom.name} <span class="amp">&</span> {bride.name}</p>
    <Ornament name="divider" class="stage__divider" />
    <div class="stage__details">
      <span>{formatDateLong(wedding.ceremony.startISO)}</span>
      <span>{wedding.ceremony.city}</span>
    </div>
  </aside>
  <div class="device">
    <div class="device__bezel">
      <slot />
    </div>
  </div>
  <aside class="stage__aside stage__aside--right" aria-hidden="true">
    {
      qr ? (
        <Fragment>
          <div class="stage__qr" set:html={qr} />
          <p class="stage__qr-caption">Open on your phone</p>
        </Fragment>
      ) : (
        <p class="stage__qr-caption preview-only">QR code appears here once the domain is set (M-28).</p>
      )
    }
  </aside>
  <p class="stage__portrait-note" aria-hidden="true">Best viewed in portrait</p>
</div>
