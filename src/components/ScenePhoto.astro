---
/**
 * One of the opening's photographs: AVIF where the browser supports it, WebP otherwise.
 * `defer` leaves the files unrequested until src/motion/pages/cover.ts asks for them, so the
 * door photograph guests see first is not slowed by layers only needed after the bell is rung
 * (without JavaScript a plain copy shows instead).
 * `lazy` instead lets the browser fetch it once it is laid out (for layers hidden with display: none
 * until later, which still need to appear without JavaScript).
 * Class and style go on the <img> (the <picture> is display: contents).
 */
import type { ImageMetadata } from 'astro';

interface Props {
  avif?: ImageMetadata;
  webp: ImageMetadata;
  class?: string;
  style?: string;
  defer?: boolean;
  priority?: boolean;
  lazy?: boolean;
}

const { avif, webp, class: className, style, defer = false, priority = false, lazy = false } = Astro.props;
---

<picture class="scene-photo">
  {avif && <source type="image/avif" srcset={defer ? undefined : avif.src} data-srcset={defer ? avif.src : undefined} />}
  <img
    class={className}
    style={style}
    src={defer ? undefined : webp.src}
    data-src={defer ? webp.src : undefined}
    width={webp.width}
    height={webp.height}
    alt=""
    decoding="async"
    loading={lazy ? 'lazy' : undefined}
    fetchpriority={priority ? 'high' : undefined}
  />
  {defer && <noscript><img class={className} style={style} src={webp.src} width={webp.width} height={webp.height} alt="" decoding="async" /></noscript>}
</picture>

<style>
  .scene-photo {
    display: contents;
  }
</style>
