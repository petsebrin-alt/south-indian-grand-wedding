---
/** Event emblems, 48 px line art (THEME §6 S-11). */
const paths = {
  mehndi:
    '<path d="M24 40c-9 0-14-7-12-15 2-9 12-13 18-8 5 4 4 11-1 13-3 1-6-1-5-4"/><circle cx="17" cy="22" r="1"/><circle cx="20" cy="31" r="1"/><circle cx="27" cy="34" r="1"/><circle cx="31" cy="27" r="1"/><path d="M33 12c3 1 5 3 6 6M30 9c1-2 3-3 5-3"/>',
  haldi: '<path d="M8 27h32c-1 8-7 13-16 13S9 35 8 27z"/><path d="M14 27c2-6 6-9 10-9s8 3 10 9"/><path d="M30 14c3-4 8-5 11-3-2 4-6 6-11 3zM30 14c-1-3 0-6 2-8"/>',
  sangeet: '<path d="M8 28h24"/><circle cx="36" cy="28" r="7"/><circle cx="13" cy="34" r="4"/><path d="M8 28c-3-2-4-5-2-7s4 0 3 2"/><path d="M14 24v8M18 24v8M22 24v8M26 24v8"/>',
  wedding: '<path d="M16 41c-5-5-4-14 4-16h8c8 2 9 11 4 16z"/><path d="M19 25h10v-3H19z"/><path d="M24 22c-1-6 0-10 0-13M24 22c-4-4-8-6-12-6M24 22c4-4 8-6 12-6"/><ellipse cx="24" cy="12" rx="4" ry="5"/><path d="M19 32h10"/>',
  reception: '<path d="M10 31c3 6 25 6 28 0-6 2-22 2-28 0z"/><path d="M24 27c-3-4-1-8 0-11 1 3 3 7 0 11z"/><path d="M13 13l4 4 7-7 7 7 4-4"/><path d="M13 13v3M35 13v3"/>',
} as const;

interface Props {
  name: keyof typeof paths;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
