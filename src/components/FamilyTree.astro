---
/**
 * Full-screen family-tree overlay (PRD §6.7, THEME §13 P7). A flowering branch grows from the
 * groom or bride at the base, through parents, to grandparents and other relatives.
 * Missing relatives show as placeholders in preview and are hidden in production.
 * Motion: src/motion/tree.ts
 */
import Icon from './Icon.astro';
import { wedding } from '../data/wedding';

interface Props {
  side: 'groom' | 'bride';
}

const { side } = Astro.props;
const person = wedding.couple[side];
const fam = wedding.family[side];
const initials = (name: string | null) =>
  name
    ? name
        .split(/\s+/)
        .map((w) => w[0])
        .join('')
        .slice(0, 2)
        .toUpperCase()
    : '';

interface Node {
  x: number;
  y: number;
  label: string;
  names: (string | null)[];
  pair?: boolean;
  root?: boolean;
  twigFrom?: [number, number];
}

const byRelation = (word: string) => fam.grandparents.filter((g) => g.relation.toLowerCase().includes(word)).map((g) => g.name);
const paternal = byRelation('paternal');
const maternal = byRelation('maternal');
const siblings = fam.siblings.length ? fam.siblings : [null];

const nodes: Node[] = [
  { x: 50, y: 88, label: side === 'groom' ? 'The Groom' : 'The Bride', names: [person.name], root: true },
  ...siblings.slice(0, 4).map((s, i, list) => {
    const x = list.length === 1 ? 20 : [20, 80, 10, 90][i];
    return { x, y: 84, label: s ? s.relation : 'Sibling', names: [s ? s.name : null], twigFrom: [50, 94] as [number, number] };
  }),
  { x: 50, y: 62, label: 'Parents', names: [fam.father, fam.mother], pair: true },
  { x: 24, y: 37, label: 'Paternal Grandparents', names: paternal.length ? paternal : [null, null], pair: true, twigFrom: [50, 50] },
  { x: 76, y: 37, label: 'Maternal Grandparents', names: maternal.length ? maternal : [null, null], pair: true, twigFrom: [50, 50] },
];
const others = fam.others.length ? fam.others.map((o) => ({ name: o.name as string | null, relation: o.relation })) : [{ name: null, relation: 'Other relatives' }];
const missing = (n: Node) => n.names.every((v) => !v);

// The tree box is 2:3; the SVG uses a 100 × 150 user space so strokes are not distorted.
const Y = 1.5;
const trunk = 'M50 150 C46 135 54 120 50 105 C46 90 54 72 50 57 C47 42 53 30 50 15';
const twig = ([x0, y0]: [number, number], x: number, y: number) =>
  `M${x0} ${y0 * Y} C${(x0 + x) / 2} ${y0 * Y} ${x} ${((y0 + y) / 2 + 4) * Y} ${x} ${(y + 5) * Y}`;
const leaves = [92, 78, 66, 54, 44, 30, 18].map((y, i) => ({ y: y * Y, x: 50 + (i % 2 ? 2.5 : -2.5), r: i % 2 ? 35 : -35 }));
---

<div id={`tree-${side}`} class="overlay tree-overlay" role="dialog" aria-modal="true" aria-labelledby={`tree-${side}-title`} hidden data-tree>
  <header class="overlay__header">
    <h2 id={`tree-${side}-title`} class="overlay__title">{person.name}'s Family</h2>
    <button class="overlay__close" type="button" data-dialog-close data-autofocus aria-label="Close family tree">
      <Icon name="close" />
    </button>
  </header>
  <div class="overlay__body">
    <div class="tree">
      <svg class="tree__branch" viewBox="0 0 100 150" aria-hidden="true">
        <path class="tree__trunk" d={trunk} />
        {nodes.filter((n) => n.twigFrom).map((n) => <path class:list={['tree__twig', missing(n) && 'tree__missing']} d={twig(n.twigFrom!, n.x, n.y)} />)}
        <path class:list={['tree__twig', others.every((o) => !o.name) && 'tree__missing']} d="M50 33 C50 24 50 21 50 18" />
        {leaves.map((l) => <ellipse class="tree__leaf" cx={l.x} cy={l.y} rx="2.4" ry="1" transform={`rotate(${l.r} ${l.x} ${l.y})`} />)}
      </svg>

      <ul class:list={['tree__others', others.every((o) => !o.name) && 'tree__missing']}>
        {
          others.map((o) => (
            <li class:list={['tree__chip', !o.name && 'tree__missing']}>
              <strong>{o.name ?? 'To be provided'}</strong> <span>{o.relation}</span>
            </li>
          ))
        }
      </ul>

      {
        nodes.map((n) => (
          <div class:list={['tree__node', n.pair && 'tree__node--pair', n.root && 'tree__node--root', missing(n) && 'tree__missing']} style={`left:${n.x}%;top:${n.y}%`}>
            <span class="tree__medallion" aria-hidden="true">
              {n.names.map((name) => (
                <span class="tree__face">{initials(name) || 'R·D'}</span>
              ))}
            </span>
            <span class="tree__names">
              {n.names.map((name) => (
                <span class:list={['tree__name', !name && 'tree__name--ph']}>{name ?? 'To be provided'}</span>
              ))}
            </span>
            <span class="tree__rel">{n.label}</span>
          </div>
        ))
      }
    </div>
    <p class="tree__note preview-only">Placeholder relatives are shown in preview only. Add names in src/data/wedding.ts (family.{side}).</p>
  </div>
</div>

<style is:global>
  .tree-overlay .overlay__body {
    padding: 12px 16px calc(var(--safe-bottom) + 24px);
  }

  .tree {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    aspect-ratio: 2 / 3;
  }

  .tree__branch {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .tree__trunk,
  .tree__twig {
    fill: none;
    stroke: #8a6a44;
    stroke-linecap: round;
  }

  .tree__trunk {
    stroke-width: 1;
  }

  .tree__twig {
    stroke-width: 0.6;
  }

  .tree__leaf {
    fill: #6f8a3a;
    opacity: 0.85;
  }

  .tree__node {
    position: absolute;
    width: 36%;
    display: grid;
    justify-items: center;
    gap: 2px;
    text-align: center;
    translate: -50% -50%;
  }

  .tree__medallion {
    display: flex;
  }

  .tree__face {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 50% 40%, var(--jasmine), var(--sandal));
    border: 1.5px solid var(--gold);
    box-shadow:
      inset 0 0 0 3px var(--jasmine),
      0 4px 10px var(--shadow);
    font: 600 15px/1 var(--font-display);
    color: var(--gold-text);
  }

  .tree__node--pair .tree__face + .tree__face {
    margin-left: -12px;
  }

  .tree__node--root .tree__face {
    width: 68px;
    height: 68px;
    border-color: var(--maroon);
    color: var(--maroon);
    font-size: 18px;
  }

  .tree__names,
  .tree__rel {
    padding: 1px 6px;
    border-radius: 6px;
    background: rgba(255, 249, 239, 0.94);
  }

  .tree__names {
    display: grid;
    gap: 2px;
  }

  .tree__name {
    font: 600 14px/1.25 var(--font-display);
    color: var(--brown);
  }

  .tree__name--ph {
    padding: 0 4px;
    border: 1px dashed var(--gold);
    border-radius: 4px;
    background: rgba(244, 227, 181, 0.4);
    font: 500 10px/1.5 var(--font-body);
    color: var(--gold-deep);
  }

  .tree__rel {
    font: 500 9px/1.3 var(--font-royal);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .tree__others {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 2%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  .tree__chip {
    padding: 4px 10px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.92);
    font-size: 12px;
    color: var(--brown-soft);
  }

  .tree__chip strong {
    font-family: var(--font-display);
    color: var(--brown);
  }

  html:not(.preview) .tree__missing {
    display: none;
  }

  .tree__note {
    margin-top: 12px;
    font-size: 12px;
    text-align: center;
    color: var(--brown-soft);
  }
</style>
