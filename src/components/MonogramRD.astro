---
/**
 * The R·D logo (asset D-54): the client's pink-and-gold artwork with lotus and jhumka
 * (src/assets/opening/source/monogram.webp, trimmed and encoded by npm run opening:assets).
 * Requested after the door photograph (ScenePhoto `defer`); styled where it is used (Cover).
 */
import ScenePhoto from './ScenePhoto.astro';
import monogramAvif from '../assets/opening/monogram.avif';
import monogram from '../assets/opening/monogram.webp';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ScenePhoto class={['monogram-rd', className].filter(Boolean).join(' ')} avif={monogramAvif} webp={monogram} defer />
