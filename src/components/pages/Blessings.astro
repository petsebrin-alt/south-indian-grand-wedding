---
/** Page 3 — Divine Blessings (PRD §6.3, THEME §13 P2). Motion: src/motion/pages/blessings.ts */
import PageShell from '../PageShell.astro';
import Decor from '../Decor.astro';
import Lamp from '../Lamp.astro';
import Draft from '../Draft.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
const { copy } = wedding;
---

<PageShell
  page={page}
  index={index}
  watermark={false}
  class="bl"
  note="Placeholder art: D-10 arch, D-11 doors, D-12 gopuram, S-12 emblem (symbols only, Q-C1), D-13 thoranam, D-02 strands, D-06 lamps, D-20 scroll rollers."
>
  <Fragment slot="architecture">
    <div class="bl__temple layer layer--architecture" aria-hidden="true">
      <div class="bl__glide">
        <span class="bl__sky"></span>
        <Decor name="gopuram-misty" asset="D-12" class="bl__gopuram" eager />
        <span class="bl__light"></span>
        <Decor name="sacred-emblem" asset="S-12" class="bl__emblem" eager />
      </div>
      <div class="bl__frame">
        <div class="bl__doors">
          <Decor name="temple-door-left" asset="D-11" class="bl__door bl__door--l" eager />
          <Decor name="temple-door-right" asset="D-11" class="bl__door bl__door--r" eager />
        </div>
        <Decor name="temple-arch" asset="D-10" class="bl__arch" eager />
        <Decor name="mango-toran" asset="D-13" class="bl__toran" eager />
        <Decor name="jasmine-strand-long" asset="D-02" class="bl__strand bl__strand--l sway" style="--sway:1deg;--sway-dur:6s" eager />
        <Decor name="jasmine-strand-long" asset="D-02" class="bl__strand bl__strand--r sway" style="--sway:1deg;--sway-dur:6.6s;--sway-delay:-2s" eager />
      </div>
    </div>
  </Fragment>

  <div class="bl__scroll">
    <Decor name="scroll-roller" asset="D-20" class="bl__roller bl__roller--top" eager />
    <div class="bl__scroll-body">
      <p class="telugu bl__line" lang="te"><Draft copy={copy.invocationTe} /></p>
      <h2 class="eyebrow bl__line" tabindex="-1" data-page-heading><span class="sr-only">Divine Blessings: </span><Draft copy={copy.invocationEn} /></h2>
      <p class="display display--s bl__line"><Draft copy={copy.blessing} /></p>
    </div>
    <Decor name="scroll-roller" asset="D-20" class="bl__roller bl__roller--bottom" eager />
  </div>

  <Fragment slot="foreground">
    <Lamp class="layer layer--foreground bl__lamp bl__lamp--l" eager />
    <Lamp class="layer layer--foreground bl__lamp bl__lamp--r" eager />
  </Fragment>
</PageShell>

<style is:global>
  .bl .page__content {
    justify-content: flex-end;
  }

  /* Arch box keeps the artwork's 1080 × 1340 proportions; children use % of it */
  .bl__temple {
    left: 50%;
    top: calc(var(--safe-top) + 4cqh);
    height: min(53cqh, 108cqw);
    aspect-ratio: 1080 / 1340;
    translate: -50% 0;
  }

  .bl__glide,
  .bl__frame {
    position: absolute;
    inset: 0;
    transform-origin: 50% 62%;
  }

  .bl__sky {
    position: absolute;
    left: 16%;
    right: 16%;
    top: 22%;
    bottom: 0;
    background: linear-gradient(180deg, #fbf3e3 0%, #f6ead2 55%, #efe0c2 100%);
  }

  .bl__gopuram {
    position: absolute;
    left: 50%;
    top: 22%;
    width: 62%;
    translate: -50% 0;
    opacity: 0.75;
  }

  .bl__light {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 80%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 226, 160, 0.55) 0%, rgba(255, 226, 160, 0) 62%);
  }

  .bl__emblem {
    position: absolute;
    left: 50%;
    top: 40%;
    width: 46%;
    translate: -50% 0;
    filter: drop-shadow(0 4px 10px rgba(122, 87, 24, 0.25));
  }

  .bl__doors {
    position: absolute;
    left: 16.3%;
    width: 67.4%;
    top: 23.3%;
    bottom: 0;
    perspective: 900px;
  }

  .bl__door {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    object-fit: fill;
  }

  .bl__door--l {
    left: 0;
    transform-origin: 0 50%;
  }

  .bl__door--r {
    right: 0;
    transform-origin: 100% 50%;
  }

  .bl__arch {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bl__toran {
    position: absolute;
    left: 15%;
    width: 70%;
    top: 40.5%;
  }

  .bl__strand {
    position: absolute;
    top: 42%;
    width: 5%;
  }

  .bl__strand--l {
    left: 14.5%;
  }

  .bl__strand--r {
    right: 14.5%;
  }

  /* Lamps stand at the arch's feet */
  .bl__lamp {
    bottom: calc(var(--safe-bottom) + 43cqh);
    width: 11cqw;
  }

  .bl__lamp--l {
    left: 1cqw;
  }

  .bl__lamp--r {
    right: 1cqw;
  }

  /* Blessing scroll (D-20): ivory body between two rollers */
  .bl__scroll {
    position: relative;
    width: 108%;
    padding: 14px 0;
  }

  .bl__scroll-body {
    display: grid;
    gap: 0.6cqh;
    padding: 2cqh 7cqw;
    background-color: var(--jasmine);
    background-image: var(--paper-texture);
    background-blend-mode: multiply;
    box-shadow:
      inset 0 0 0 1px var(--hairline),
      0 6px 16px var(--shadow);
    transform-origin: 50% 50%;
  }

  .bl__roller {
    position: absolute;
    left: -3%;
    width: 106%;
    z-index: 1;
  }

  .bl__roller--top {
    top: 0;
  }

  .bl__roller--bottom {
    bottom: 0;
  }

  .bl__scroll-body .display {
    font-size: clamp(16px, 4.6cqw, 21px);
  }

  @container app (max-height: 699px) {
    .bl__temple {
      height: min(45cqh, 108cqw);
    }

    .bl__lamp {
      display: none;
    }

    .bl__scroll-body .display {
      font-size: 15px;
    }
  }
</style>
