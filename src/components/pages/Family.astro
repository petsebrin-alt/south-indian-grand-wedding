---
/**
 * Page 4 — Parents and Family (PRD §6.7), after the client's reference video of a 3D cube carousel: on the cream temple
 * background of the desktop screen (golden pillars, a paisley wall, swaying garlands and lamps; src/components/StageBackdrop.astro)
 * with the courtyard temple faded behind it (src/assets/family/), two maroon-and-gold boards, "The Groom's Family" and "The
 * Bride's Family", each over a card made of two blocks side by side, as in the video: a photograph block and a
 * description block. At rest they read as one gold-bordered card; every few seconds the two blocks turn, in opposite
 * directions (the photograph rolls its next face in from below, the description from above), to the siblings: the parents'
 * photograph with the father's and mother's names and what they do, then the sibling's photograph with their name. A
 * tap, a swipe, the arrow keys or the dots turn it by hand. Behaviour: src/motion/pages/family.ts
 */
import PageShell from '../PageShell.astro';
import StageBackdrop from '../StageBackdrop.astro';
import Icon from '../Icon.astro';
import ScenePhoto from '../ScenePhoto.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import { siteMode } from '../../lib/site-mode';
import temple from '../../assets/family/background.webp';
import templeAvif from '../../assets/family/background.avif';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
type Photo = { src: string; alt: string; focus?: string } | null;
type Person = { relation: string; name: string | null; work: string | null };
/** One thing the card shows: a photograph on one block and the words about it on the other */
type Face = { label: string; photo: Photo; people: Person[] };

const build = (key: 'groom' | 'bride', of: 'Groom' | 'Bride') => {
  const data = wedding.family[key];
  const parents: Person[] = [
    { relation: `Father of the ${of}`, name: data.father, work: data.fatherWork },
    { relation: `Mother of the ${of}`, name: data.mother, work: data.motherWork },
  ].filter((p) => p.name || siteMode === 'preview');
  const siblings: { person: Person; photo: Photo }[] = data.siblings.length
    ? data.siblings.map((s) => ({ person: { relation: `${s.relation} of the ${of}`, name: s.name, work: null }, photo: s.photo }))
    : siteMode === 'preview'
      ? [{ person: { relation: `Sibling of the ${of}`, name: null, work: null }, photo: null }]
      : [];
  // The parents, then each sibling on a face of their own (up to three)
  const faces: Face[] = [{ label: 'Parents', photo: data.photo, people: parents }, ...siblings.slice(0, 3).map((s) => ({ label: 'Sibling', photo: s.photo, people: [s.person] }))];
  // The four sides of each block: the faces repeat, so the blocks can turn on the same way for ever (one face alone does not turn)
  const sides = faces.length === 1 ? [0] : faces.length === 2 ? [0, 1, 0, 1] : faces.length === 3 ? [0, 1, 0, 2] : [0, 1, 2, 3];
  return { key, of, faces, sides };
};

const families = [
  { ...build('groom', 'Groom'), title: "The Groom's Family", partner: wedding.couple.groom.name },
  { ...build('bride', 'Bride'), title: "The Bride's Family", partner: wedding.couple.bride.name },
];
// What shows on a card: the relation without "of the Groom" (the board already says whose family it is)
const shortRelation = (relation: string) => relation.split(' of the ')[0];
const describe = (face: Face, of: string) => `${face.label} of the ${of}: ${face.people.map((p) => p.name ?? 'name to be provided').join(' and ')}`;
---

<PageShell page={page} index={index} watermark={false} class="fm">
  <Fragment slot="architecture">
    <StageBackdrop class="fm__scene">
      <ScenePhoto class="fm__temple" avif={templeAvif} webp={temple} defer />
    </StageBackdrop>
  </Fragment>

  <div class="fm__stack">
    <h2 class="sr-only" tabindex="-1" data-page-heading>Parents and Family, with the blessings of our beloved parents</h2>
    {
      families.map((f) => (
        <section class="fm__family" data-family={f.key} aria-label={f.title}>
          <header class="fm__board">
            <p class="fm__eyebrow">{f.partner}</p>
            <h3 class="fm__title">{f.title}</h3>
          </header>

          <div
            class="fm__cube"
            data-cube
            data-gesture="x"
            tabindex="0"
            role="group"
            aria-roledescription="carousel"
            aria-label={`${f.title}: ${f.faces.map((c) => c.label.toLowerCase()).join(' and ')}. ${f.faces.length > 1 ? 'The card turns by itself; use the arrow keys to turn it.' : ''}`}
          >
            {/* The photograph block turns one way (its next face comes up from below), the description block the other (from above) */}
            {
              ([
                { kind: 'photo', dir: 1 },
                { kind: 'text', dir: -1 },
              ] as const).map(({ kind, dir }) => (
                <div class={`fm__block fm__block--${kind}`} data-block data-dir={dir}>
                  <div class="fm__rig">
                    <div class="fm__box" data-cube-box>
                      {f.sides.map((c, side) => {
                        const face = f.faces[c];
                        return (
                          <div class="fm__face" data-face data-content={c} role={kind === 'text' ? 'group' : undefined} aria-roledescription={kind === 'text' ? 'slide' : undefined} aria-label={kind === 'text' ? describe(face, f.of) : undefined} aria-hidden={side === 0 ? 'false' : 'true'}>
                            <div class="fm__paper">
                              {kind === 'photo' ? (
                                face.photo ? (
                                  <>
                                    <img class="fm__shot" data-src={face.photo.src} alt={face.photo.alt} style={face.photo.focus ? `object-position:${face.photo.focus}` : undefined} decoding="async" draggable="false" />
                                    <noscript>
                                      <img class="fm__shot" src={face.photo.src} alt={face.photo.alt} decoding="async" />
                                    </noscript>
                                  </>
                                ) : (
                                  <span class="fm__ph">
                                    <span class="fm__ph-mono">R·D</span>
                                    <span class="fm__ph-note preview-only">Photo to be provided</span>
                                  </span>
                                )
                              ) : (
                                <>
                                  <p class="fm__tag">{face.label}</p>
                                  <div class="fm__people">
                                    {face.label === 'Sibling' && (
                                      <span class="fm__orn" aria-hidden="true">
                                        <Icon name="lotus" />
                                      </span>
                                    )}
                                    {face.people.map((p) => (
                                      <div class="fm__person">
                                        <span class="fm__rel">{face.label === 'Sibling' ? p.relation : shortRelation(p.relation)}</span>
                                        <span class="fm__name">{p.name ?? <span class="fm__tbp">Name to be provided</span>}</span>
                                        {p.work && <span class="fm__work">{p.work}</span>}
                                      </div>
                                    ))}
                                  </div>
                                </>
                              )}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="fm__dots" data-cube-dots>
            {f.faces.length > 1 && f.faces.map((c, j) => <button class:list={['fm__dot', j === 0 && 'is-active']} type="button" data-cube-dot={j} aria-label={`Show the ${c.label.toLowerCase()} of the ${f.of}`} />)}
          </div>
          <p class="sr-only" aria-live="polite" data-cube-live></p>
        </section>
      ))
    }
  </div>
</PageShell>

<style is:global>
  .fm .page__frame {
    display: none;
  }

  .fm .page__content {
    inset: 0;
    display: block;
  }

  /* The courtyard temple, faded and held back over the cream wall (a little less than full strength: 58%), its top and foot
     melting into the wall so no edge shows */
  .fm__temple {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 30%;
    opacity: 0.58;
    mask-image: linear-gradient(to bottom, transparent 0, #000 16%, #000 78%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 16%, #000 78%, transparent 100%);
  }

  /* ---------------------------------------------------------------- the two families, one above the other */
  .fm__stack {
    position: absolute;
    left: 5cqw;
    right: 5cqw;
    top: calc(var(--safe-top) + 62px);
    bottom: calc(var(--safe-bottom) + 62px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fm__family {
    flex: 1 1 0;
    min-height: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    row-gap: 9px;
  }

  /* The boards: deep maroon velvet in a grand gold frame (a thick gold band, a thin maroon rule and a fine gold line
     inside, with gold studs at the corners), as on the invitation card */
  .fm__board {
    position: relative;
    margin-inline: 1.6cqw;
    padding: 7px 4cqw 8px;
    border-radius: 14px;
    text-align: center;
    background:
      radial-gradient(ellipse 90% 120% at 50% 0%, rgba(150, 30, 48, 0.55), rgba(150, 30, 48, 0) 70%),
      linear-gradient(180deg, #70101f, #4d0913);
    box-shadow:
      0 0 0 3px #d9b062,
      0 0 0 4.5px #7a1020,
      0 0 0 7px #c99a43,
      0 0 0 8px rgba(255, 233, 170, 0.75),
      0 8px 18px rgba(40, 8, 8, 0.45),
      inset 0 0 0 1.5px rgba(240, 205, 125, 0.85),
      inset 0 0 14px rgba(20, 0, 4, 0.55);
    color: #f7e4ae;
  }

  .fm__board::before {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px dotted rgba(240, 205, 125, 0.7);
    border-radius: 10px;
    pointer-events: none;
  }

  .fm__board::after {
    content: '';
    position: absolute;
    inset: -3px;
    pointer-events: none;
    --stud: radial-gradient(circle at 35% 30%, #fff3c4 0, #e1b455 45%, #8a5a14 100%);
    background:
      var(--stud) left top / 9px 9px no-repeat,
      var(--stud) right top / 9px 9px no-repeat,
      var(--stud) left bottom / 9px 9px no-repeat,
      var(--stud) right bottom / 9px 9px no-repeat;
  }

  .fm__eyebrow {
    font: 700 clamp(9px, 2.6cqw, 11.5px) / 1.2 var(--font-royal);
    letter-spacing: 0.26em;
    text-indent: 0.26em;
    text-transform: uppercase;
    color: #efc86e;
  }

  .fm__title {
    margin-top: 1px;
    font: 400 clamp(23px, 7cqw, 31px) / 1.1 var(--font-script);
    color: #fbe9b7;
    -webkit-text-stroke: 0.3px currentColor;
    text-shadow: 0 1px 2px rgba(20, 0, 4, 0.6);
  }

  /* ---------------------------------------------------------------- the card: two blocks side by side, each a cube of four
     faces round a horizontal axis, turned by GSAP (src/motion/pages/family.ts) in opposite directions. A block's depth is its
     own height (cqh is the block's), so its front face lies flat on the page and the two read as one card. */
  .fm__cube {
    position: relative;
    min-height: 0;
    display: grid;
    grid-template-columns: 44fr 56fr;
    touch-action: pan-y pinch-zoom;
    outline-offset: 8px;
    cursor: pointer;
  }

  .fm__block {
    position: relative;
    min-height: 0;
    container-type: size;
    perspective: 1500px;
  }

  .fm__rig {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: translateZ(-50cqh);
  }

  .fm__box {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  /* Each face has a gold border (a metal gradient band) round its paper; where the two blocks meet the band is half as thick on
     each, so at rest the card has one gold divider in the middle */
  .fm__face {
    position: absolute;
    inset: 0;
    padding: 5px;
    background: linear-gradient(135deg, #f6e3a3 0%, #c9993f 30%, #f8ebb8 52%, #a8741f 100%);
    box-shadow:
      0 0 0 1px #7a5718,
      0 10px 18px rgba(50, 25, 5, 0.38);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .fm__block--photo .fm__face {
    padding-right: 2.5px;
    border-radius: 13px 3px 3px 13px;
  }

  .fm__block--text .fm__face {
    padding-left: 2.5px;
    border-radius: 3px 13px 13px 3px;
  }

  /* The sides: the photograph block (turning one way) has its next face below, the description block (the other way) above */
  .fm__face:nth-child(1) {
    transform: translateZ(50cqh);
  }

  .fm__block[data-dir='1'] .fm__face:nth-child(2) {
    transform: rotateX(-90deg) translateZ(50cqh);
  }

  .fm__block[data-dir='1'] .fm__face:nth-child(3) {
    transform: rotateX(-180deg) translateZ(50cqh);
  }

  .fm__block[data-dir='1'] .fm__face:nth-child(4) {
    transform: rotateX(-270deg) translateZ(50cqh);
  }

  .fm__block[data-dir='-1'] .fm__face:nth-child(2) {
    transform: rotateX(90deg) translateZ(50cqh);
  }

  .fm__block[data-dir='-1'] .fm__face:nth-child(3) {
    transform: rotateX(180deg) translateZ(50cqh);
  }

  .fm__block[data-dir='-1'] .fm__face:nth-child(4) {
    transform: rotateX(270deg) translateZ(50cqh);
  }

  .fm__paper {
    position: relative;
    width: 100%;
    height: 100%;
    container-type: size;
    overflow: hidden;
    background-color: #fff8e8;
    background-image: var(--paper-texture);
    background-blend-mode: multiply;
  }

  .fm__block--photo .fm__paper {
    border-radius: 8px 1px 1px 8px;
    box-shadow: inset 0 0 0 1.5px rgba(122, 16, 32, 0.6);
  }

  .fm__block--text .fm__paper {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    padding: 5cqh 4cqw 4cqh;
    border-radius: 1px 8px 8px 1px;
    box-shadow:
      inset 0 0 0 1.5px rgba(122, 16, 32, 0.6),
      inset 0 0 0 4px #fff8e8,
      inset 0 0 0 5px rgba(201, 162, 74, 0.65);
  }

  /* The face turning away darkens (set while it rolls) */
  .fm__paper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #2a0c06;
    opacity: var(--shade, 0);
    pointer-events: none;
  }

  .fm__shot {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    background: #e9d9b7;
  }

  .fm__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 4px;
    background: radial-gradient(ellipse at 50% 40%, #fbf3e3, #ead9b8);
    text-align: center;
  }

  .fm__ph-mono {
    font: 400 max(22px, 12cqh) / 1 var(--font-script);
    color: #8c1023;
  }

  .fm__ph-note {
    padding-inline: 8%;
    font: 500 max(8px, 4cqh) / 1.2 var(--font-body);
    color: #85735f;
  }

  /* The words: a label, then each person with their relation, name and what they do */
  .fm__tag {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3cqw;
    padding-top: 1cqh;
    font: 700 max(9px, min(5.2cqh, 4.6cqw)) / 1 var(--font-royal);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8a6420;
  }

  .fm__tag::before,
  .fm__tag::after {
    content: '';
    flex: 0 1 12cqw;
    height: 1px;
    background: linear-gradient(90deg, transparent, #c9a24a);
  }

  .fm__tag::after {
    transform: scaleX(-1);
  }

  .fm__people {
    display: grid;
    align-content: space-evenly;
    justify-items: center;
    text-align: center;
  }

  /* a gold lotus over a sibling's words, which are few */
  .fm__orn {
    display: grid;
    place-items: center;
    color: #c9a24a;
  }

  .fm__orn svg {
    width: min(15cqh, 17cqw);
    height: min(15cqh, 17cqw);
  }

  .fm__person {
    display: grid;
    justify-items: center;
    gap: 0.8cqh;
    min-width: 0;
  }

  .fm__person + .fm__person::before {
    content: '';
    width: 36cqw;
    height: 1px;
    margin-bottom: 1.6cqh;
    background: linear-gradient(90deg, transparent, #c9a24a, transparent);
  }

  .fm__rel {
    font: 700 max(9px, min(4.4cqh, 4.2cqw)) / 1.2 var(--font-royal);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a6420;
  }

  .fm__name {
    max-width: 100%;
    font: 400 max(17px, min(9.2cqh, 9.6cqw)) / 1.05 var(--font-script);
    color: #6a0f1f;
    -webkit-text-stroke: 0.3px currentColor;
    overflow-wrap: anywhere;
  }

  .fm__tbp {
    font: 500 max(11px, min(5cqh, 5.2cqw)) / 1.2 var(--font-body);
    color: #85735f;
    -webkit-text-stroke: 0;
  }

  .fm__work {
    font: 700 max(11px, min(5.4cqh, 5.6cqw)) / 1.2 var(--font-display);
    color: #4a3126;
  }

  /* ---------------------------------------------------------------- the dots, one for each face */
  .fm__dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    min-height: 22px;
  }

  .fm__dot {
    width: 28px;
    height: 22px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .fm__dot::before {
    content: '';
    display: block;
    width: 9px;
    height: 9px;
    margin: auto;
    border-radius: 50%;
    background: rgba(106, 15, 31, 0.28);
    box-shadow: 0 0 0 1.5px rgba(255, 249, 238, 0.9);
    transition:
      background-color 0.3s,
      transform 0.3s;
  }

  .fm__dot.is-active::before {
    background: #8a1426;
    transform: scale(1.3);
  }

  /* Without scripts the blocks cannot turn: the parents show alone */
  html:not(.js) .fm__face:not(:first-child),
  html:not(.js) .fm__dots {
    display: none;
  }
</style>
