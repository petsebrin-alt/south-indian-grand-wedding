---
/**
 * Pages 8–9 — Wedding Events (PRD §6.9), from the client's two-page picture (src/assets/events/,
 * npm run events:assets): the temple background with the "Wedding Events" signboard, and below it
 * each celebration's medallion with its flowers and still-life, connected by a gold rod. Each
 * medallion shows the event's current details in live text (the picture's printed dates differ).
 * Part 1: Mehndi, Haldi · Part 2: Sangeet, the Wedding, the Reception, so each medallion keeps the
 * still-life that belongs to it. Tapping a medallion opens the event's details (venue, calendar).
 * Motion: src/motion/pages/events.ts (the rod draws to each medallion, which then appears).
 */
import PageShell from '../PageShell.astro';
import ScenePhoto from '../ScenePhoto.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import { formatDateLong, formatTime } from '../../lib/format';
import { venueById } from '../../lib/venue';
import medallions from '../../assets/events/medallions.json';
import page1 from '../../assets/events/page-1.webp';
import page1Avif from '../../assets/events/page-1.avif';
import page2 from '../../assets/events/page-2.webp';
import page2Avif from '../../assets/events/page-2.avif';

interface Props {
  page: BookPage;
  index: number;
  part: 1 | 2;
}

const { page, index, part } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/events/medallion-*.webp', { eager: true });
const medallionImg = (id: string) => images[`../../assets/events/medallion-${id}.webp`].default;

// Where each medallion's disc sits on the page, in the picture's own pixels (768 × 1024 per page),
// chosen so the whole medallion stays on a narrow phone screen and the medallions zigzag
const BOX = { w: 768, h: 1024 };
const SCALE = 0.96;
const layout: Record<1 | 2, { id: string; cx: number; cy: number }[]> = {
  1: [
    { id: 'mehndi', cx: 462, cy: 420 },
    { id: 'haldi', cx: 292, cy: 760 },
  ],
  2: [
    { id: 'sangeet', cx: 350, cy: 345 },
    { id: 'wedding', cx: 492, cy: 596 },
    { id: 'reception', cx: 330, cy: 838 },
  ],
};
const sign = part === 1 ? { x: 395, y: 210 } : { x: 397, y: 212 };
const bg = part === 1 ? { webp: page1, avif: page1Avif } : { webp: page2, avif: page2Avif };

type Meta = { width: number; height: number; disc: number[] };
const items = layout[part].map((slot) => {
  const event = wedding.events.find((e) => e.id === slot.id)!;
  const m = (medallions as Record<string, Meta>)[slot.id];
  const w = m.width * SCALE, h = m.height * SCALE;
  const dx = (m.disc[0] / 100) * w, dy = (m.disc[1] / 100) * h;
  const r = (m.disc[2] / 100) * w; // the cream disc
  const ring = r * 1.14; // the gold ring around it
  const venue = venueById(event.venueId);
  const [weekday, date] = formatDateLong(event.startISO).split(', ');
  return {
    event,
    img: medallionImg(slot.id),
    style: `left:${((slot.cx - dx) / BOX.w) * 100}%;top:${((slot.cy - dy) / BOX.h) * 100}%;width:${(w / BOX.w) * 100}%`,
    disc: `left:${((dx - r) / w) * 100}%;top:${((dy - r) / h) * 100}%;width:${((2 * r) / w) * 100}%`,
    top: { x: slot.cx, y: slot.cy - ring },
    bottom: { x: slot.cx, y: slot.cy + ring },
    weekday,
    date,
    venue: venue.name ?? (venue.privacy === 'onRequest' ? venue.label : 'To be provided'),
  };
});

// The gold rod: from the signboard to the top of the first medallion, then from each medallion's
// foot to the next one's top, in gentle S-curves
const curve = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const k = (b.y - a.y) * 0.55;
  return `M${a.x} ${a.y} C${a.x} ${a.y + k} ${b.x} ${b.y - k} ${b.x} ${b.y}`;
};
const rods = items.map((it, i) => curve(i === 0 ? sign : items[i - 1].bottom, it.top));
const drops = items.map((it, i) => {
  const a = i === 0 ? sign : items[i - 1].bottom;
  return { x: (a.x + it.top.x) / 2, y: (a.y + it.top.y) / 2 };
});
---

<PageShell page={page} index={index} watermark={false} class:list={['ev', `ev--part${part}`]}>
  <Fragment slot="architecture">
    <div class="layer layer--architecture ev__box" aria-hidden="true">
      <ScenePhoto class="ev__bg" avif={bg.avif} webp={bg.webp} defer />
    </div>
  </Fragment>

  <div class="ev__stage">
   <h2 class="sr-only" tabindex="-1" data-page-heading>Wedding Events{part === 2 ? ': Sangeet, the Wedding and the Reception' : ': Mehndi and Haldi'}</h2>
   <div class="ev__box">
    <svg class="ev__rods" viewBox={`0 0 ${BOX.w} ${BOX.h}`} aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id={`ev-gold-${part}`} x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#8a5a16" />
          <stop offset="0.35" stop-color="#f7dc8e" />
          <stop offset="0.6" stop-color="#d4a443" />
          <stop offset="1" stop-color="#7a4c10" />
        </linearGradient>
      </defs>
      {
        rods.map((d) => (
          <g class="ev__rod">
            <path class="ev__rod-body" d={d} stroke={`url(#ev-gold-${part})`} />
            <path class="ev__rod-shine" d={d} />
          </g>
        ))
      }
      {
        drops.map((p) => (
          <g class="ev__drop" transform={`translate(${p.x} ${p.y})`}>
            <circle r="6" fill="#e7c06a" stroke="#8a5a16" stroke-width="1.2" />
            <path d="M0 6 C-6 14 -6 22 0 27 C6 22 6 14 0 6Z" fill="#b3122b" stroke="#6d0614" stroke-width="1" />
            <ellipse cx="-1.6" cy="16" rx="1.4" ry="3" fill="#fff" opacity=".5" />
          </g>
        ))
      }
    </svg>

    <ol class="ev__list">
      {
        items.map((it) => (
          <li class="ev__item" data-event={it.event.id} style={it.style}>
            <img class="ev__medallion" src={it.img.src} width={it.img.width} height={it.img.height} alt="" decoding="async" loading="lazy" />
            <div class="ev__disc" style={it.disc}>
              <h3 class="ev__name">{it.event.name.replace('Hindu Wedding Ceremony', 'Wedding').replace('Grand Wedding Reception', 'Reception').replace('Sangeet Night', 'Sangeet')}</h3>
              <p class="ev__date">
                <span class="ev__weekday">{it.weekday}</span>
                <span>{it.date}</span>
              </p>
              <p class="ev__time">
                {formatTime(it.event.startISO)} IST
                {it.event.timeStatus === 'proposed' && <span class="ev__tag">Proposed</span>}
                {it.event.id === 'wedding' && <span class="ev__tag ev__tag--muhurtham">Muhurtham</span>}
              </p>
              <span class="ev__rule" aria-hidden="true" />
              <p class="ev__venue">
                <span class="ev__venue-label">Venue</span>
                <span>{it.venue}</span>
              </p>
              <button class="ev__open" type="button" data-open-dialog={`event-${it.event.id}`} aria-haspopup="dialog" aria-label={`Details of ${it.event.name}: venue, map and calendar`} />
            </div>
          </li>
        ))
      }
    </ol>
   </div>
  </div>
</PageShell>

<style is:global>
  .ev .page__frame {
    display: none;
  }

  .ev .page__content {
    inset: 0;
    display: block;
  }

  /* The picture covers the page at its own proportions (narrow screens crop its sides); the
     medallions and rods are laid out in the same box, so they stay in place on the picture */
  .ev__box {
    position: absolute;
    left: 50%;
    top: 50%;
    height: max(100cqh, calc(100cqw * 1024 / 768));
    aspect-ratio: 768 / 1024;
    translate: -50% -50%;
  }

  .ev__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* The page-sized window the picture-sized box is clipped to */
  .ev__stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .ev__rods {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .ev__rod path {
    fill: none;
    stroke-linecap: round;
  }

  .ev__rod-body {
    stroke-width: 8;
    filter: drop-shadow(0 2px 2px rgba(60, 30, 5, 0.45));
  }

  .ev__rod-shine {
    stroke: rgba(255, 246, 214, 0.85);
    stroke-width: 1.8;
    transform: translate(-1px, 0);
  }

  .ev__list {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ev__item {
    position: absolute;
  }

  .ev__medallion {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 6px 10px rgba(60, 30, 5, 0.35));
  }

  /* The event's details in the cream disc */
  .ev__disc {
    position: absolute;
    aspect-ratio: 1;
    container-type: inline-size;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 1.2cqw;
    padding: 4.5cqw;
    text-align: center;
    color: #4a2418;
  }

  .ev__name {
    margin-bottom: 1.5cqw;
    font: 400 20.5cqw / 1 var(--font-script);
    color: #8a1426;
    -webkit-text-stroke: 0.25px currentColor;
  }

  .ev__date {
    display: grid;
    font: 600 9.8cqw / 1.15 var(--font-display);
  }

  .ev__weekday {
    font-weight: 500;
  }

  .ev__time {
    display: grid;
    justify-items: center;
    font: 700 9.8cqw / 1.15 var(--font-display);
  }

  .ev__tag {
    margin-top: 0.8cqw;
    padding: 0.4cqw 3cqw;
    border: 1px solid rgba(168, 120, 42, 0.6);
    border-radius: 999px;
    font: 700 6cqw / 1.2 var(--font-royal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #85540f;
  }

  .ev__tag--muhurtham {
    border-color: rgba(138, 20, 38, 0.55);
    color: #8a1426;
  }

  .ev__rule {
    width: 46%;
    height: 1px;
    margin-block: 1cqw;
    background: linear-gradient(90deg, transparent, #b8863a 20%, #b8863a 80%, transparent);
  }

  .ev__venue {
    display: grid;
    font: 500 8cqw / 1.15 var(--font-display);
  }

  .ev__venue-label {
    font-weight: 700;
    color: #6a0f1f;
  }

  /* The whole disc opens the event's details */
  .ev__open {
    position: absolute;
    inset: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .ev__open:focus-visible {
    outline: 2px solid #8a1426;
    outline-offset: 2px;
    box-shadow: none;
  }
</style>
