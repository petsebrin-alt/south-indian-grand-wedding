---
/**
 * Pages 8–9 — Wedding Events (PRD §6.9), the client's two-page picture exactly as it is
 * (src/assets/events/, npm run events:assets): the temple, the "Wedding Events" signboard, the
 * garlands, pillars and lamps, and each celebration's medallion with its flowers and still-life,
 * joined by their gold rods. Only the wording printed in each cream disc is replaced, by the
 * event's current details in live text (the picture's printed dates differ).
 * Part 1: Engagement, Haldi, Mehndi · Part 2: Sangeet, the Wedding, the Reception (as in the picture).
 * The picture has an Engagement medallion but the invitation has no Engagement event yet, so it shows
 * its name and "Details to be provided". Tapping a medallion opens its event's details (venue, calendar).
 * Motion: src/motion/pages/events.ts (a bright gold ring draws round each medallion in turn, and its
 * details appear).
 */
import PageShell from '../PageShell.astro';
import ScenePhoto from '../ScenePhoto.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import { formatDateLong, formatTime } from '../../lib/format';
import { venueById } from '../../lib/venue';
import discs from '../../assets/events/discs.json';
import page1 from '../../assets/events/page-1.webp';
import page1Avif from '../../assets/events/page-1.avif';
import page2 from '../../assets/events/page-2.webp';
import page2Avif from '../../assets/events/page-2.avif';

interface Props {
  page: BookPage;
  index: number;
  part: 1 | 2;
}

const { page, index, part } = Astro.props;

// The picture is 768 × 1024 per page; the medallions are placed in the same box, so they stay on it
const BOX = { w: 768, h: 1024 };
const order: Record<1 | 2, string[]> = { 1: ['engagement', 'haldi', 'mehndi'], 2: ['sangeet', 'wedding', 'reception'] };
const shortName = (name: string) => name.replace('Hindu Wedding Ceremony', 'Wedding').replace('Grand Wedding Reception', 'Reception').replace('Sangeet Night', 'Sangeet');
const bg = part === 1 ? { webp: page1, avif: page1Avif } : { webp: page2, avif: page2Avif };

const items = order[part].map((id) => {
  const d = (discs as Record<string, { cx: number; cy: number; r: number; ring: number }>)[id];
  const event = wedding.events.find((e) => e.id === id) ?? null;
  const venue = event ? venueById(event.venueId) : null;
  const [weekday, date] = event ? formatDateLong(event.startISO).split(', ') : ['', ''];
  return {
    id,
    event,
    name: event ? shortName(event.name) : 'Engagement',
    style: `left:${((d.cx - d.r) / BOX.w) * 100}%;top:${((d.cy - d.r) / BOX.h) * 100}%;width:${((2 * d.r) / BOX.w) * 100}%`,
    ringR: (d.ring / d.r) * 50,
    weekday,
    date,
    venue: venue ? (venue.name ?? (venue.privacy === 'onRequest' ? venue.label : 'To be provided')) : '',
  };
});
---

<PageShell page={page} index={index} watermark={false} class:list={['ev', `ev--part${part}`]}>
  <Fragment slot="architecture">
    <div class="layer layer--architecture ev__floor" aria-hidden="true"></div>
    <div class="layer layer--architecture ev__box" aria-hidden="true">
      <ScenePhoto class="ev__bg" avif={bg.avif} webp={bg.webp} defer />
      <!-- The polished floor carries on below the picture: its foot, turned over and fading -->
      <div class="ev__reflect"><ScenePhoto class="ev__reflect-img" avif={bg.avif} webp={bg.webp} defer /></div>
    </div>
  </Fragment>

  <div class="ev__stage">
   <h2 class="sr-only" tabindex="-1" data-page-heading>Wedding Events{part === 2 ? ': Sangeet, the Wedding and the Reception' : ': Engagement, Haldi and Mehndi'}</h2>
   <div class="ev__box">
    <ol class="ev__list">
      {
        items.map((it) => (
          <li class="ev__item" data-event={it.id} style={it.style}>
            <svg class="ev__ring" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
              <circle class="ev__ring-glow" cx="50" cy="50" r={it.ringR} transform="rotate(-90 50 50)" />
              <circle class="ev__ring-line" cx="50" cy="50" r={it.ringR} transform="rotate(-90 50 50)" />
            </svg>
            <div class="ev__disc">
              <h3 class="ev__name">{it.name}</h3>
              {it.event ? (
                <>
                  <p class="ev__date">
                    <span class="ev__weekday">{it.weekday}</span>
                    <span>{it.date}</span>
                  </p>
                  <p class="ev__time">
                    {formatTime(it.event.startISO)} IST
                    {it.event.timeStatus === 'proposed' && <span class="ev__tag">Proposed</span>}
                    {it.event.id === 'wedding' && <span class="ev__tag ev__tag--muhurtham">Muhurtham</span>}
                  </p>
                  <span class="ev__rule" aria-hidden="true" />
                  <p class="ev__venue">
                    <span class="ev__venue-label">Venue</span>
                    <span>{it.venue}</span>
                  </p>
                  <button class="ev__open" type="button" data-open-dialog={`event-${it.event.id}`} aria-haspopup="dialog" aria-label={`Details of ${it.event.name}: venue, map and calendar`} />
                </>
              ) : (
                <>
                  <span class="ev__rule" aria-hidden="true" />
                  <p class="ev__venue">
                    <span>Details to be provided</span>
                  </p>
                </>
              )}
            </div>
          </li>
        ))
      }
    </ol>
   </div>
  </div>
</PageShell>

<style is:global>
  .ev .page__frame {
    display: none;
  }

  .ev .page__content {
    inset: 0;
    display: block;
  }

  /* The picture is shown a fifth smaller than filling the page, hung from the top, so more of each
     medallion and its flowers is in view (narrow screens still crop its sides, a little more from the
     left so the medallions stay centred); its foot is carried on below as a faint reflection on the
     polished floor, fading into the floor colour. The medallions are laid out in the same box, so
     they stay in place on the picture */
  .ev__box {
    position: absolute;
    left: 50%;
    top: 0;
    height: max(80cqh, calc(100cqw * 1024 / 768 * 1.04));
    aspect-ratio: 768 / 1024;
    translate: calc(-50% - 1.8%) 0;
  }

  .ev__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ev__reflect {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 18%;
    overflow: hidden;
    opacity: 0.75;
    mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.5) 38%, transparent 92%);
  }

  .ev__reflect-img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: calc(100% / 0.18);
    transform: scaleY(-1);
  }

  /* The page-sized window the picture-sized box is clipped to */
  .ev__stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* The floor colour the reflection fades into */
  .ev__floor {
    inset: 0;
    background: linear-gradient(180deg, #cea379 0%, #cea379 74%, #e6cba6 100%);
  }

  .ev__list {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each item is the medallion's cream disc */
  .ev__item {
    position: absolute;
    aspect-ratio: 1;
  }

  /* A bright gold ring that draws round the picture's own ring as the details appear */
  .ev__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .ev__ring circle {
    fill: none;
    stroke-linecap: round;
    opacity: 0;
  }

  .ev__ring-glow {
    stroke: rgba(255, 214, 120, 0.55);
    stroke-width: 6;
  }

  .ev__ring-line {
    stroke: #fff6d2;
    stroke-width: 1.6;
  }

  /* The event's details in the cream disc */
  .ev__disc {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 1.2cqw;
    padding: 4.5cqw;
    text-align: center;
    color: #4a2418;
  }

  .ev__name {
    margin-bottom: 1.5cqw;
    font: 400 20.5cqw / 1 var(--font-script);
    color: #8a1426;
    -webkit-text-stroke: 0.25px currentColor;
  }

  .ev__date {
    display: grid;
    font: 600 9.8cqw / 1.15 var(--font-display);
  }

  .ev__weekday {
    font-weight: 500;
  }

  .ev__time {
    display: grid;
    justify-items: center;
    font: 700 9.8cqw / 1.15 var(--font-display);
  }

  .ev__tag {
    margin-top: 0.8cqw;
    padding: 0.4cqw 3cqw;
    border: 1px solid rgba(168, 120, 42, 0.6);
    border-radius: 999px;
    font: 700 6cqw / 1.2 var(--font-royal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #85540f;
  }

  .ev__tag--muhurtham {
    border-color: rgba(138, 20, 38, 0.55);
    color: #8a1426;
  }

  .ev__rule {
    width: 46%;
    height: 1px;
    margin-block: 1cqw;
    background: linear-gradient(90deg, transparent, #b8863a 20%, #b8863a 80%, transparent);
  }

  .ev__venue {
    display: grid;
    font: 500 8cqw / 1.15 var(--font-display);
  }

  .ev__venue-label {
    font-weight: 700;
    color: #6a0f1f;
  }

  /* The whole disc opens the event's details */
  .ev__open {
    position: absolute;
    inset: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .ev__open:focus-visible {
    outline: 2px solid #8a1426;
    outline-offset: 2px;
    box-shadow: none;
  }
</style>
