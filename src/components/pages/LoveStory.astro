---
/**
 * Page 5 — Our Love Story (PRD §6.8), on the same cream temple background as the desktop screen (the
 * client's picture: golden pillars and its hanging garlands and bells swaying, petals on marble below; src/components/StageBackdrop.astro). The couple's photographs ride a card carousel
 * inside the big ring of the client's red-and-gold peacock frame (src/assets/story/, npm run
 * story:assets), each in a simple gold frame; on the frame's board below, each milestone's title and
 * a line of its story. Ring behaviour: src/motion/ring.ts; sway: src/motion/sway.ts.
 */
import PageShell from '../PageShell.astro';
import ScenePhoto from '../ScenePhoto.astro';
import Icon from '../Icon.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import frame from '../../assets/story/frame.webp';
import opening from '../../assets/story/opening.webp';
import meta from '../../assets/story/frame.json';
import StageBackdrop from '../StageBackdrop.astro';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
const story = wedding.loveStory;
// Until the family writes their story (loveStory[].text in src/data/wedding.ts), the board carries a
// short line that claims no place or date
const lines = [
  'A glance, a smile, and our story began.',
  'Easy laughter, long talks, and a friendship that grew.',
  'Between the talks and the silences, our hearts found each other.',
  'A promise softly asked and happily answered.',
  'Hand in hand, today and every sunset to come.',
];
---

<PageShell page={page} index={index} watermark={false} class="ls">
  <Fragment slot="architecture">
    <!-- a little faded (90%), so the photographs, the frame and the board stand out clearly -->
    <StageBackdrop class="ls__scene" opacity={0.9} />
  </Fragment>

  <div class="ls__main">
    <h2 class="ls__title" tabindex="-1" data-page-heading>Our Love Story</h2>

    <div class="ls__frame" style={`--frame-ratio:${meta.width} / ${meta.height}`}>
      <div
        class="ls__ring"
        data-ring
        data-gesture="x"
        tabindex="0"
        role="group"
        aria-roledescription="carousel"
        aria-label="Our love story photographs. Use the arrow keys to move between photos."
        data-vars={`--opening:url("${opening.src}")`}
      >
        <div class="ls__stage" style={`left:${meta.opening.x + meta.opening.w / 2}%;top:${meta.opening.y + meta.opening.h / 2}%;width:${meta.opening.w}%`}>
          {
            story.map((m, i) => (
              <figure class="ls__card" data-card aria-roledescription="slide" aria-label={`${i + 1} of ${story.length}: ${m.title}`}>
                {m.photo && (
                  <>
                    <img data-src={m.photo.src} alt={m.photo.alt} draggable="false" decoding="async" />
                    <noscript><img src={m.photo.src} alt={m.photo.alt} decoding="async" /></noscript>
                  </>
                )}
              </figure>
            ))
          }
        </div>
      </div>
      <ScenePhoto class="ls__art" webp={frame} defer />
      <div class="ls__board" style={`left:${meta.board.x}%;top:${meta.board.y}%;width:${meta.board.w}%;height:${meta.board.h}%`}>
        {
          story.map((m, i) => (
            <div class:list={['ls__entry', i === 0 && 'is-active']} data-entry>
              <p class="ls__milestone">{m.title}</p>
              <p class="ls__story">{m.text ?? lines[i]}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="ls__controls">
      <button class="ls__arrow" type="button" data-ring-prev aria-label="Previous photo"><Icon name="chevron-left" /></button>
      <div class="ls__dots">
        {story.map((m, i) => <button class:list={['ls__dot', i === 0 && 'is-active']} type="button" data-ring-dot={i} aria-label={`Show photo ${i + 1}: ${m.title}`} />)}
      </div>
      <button class="ls__arrow" type="button" data-ring-next aria-label="Next photo"><Icon name="chevron-right" /></button>
    </div>
    <p class="sr-only" aria-live="polite" data-ring-live></p>
  </div>
</PageShell>

<style is:global>
  .ls .page__frame {
    display: none;
  }

  .ls .page__content {
    inset: 0;
    display: block;
  }

  .ls__main {
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: calc(var(--safe-top) + 2.6cqh);
  }

  .ls__title {
    font: 400 clamp(30px, 9.8cqw, 42px) / 1.05 var(--font-script);
    color: #6a0f1f;
    -webkit-text-stroke: 0.3px currentColor;
    text-shadow: 0 0 3px rgba(255, 249, 238, 1), 0 0 8px rgba(255, 249, 238, 1), 0 0 18px rgba(255, 249, 238, 0.95), 0 0 30px rgba(255, 249, 238, 0.8);
  }

  /* The peacock frame, wider than the page (only the outer tail feathers run off its edges) so the ring and
     the photographs in it are large, set right under the title */
  .ls__frame {
    position: relative;
    flex: none;
    width: 138cqw;
    aspect-ratio: var(--frame-ratio);
    margin-top: 2.2cqh;
    filter: drop-shadow(0 10px 14px rgba(70, 35, 10, 0.3));
  }

  /* The photographs show only inside the ring (the frame's opening, as a mask); the frame's art lies over them */
  .ls__ring {
    position: absolute;
    inset: 0;
    perspective: 900px;
    touch-action: pan-y pinch-zoom;
    cursor: grab;
    outline-offset: -6px;
    mask: var(--opening) center / 100% 100% no-repeat;
    -webkit-mask: var(--opening) center / 100% 100% no-repeat;
  }

  .ls__stage {
    position: absolute;
    aspect-ratio: 1;
    translate: -50% -50%;
  }

  .ls__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* A simple gold frame round each photograph */
  .ls__card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 57%;
    aspect-ratio: 2 / 3;
    margin: 0;
    padding: max(2px, 0.9cqw);
    background: linear-gradient(135deg, #f6e3a3 0%, #c9993f 38%, #f8ebb8 55%, #a8741f 100%);
    box-shadow: 0 8px 16px rgba(50, 25, 5, 0.38);
    transform: translate(-50%, -50%);
    will-change: transform;
  }

  .ls__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
    pointer-events: none;
    background: #e9d9b7;
  }

  /* The board: each milestone's title and a line or two of its story, on the frame's cream plaque (made
     taller in the frame art so the lettering can be large and plain to read; the side margins keep the
     lettering clear of the gold curls at the plaque's ends) */
  .ls__board {
    position: absolute;
    container-type: inline-size;
    display: grid;
    padding: 0.6cqw 7cqw;
    text-align: center;
  }

  .ls__entry {
    grid-area: 1 / 1;
    display: grid;
    align-content: center;
    justify-items: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--t-short),
      visibility 0s linear var(--t-short);
  }

  .ls__entry.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--t-short);
  }

  .ls__milestone {
    font: 400 11.4cqw / 1 var(--font-script);
    color: #8a1426;
    -webkit-text-stroke: 0.3px currentColor;
  }

  .ls__story {
    margin-top: 1.4cqw;
    font: italic 700 6.6cqw / 1.14 var(--font-display);
    color: #3e1a10;
    text-wrap: balance;
  }

  /* The dots and arrows sit at the very foot of the page, just above its page number */
  .ls__controls {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--safe-bottom) + 6.6cqh);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3cqw;
  }

  .ls__arrow {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1.5px solid #b8863a;
    border-radius: 50%;
    background: linear-gradient(180deg, #fffaf0, #f3dfb0);
    color: #6a0f1f;
    box-shadow: 0 2px 6px rgba(70, 35, 10, 0.25);
    -webkit-tap-highlight-color: transparent;
  }

  .ls__arrow svg {
    width: 20px;
    height: 20px;
  }

  .ls__dots {
    display: flex;
    gap: 2px;
  }

  .ls__dot {
    width: 26px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    position: relative;
    -webkit-tap-highlight-color: transparent;
  }

  .ls__dot::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 9px;
    translate: -50% -50%;
    border-radius: 50%;
    background: #f7ead0;
    box-shadow: inset 0 0 0 1.5px #b8863a;
    transition: background-color 0.3s, scale 0.3s;
  }

  .ls__dot.is-active::before {
    background: #8a1426;
    box-shadow: inset 0 0 0 1.5px #6a0f1f;
    scale: 1.25;
  }

  /* Without scripts the photographs are plain pictures in a row, and the sway has no canvases */
  html:not(.js) .ls__stage {
    display: none;
  }
</style>
