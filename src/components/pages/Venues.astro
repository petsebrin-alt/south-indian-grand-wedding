---
/** Page 11 — Venues and Directions (PRD §6.13, THEME §13 P14). Tabs: src/motion/pages/venues.ts */
import PageShell from '../PageShell.astro';
import Decor from '../Decor.astro';
import Icon from '../Icon.astro';
import Ph from '../Ph.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import { formatDateShort } from '../../lib/format';
import { directionsUrl, locationUnavailableMessage, venueFallback } from '../../lib/venue';
import { shortEventName } from '../../lib/swatches';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
const venues = wedding.venues.map((v) => {
  const events = wedding.events.filter((e) => e.venueId === v.id);
  return {
    ...v,
    events,
    tab: events.map((e) => shortEventName[e.id]).join(' & '),
    maps: directionsUrl(v),
    address: v.name && v.address ? `${v.name}, ${v.address}` : v.name,
  };
});
---

<PageShell page={page} index={index} watermark={false} class="vn" note="Placeholder art: D-01 jasmine and D-05 marigold garlands, D-09 pillars. Venue photographs P-12 to P-15 and the illustrated maps are created once venues are confirmed.">
  <Fragment slot="architecture">
    <Decor name="temple-pillar" asset="D-09" class="layer layer--architecture vn__pillar vn__pillar--l" />
    <Decor name="temple-pillar" asset="D-09" class="layer layer--architecture vn__pillar vn__pillar--r" />
  </Fragment>

  <div class="vn__card">
    <h2 class="page-title" tabindex="-1" data-page-heading>Venues</h2>
    <div class="vn__tabs" role="tablist" aria-label="Venues" data-gesture="x">
      {
        venues.map((v, i) => (
          <button
            class="vn__tab"
            type="button"
            role="tab"
            id={`vn-tab-${v.id}`}
            aria-controls={`vn-panel-${v.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={i}
          >
            {v.tab}
          </button>
        ))
      }
    </div>
    <div class="vn__panels">
      {
        venues.map((v, i) => (
          <section class:list={['vn__panel', i === 0 && 'is-active']} role="tabpanel" id={`vn-panel-${v.id}`} aria-labelledby={`vn-tab-${v.id}`} tabindex="0" data-panel={i}>
            <div class="vn__photo">
              {v.photo ? (
                <img src={v.photo.src} alt={v.photo.alt} />
              ) : (
                <div class="vn__photo-ph">
                  <span class="photo-ph__mono">R·D</span>
                  {v.privacy === 'onRequest' ? <span class="vn__photo-note">Family home</span> : <Ph label="Venue photograph" />}
                </div>
              )}
            </div>
            <div class="vn__map" aria-hidden="true">
              <Decor name="venue-map" asset="MAP" class="vn__map-art" />
              <svg class="vn__pin" viewBox="0 0 24 32">
                <path d="M12 31s10-11 10-19A10 10 0 0 0 2 12c0 8 10 19 10 19z" fill="#7a2635" stroke="#fffdf8" stroke-width="1.5" />
                <circle cx="12" cy="12" r="4" fill="#fffdf8" />
              </svg>
              <span class="vn__map-note preview-only">Illustrated map arrives once the venue is confirmed</span>
            </div>
            <h3 class="vn__name">{v.label}</h3>
            <p class="vn__address" data-selectable>
              <Ph value={v.address} label={`${v.label} name and address`} fallback={venueFallback(v)} />
            </p>
            <ul class="vn__events">
              {v.events.map((e) => (
                <li class="vn__chip">
                  {shortEventName[e.id]} · {formatDateShort(e.startISO).replace(/ \d{4}$/, '')}
                </li>
              ))}
            </ul>
            {v.maps ? (
              <a class="btn-primary vn__go" href={v.maps} target="_blank" rel="noopener">
                <Icon name="pin" /> Get Directions
              </a>
            ) : (
              <button class="btn-primary vn__go" type="button" aria-disabled="true" data-disabled-message={locationUnavailableMessage(v)}>
                <Icon name="pin" /> Get Directions
              </button>
            )}
          </section>
        ))
      }
    </div>
  </div>

  <Fragment slot="foreground">
    <Decor name="jasmine-swag" asset="D-01" class="layer layer--foreground vn__swag sway" style="--sway:0.6deg;--sway-dur:8s" />
    <Decor name="marigold-swag" asset="D-05" class="layer layer--foreground vn__marigold sway" style="--sway:0.5deg;--sway-dur:9s;--sway-delay:-2s" />
  </Fragment>
</PageShell>

<style is:global>
  .vn .page__content {
    inset-block-start: calc(var(--safe-top) + 10cqh);
  }

  .vn__pillar {
    bottom: calc(var(--safe-bottom) + 2cqh);
    height: min(76cqh, 140cqw);
    opacity: 0.85;
  }

  .vn__pillar--l {
    left: -4cqw;
  }

  .vn__pillar--r {
    right: -4cqw;
    transform: scaleX(-1);
  }

  .vn__swag {
    left: -2cqw;
    top: calc(var(--safe-top) - 0.5cqh);
    width: 104cqw;
  }

  .vn__marigold {
    left: 0;
    top: calc(var(--safe-top) + 1cqh);
    width: 100cqw;
  }

  /* Arched ivory venue card */
  .vn__card {
    position: relative;
    width: 112%;
    display: grid;
    justify-items: center;
    gap: 1.2cqh;
    padding: 4cqh 4cqw 2.4cqh;
    background-color: var(--jasmine);
    background-image: var(--paper-texture);
    background-blend-mode: multiply;
    border-radius: 50% 50% 8px 8px / 9% 9% 8px 8px;
    box-shadow:
      inset 0 0 0 1.5px var(--gold),
      inset 0 0 0 5px var(--jasmine),
      inset 0 0 0 6px var(--hairline),
      0 14px 30px var(--shadow);
  }

  .vn__tabs {
    display: flex;
    gap: 6px;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    touch-action: pan-x pinch-zoom;
  }

  .vn__tabs::-webkit-scrollbar {
    display: none;
  }

  .vn__tab {
    flex: none;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--gold);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.9);
    color: var(--gold-text);
    font: 600 12px/1.2 var(--font-body);
    white-space: nowrap;
  }

  .vn__tab[aria-selected='true'] {
    background: var(--maroon);
    border-color: var(--maroon);
    color: var(--ivory);
  }

  .vn__panels {
    display: grid;
    width: 100%;
  }

  .vn__panel {
    grid-area: 1 / 1;
    display: grid;
    justify-items: center;
    gap: 1cqh;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 350ms var(--ease-silk),
      visibility 0s linear 350ms;
  }

  .vn__panel.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 350ms var(--ease-silk);
  }

  .vn__photo {
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 4px;
    background: var(--foil-gold);
    box-shadow: 0 6px 14px var(--shadow);
  }

  .vn__photo img,
  .vn__photo-ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vn__photo-ph {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    background: radial-gradient(circle at 50% 40%, var(--jasmine), var(--sandal));
    color: var(--gold-text);
  }

  .vn__photo-note {
    font: 500 10px/1.3 var(--font-royal);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .vn__map {
    position: relative;
    width: 100%;
    aspect-ratio: 800 / 300;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .vn__map-art {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vn__pin {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 24px;
    translate: -50% -100%;
    filter: drop-shadow(0 3px 3px rgba(75, 48, 38, 0.3));
  }

  .vn__map-note {
    position: absolute;
    left: 8px;
    bottom: 6px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255, 253, 248, 0.85);
    border: 1px dashed var(--gold);
    font: 500 9px/1.3 var(--font-body);
    color: var(--gold-deep);
  }

  .vn__name {
    font: 600 clamp(13px, 3.8cqw, 16px) / 1.25 var(--font-royal);
    letter-spacing: 0.08em;
    color: var(--brown);
  }

  .vn__address {
    font-size: 13px;
    line-height: 1.45;
    color: var(--brown-soft);
    text-align: center;
  }

  .vn__events {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  .vn__chip {
    padding: 2px 10px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    font: 500 11px/1.6 var(--font-body);
    color: var(--brown-soft);
  }

  .vn__go {
    width: 100%;
  }

  .btn-primary[aria-disabled='true'] {
    background: var(--sandal);
    color: var(--brown-soft);
    box-shadow: none;
    outline: 1px dashed var(--gold);
    outline-offset: -1px;
  }

  .btn-primary[aria-disabled='true']::after {
    display: none;
  }

  @container app (max-height: 760px) {
    .vn__map {
      aspect-ratio: 800 / 220;
    }
  }

  @container app (max-height: 699px) {
    .vn__map {
      display: none;
    }

    .vn__card {
      gap: 0.8cqh;
      padding-top: 3cqh;
    }
  }
</style>
