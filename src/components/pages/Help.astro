---
/**
 * Page 12 — Need Help / Contact (PRD §6.17), after the client's reference video of a profile bar that opens a card: on the
 * Dress Code page's sky (jasmine garlands, temple bells and banana leaves, a little softened) three glass contact bars, one
 * for Rahul's father, one for Divya's father and one for the event coordinator, each holding only the name. Touch a bar (or,
 * on a laptop, rest the pointer on it) and an accent strip slides up out of it, then a card grows upward from it, its photograph
 * last, with the Call, WhatsApp and Email details (each an action, with the phone and WhatsApp logos). Touch it again, touch
 * elsewhere, or move the pointer away and it folds back down. Numbers and emails are for the families to give: until then a
 * row says "coming soon" and does nothing. Behaviour: src/motion/pages/help.ts
 */
import PageShell from '../PageShell.astro';
import ScenePhoto from '../ScenePhoto.astro';
import Icon from '../Icon.astro';
import type { BookPage } from '../../data/pages';
import { contactCards, EMAIL_SOON, NUMBER_SOON } from '../../lib/contacts';
import meta from '../../assets/dresscode/dresscode.json';
import scene from '../../assets/dresscode/scene.webp';
import sceneAvif from '../../assets/dresscode/scene.avif';
import ornament from '../../assets/dresscode/ornament.webp';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
const cards = contactCards();
---

<PageShell page={page} index={index} watermark={false} class="nh">
  <Fragment slot="architecture">
    <div class="layer layer--architecture nh__scene" aria-hidden="true">
      <ScenePhoto class="nh__bg" avif={sceneAvif} webp={scene} defer />
    </div>
  </Fragment>

  <div class="nh__head">
    <img class="nh__orn" data-src={ornament.src} width={meta.ornament.width} height={meta.ornament.height} alt="" decoding="async" />
    <h2 class="nh__title" tabindex="-1" data-page-heading>Need Help?</h2>
    <p class="nh__sub">We're happy to help with anything you need.</p>
  </div>

  <div class="nh__stack">
    <p class="nh__hint" data-hint>Touch a name to see how to reach them</p>
    <ul class="nh__list">
      {
        cards.map((c) => (
          <li class="nh__item" data-contact={c.id}>
            <section class="nh__card" id={`nh-card-${c.id}`} data-card aria-label={`${c.title}, ${c.subtitle}: contact details`} inert>
              <div class:list={['nh__top', !c.photo && 'nh__top--plain']}>
                {
                  c.photo ? (
                    <>
                      <img class="nh__photo" data-src={c.photo.src} alt={c.photo.alt} style={c.photo.focus ? `object-position:${c.photo.focus}` : undefined} decoding="async" draggable="false" />
                      <noscript>
                        <img class="nh__photo" src={c.photo.src} alt={c.photo.alt} decoding="async" />
                      </noscript>
                    </>
                  ) : (
                    <span class="nh__emblem" aria-hidden="true">
                      <Icon name={c.emblem} />
                    </span>
                  )
                }
                <p class="nh__who">
                  <span class="nh__name">{c.title}</span>
                  <span class="nh__rel">{c.subtitle}</span>
                </p>
                <span class="nh__tab" aria-hidden="true">
                  <span>{c.tab}</span>
                </span>
              </div>

              <ul class="nh__rows">
                <li>
                  {
                    c.telHref ? (
                      <a class="nh__row" href={c.telHref} aria-label={`Call ${c.name ?? c.relation}: ${c.phoneText}`}>
                        <span class="nh__ico"><Icon name="phone" /></span>
                        <span class="nh__lab">Call</span>
                        <span class="nh__val">{c.phoneText}</span>
                        <span class="nh__go" aria-hidden="true"><Icon name="chevron-right" /></span>
                      </a>
                    ) : (
                      <button class="nh__row is-waiting" type="button" aria-disabled="true" data-disabled-message={NUMBER_SOON} aria-label={`Call: ${NUMBER_SOON}`}>
                        <span class="nh__ico"><Icon name="phone" /></span>
                        <span class="nh__lab">Call</span>
                        <span class="nh__val">{NUMBER_SOON}</span>
                      </button>
                    )
                  }
                </li>
                <li>
                  {
                    c.whatsappHref ? (
                      <a class="nh__row" href={c.whatsappHref} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp ${c.name ?? c.relation}: ${c.whatsappText}`}>
                        <span class="nh__ico nh__ico--wa"><Icon name="whatsapp" /></span>
                        <span class="nh__lab">WhatsApp</span>
                        <span class="nh__val">{c.whatsappText}</span>
                        <span class="nh__go" aria-hidden="true"><Icon name="chevron-right" /></span>
                      </a>
                    ) : (
                      <button class="nh__row is-waiting" type="button" aria-disabled="true" data-disabled-message={NUMBER_SOON} aria-label={`WhatsApp: ${NUMBER_SOON}`}>
                        <span class="nh__ico nh__ico--wa"><Icon name="whatsapp" /></span>
                        <span class="nh__lab">WhatsApp</span>
                        <span class="nh__val">{NUMBER_SOON}</span>
                      </button>
                    )
                  }
                </li>
                <li>
                  {
                    c.mailHref ? (
                      <a class="nh__row" href={c.mailHref} aria-label={`Email ${c.name ?? c.relation}: ${c.email}`}>
                        <span class="nh__ico"><Icon name="mail" /></span>
                        <span class="nh__lab">Email</span>
                        <span class="nh__val">{c.email}</span>
                        <span class="nh__go" aria-hidden="true"><Icon name="chevron-right" /></span>
                      </a>
                    ) : (
                      <button class="nh__row is-waiting" type="button" aria-disabled="true" data-disabled-message={EMAIL_SOON} aria-label={`Email: ${EMAIL_SOON}`}>
                        <span class="nh__ico"><Icon name="mail" /></span>
                        <span class="nh__lab">Email</span>
                        <span class="nh__val">{EMAIL_SOON}</span>
                      </button>
                    )
                  }
                </li>
              </ul>

              <p class="nh__strip">
                <span>{c.side}</span>
                <Icon name="phone" />
              </p>
            </section>

            <button class="nh__bar" type="button" aria-expanded="false" aria-controls={`nh-card-${c.id}`} data-bar>
              <span class="nh__avatar" aria-hidden="true"><Icon name={c.emblem} /></span>
              <span class="nh__bar-text">
                <span class="nh__bar-name">{c.title}</span>
                <span class="nh__bar-rel">{c.subtitle}</span>
              </span>
              <span class="nh__cta" aria-hidden="true">
                <Icon name="phone" />
                <span>Contact</span>
                <Icon class="nh__caret" name="chevron-right" />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</PageShell>

<style is:global>
  .nh .page__frame {
    display: none;
  }

  .nh .page__content {
    inset: 0;
    display: block;
  }

  /* ---------------------------------------------------------------- the sky of the Dress Code page, a little softened */
  .nh__scene {
    inset: 0;
    overflow: hidden;
    background: #f3ead8;
  }

  .nh__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    opacity: 0.9;
  }

  /* ---------------------------------------------------------------- the heading */
  .nh__head {
    position: absolute;
    left: 50%;
    top: clamp(46px, 5.2cqh, 70px);
    width: min(78cqw, 340px);
    translate: -50% 0;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .nh__orn {
    display: block;
    width: min(40cqw, 170px);
    max-width: none;
    height: auto;
  }

  .nh__title {
    margin-top: 2px;
    font: 600 clamp(24px, 6.9cqw, 30px) / 1.1 var(--font-display);
    letter-spacing: 0.12em;
    text-indent: 0.12em;
    text-transform: uppercase;
    color: #4a3126;
    text-shadow: 0 0 10px rgba(255, 252, 244, 0.85);
  }

  .nh__sub {
    margin-top: 6px;
    font: 500 clamp(13px, 3.4cqw, 14.5px) / 1.3 var(--font-body);
    color: #4f3a2e;
    text-shadow: 0 0 8px rgba(255, 252, 244, 0.95);
  }

  /* ---------------------------------------------------------------- the three bars (the cards grow upward from them) */
  .nh__stack {
    position: absolute;
    left: 50%;
    bottom: calc(var(--safe-bottom) + 72px);
    width: min(88cqw, 380px);
    translate: -50% 0;
  }

  .nh__hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    margin-bottom: 14px;
    text-align: center;
    font: 600 clamp(12px, 3.3cqw, 13.5px) / 1.3 var(--font-body);
    letter-spacing: 0.02em;
    color: #4f3a2e;
    text-shadow: 0 0 8px rgba(255, 252, 244, 0.95);
    transition: opacity 0.3s ease;
  }

  .nh__list {
    display: grid;
    gap: 12px;
  }

  .nh__item {
    position: relative;
  }

  .nh__item.is-open {
    z-index: 5;
  }

  /* A bar: a pane of sandal glass holding a gold disc, the name and what they are, and a "Contact" cue */
  .nh__bar {
    position: relative;
    z-index: 2;
    width: 100%;
    min-height: 56px;
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 8px 14px 8px 9px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 999px;
    text-align: left;
    background: linear-gradient(160deg, rgba(255, 252, 242, 0.84), rgba(243, 233, 205, 0.74));
    -webkit-backdrop-filter: blur(8px) saturate(1.4);
    backdrop-filter: blur(8px) saturate(1.4);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 0 0 1px rgba(168, 128, 52, 0.4),
      0 8px 20px rgba(60, 38, 14, 0.26);
    color: #3b2418;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      box-shadow 0.35s ease,
      transform 0.35s ease;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nh__bar {
      background: rgba(250, 244, 226, 0.96);
    }
  }

  .nh__bar:hover,
  .nh__item.is-open .nh__bar {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 0 0 1px rgba(168, 128, 52, 0.7),
      0 10px 26px rgba(60, 38, 14, 0.34);
  }

  .nh__bar:active {
    transform: scale(0.985);
  }

  .nh__avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: #7a5516;
    background: radial-gradient(circle at 35% 30%, #fff8e0, #efdca6);
    box-shadow:
      0 0 0 1px #c9a24a,
      0 0 0 4px rgba(255, 250, 235, 0.7);
  }

  .nh__avatar svg {
    width: 22px;
    height: 22px;
  }

  .nh__bar-text {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .nh__bar-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 700 clamp(16px, 4.5cqw, 18px) / 1.15 var(--font-display);
    color: #5e0e1c;
  }

  .nh__bar-rel {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 700 10px / 1.2 var(--font-royal);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #6f4d10;
  }

  .nh__cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 7px 6px 10px;
    border-radius: 999px;
    background: linear-gradient(180deg, #a3142e, #6a0f1f);
    color: #fff3d0;
    font: 600 11.5px / 1 var(--font-body);
    letter-spacing: 0.04em;
    box-shadow: 0 2px 6px rgba(70, 10, 20, 0.3);
  }

  .nh__cta svg {
    width: 15px;
    height: 15px;
  }

  .nh__caret {
    transition: transform 0.4s ease;
    rotate: -90deg;
  }

  .nh__item.is-open .nh__caret {
    transform: rotate(180deg);
  }

  /* ---------------------------------------------------------------- the card: grows upward from the bar; what it holds is
     anchored at its foot, so the strip shows first, then the rows, then the photograph */
  .nh__card {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: calc(100% - 5px);
    z-index: 1;
    height: 0;
    max-height: var(--room, 380px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    border-radius: 16px 16px 4px 4px;
    background: #fffaf0;
    box-shadow:
      0 0 0 1px #c9a24a,
      0 16px 34px rgba(50, 30, 10, 0.34);
    visibility: hidden;
  }

  .nh__item.is-open .nh__card,
  .nh__item.is-opening .nh__card {
    visibility: visible;
  }

  /* A fixed height, so as the card grows the strip shows first, then the rows, and the photograph last */
  .nh__top {
    position: relative;
    flex: none;
    height: clamp(104px, 17cqh, 150px);
    overflow: hidden;
    background: linear-gradient(160deg, #efe3c3, #dfe8c6);
  }

  .nh__top--plain {
    background: linear-gradient(160deg, #8a1426, #4f0a18);
  }

  .nh__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nh__emblem {
    position: absolute;
    inset: 0 26px 30px 0;
    display: grid;
    place-items: center;
    color: #f0cf7f;
  }

  .nh__emblem svg {
    width: min(62px, 44%);
    height: min(62px, 44%);
    stroke-width: 1.1;
  }

  .nh__top:not(.nh__top--plain)::after {
    content: '';
    position: absolute;
    inset: 40% 0 0;
    background: linear-gradient(180deg, rgba(36, 18, 10, 0), rgba(36, 18, 10, 0.78));
    pointer-events: none;
  }

  .nh__who {
    position: absolute;
    left: 14px;
    right: 40px;
    bottom: 10px;
    z-index: 1;
    display: grid;
    gap: 2px;
    color: #fffaf0;
    text-shadow: 0 1px 6px rgba(20, 8, 4, 0.7);
  }

  .nh__name {
    font: 700 clamp(21px, 6cqw, 25px) / 1.1 var(--font-display);
  }

  .nh__rel {
    font: 700 10.5px / 1.2 var(--font-royal);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f4dc9c;
  }

  /* The accent tab on the card's right edge, with its word set upright to read from the bottom */
  .nh__tab {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: 26px;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, #a3142e, #6a0f1f);
    box-shadow: -2px 0 8px rgba(40, 8, 8, 0.3);
  }

  .nh__tab span {
    writing-mode: vertical-rl;
    rotate: 180deg;
    font: 700 10px / 1 var(--font-royal);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #f7dfa0;
  }

  .nh__rows {
    flex: none;
    display: grid;
    padding: 4px 12px 2px;
    background: #fffaf0;
  }

  .nh__rows li + li {
    border-top: 1px solid rgba(168, 128, 52, 0.28);
  }

  /* A contact line: the logo, what it is, the number or address, and (when it works) an arrow */
  .nh__row {
    width: 100%;
    min-height: 46px;
    display: grid;
    grid-template-columns: 32px auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 9px;
    padding: 5px 0;
    border: 0;
    background: none;
    text-align: left;
    text-decoration: none;
    color: #2f1c14;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .nh__row.is-waiting {
    cursor: default;
  }

  .nh__ico {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #fff3d0;
    background: linear-gradient(180deg, #a3142e, #6a0f1f);
    box-shadow: 0 0 0 1.5px #e0b95e;
  }

  .nh__ico--wa {
    background: linear-gradient(180deg, #2f7a45, #1d5232);
  }

  .nh__ico svg {
    width: 18px;
    height: 18px;
  }

  .nh__lab {
    font: 700 10.5px / 1.2 var(--font-royal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6f4d10;
  }

  .nh__val {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: right;
    font: 600 clamp(13px, 3.6cqw, 14.5px) / 1.2 var(--font-body);
    color: #2f1c14;
  }

  .nh__row.is-waiting .nh__val {
    font-weight: 500;
    color: #7a6a5c;
  }

  .nh__row.is-waiting .nh__ico {
    opacity: 0.5;
    filter: saturate(0.6);
  }

  .nh__go {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    color: #8a1426;
  }

  .nh__go svg {
    width: 16px;
    height: 16px;
    stroke-width: 2.3;
  }

  /* The strip at the card's foot, which slides out of the bar first */
  .nh__strip {
    flex: none;
    min-height: 28px;
    padding: 0 16px 0 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(180deg, #8a1426, #5e0e1c);
    color: #f7dfa0;
    font: 700 10.5px / 1 var(--font-royal);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .nh__strip svg {
    width: 14px;
    height: 14px;
  }

  /* Without scripts the cards simply stand open above their bars */
  html:not(.js) .nh__card {
    position: static;
    height: auto;
    visibility: visible;
    margin-bottom: -5px;
  }

  html:not(.js) .nh__stack {
    position: static;
    translate: none;
    margin: 120px auto 0;
  }

  .reduce-motion .nh__bar,
  .reduce-motion .nh__caret {
    transition: none;
  }
</style>
