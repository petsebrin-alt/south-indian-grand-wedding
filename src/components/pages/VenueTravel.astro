---
/**
 * Page 11 — Venue and Travel (PRD §6.13, §6.14), the Venues page and the Travel & Stay page as one, with only what a guest
 * needs: a card with Google's own map of the wedding venue (the Tirupati main temple), its name and Get Directions (a button
 * that glows and gleams); and under it Travel & Stay in three lines (airport, railway, stay), each with an arrow that opens
 * the route from there to the temple in Google Maps. The cards are panes of frosted glass over the client's photograph of the
 * temple courtyard from the opening (src/assets/opening/courtyard.webp: the sky, the gopuram, the steps and the path, framed
 * by pillars and jasmine-and-rose malas with a swag and bells across the top). The two halves of the picture come in from the
 * sides first, then the title, the map card and Travel & Stay arrive, and the malas and swag then stir in a light breeze.
 * Behaviour: src/motion/pages/venues.ts
 */
import PageShell from '../PageShell.astro';
import ScenePhoto from '../ScenePhoto.astro';
import Icon from '../Icon.astro';
import type { BookPage } from '../../data/pages';
import scene from '../../assets/opening/scene.json';
import courtyard from '../../assets/opening/courtyard.webp';
import courtyardAvif from '../../assets/opening/courtyard.avif';
import { directionsUrl, locationUnavailableMessage, mapEmbedUrl, routeUrl, venueById, venueFallback } from '../../lib/venue';
import { travelItem } from '../../lib/travel';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
// The malas and the swag are the pieces of the picture that stir (the boxes were measured on the opening's door photograph, which
// the courtyard picture lies behind, so they fit it too)
const wind = scene.wind.filter((w) => w.id.startsWith('garland') || w.id === 'swag');
const pct = (n: number) => `${+n.toFixed(3)}%`;
const box = ([x0, y0, x1, y1]: number[]) => `left:${pct(x0)};top:${pct(y0)};width:${pct(x1 - x0)};height:${pct(y1 - y0)}`;
/** An element showing one region of the photograph: the full image, offset so the region shows. */
const cropImg = ([x0, y0, x1, y1]: number[]) => `width:${pct((100 / (x1 - x0)) * 100)};left:${pct((-x0 / (x1 - x0)) * 100)};top:${pct((-y0 / (y1 - y0)) * 100)}`;

const venue = venueById('ceremony');
const maps = directionsUrl(venue);
const embed = mapEmbedUrl(venue);
const rows = [
  { key: 'airport', icon: 'plane' },
  { key: 'railway', icon: 'train' },
  { key: 'accommodation', icon: 'hotel' },
] as const;
const stayWaiting = 'Stay details will be shared soon';
---

<PageShell page={page} index={index} watermark={false} class="vt">
  <Fragment slot="architecture">
    <div class="layer layer--architecture vt__scene" aria-hidden="true">
      <div class="vt__plate">
        <div class="vt__half vt__half--l" data-half="l"><ScenePhoto class="vt__still" avif={courtyardAvif} webp={courtyard} defer /></div>
        <div class="vt__half vt__half--r" data-half="r"><ScenePhoto class="vt__still" avif={courtyardAvif} webp={courtyard} defer /></div>
        <!-- The garlands and swag: pieces of the photograph that stir in the breeze once the page has settled -->
        <div class="vt__winds" data-winds>
          {
            wind.map((w) => (
              <div
                class:list={['vt__wind', `vt__wind--${w.feather}`]}
                data-wind={w.amp}
                style={`${box(w.box)};transform-origin:${pct(((w.pivot[0] - w.box[0]) / (w.box[2] - w.box[0])) * 100)} ${pct(((w.pivot[1] - w.box[1]) / (w.box[3] - w.box[1])) * 100)}`}
              >
                <ScenePhoto avif={courtyardAvif} webp={courtyard} defer style={cropImg(w.box)} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Fragment>

  <div class="vt__door" data-door>
    <h2 class="vt__title" tabindex="-1" data-page-heading>Venue &amp; Travel</h2>

    <section class="vt__card vt__card--venue" data-card="venue" aria-label={venue.label}>
      <div class="vt__map">
        {
          embed ? (
            <>
              <!-- Google's map is put here by src/motion/pages/venues.ts as the page arrives (an iframe in the page from the start would load an empty page of its own with the cover) -->
              <span class="vt__map-slot" data-map-slot data-src={embed} data-title={`Map of ${venue.name ?? venue.label}`} />
              <span class="vt__map-wait" aria-hidden="true">
                <Icon name="pin" />
              </span>
              {maps && <a class="vt__map-link" href={maps} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true" />}
            </>
          ) : (
            <span class="vt__map-wait vt__map-wait--note">
              <Icon name="pin" />
              <span class="preview-only">The map arrives once the venue is confirmed</span>
            </span>
          )
        }
      </div>
      <p class="vt__label">{venue.label}</p>
      <p class="vt__name" data-selectable>{venue.name ?? venueFallback(venue)}</p>
      {venue.name && venue.address && <p class="vt__addr" data-selectable>{venue.address}</p>}
      {
        maps ? (
          <a class="btn-primary vt__go" href={maps} target="_blank" rel="noopener">
            <Icon name="pin" /> Get Directions
          </a>
        ) : (
          <button class="btn-primary vt__go" type="button" aria-disabled="true" data-disabled-message={locationUnavailableMessage(venue)}>
            <Icon name="pin" /> Get Directions
          </button>
        )
      }
    </section>

    <section class="vt__card vt__card--travel" data-card="travel" aria-labelledby="vt-travel">
      <h3 class="vt__sub" id="vt-travel">Travel &amp; Stay</h3>
      <ul class="vt__rows">
        {
          rows.map(({ key, icon }) => {
            const item = travelItem(key);
            const waiting = item.status === 'toBeConfirmed' || !item.summary;
            const href = waiting ? null : routeUrl(item.place, venue);
            const Tag: any = href ? 'a' : 'button';
            const attrs: Record<string, string> = href
              ? { href, target: '_blank', rel: 'noopener', 'aria-label': `${item.title}: ${item.summary}. Opens the route from here to the venue in Google Maps` }
              : { type: 'button', 'aria-disabled': 'true', 'data-disabled-message': waiting && key === 'accommodation' ? stayWaiting : 'The route will be available soon', 'aria-label': `${item.title}: ${waiting ? 'to be announced' : item.summary}` };
            return (
              <li>
                <Tag class:list={['vt__row', !href && 'is-waiting']} {...attrs}>
                  <span class="vt__icon" aria-hidden="true">
                    <Icon name={icon} />
                  </span>
                  <span class="vt__row-text">
                    <span class="vt__row-title">{item.title}</span>
                    <span class="vt__row-summary">{waiting ? 'To be announced' : item.summary}</span>
                  </span>
                  <span class="vt__arrow" aria-hidden="true">
                    <Icon name="chevron-right" />
                  </span>
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </section>
  </div>
</PageShell>

<style is:global>
  /* The courtyard picture (948 × 1660) is scaled to cover the page and a little more (128% of its width), so the red doors at its
     sides fall out of view and what is left is the pair of malas, the bells, the sky, the temple and the steps; the doorway between
     the malas (about 54% of the picture) is then about 70% of the page's width. The picture is centred and its foot cropped on a short page. */
  .vt {
    --fw: max(128cqw, 57.1cqh);
    --fh: calc(var(--fw) * 1.751);
  }

  .vt .page__frame {
    display: none;
  }

  .vt .page__content {
    inset: 0;
    display: block;
  }

  .vt__scene {
    inset: 0;
    overflow: hidden;
  }

  .vt__plate {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--fw);
    height: var(--fh);
    translate: -50% 0;
  }

  /* The picture in two halves, overlapping a hair at the middle, that come in from the sides */
  .vt__half {
    position: absolute;
    inset: 0;
    will-change: transform, opacity;
  }

  .vt__half--l {
    clip-path: inset(0 49.6% 0 0);
  }

  .vt__half--r {
    clip-path: inset(0 0 0 49.6%);
  }

  .vt__still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .vt__winds {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Pieces that stir: their edges fade into the still picture, so a moving piece reads as the flowers flexing */
  .vt__wind {
    position: absolute;
    overflow: hidden;
    will-change: transform;
    mask-image: linear-gradient(90deg, transparent 0, #000 16%, #000 84%, transparent 100%), linear-gradient(180deg, #000 0, #000 72%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 16%, #000 84%, transparent 100%), linear-gradient(180deg, #000 0, #000 72%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  .vt__wind img {
    position: absolute;
    height: auto;
  }

  /* ---------------------------------------------------------------- between the malas: the title and the two glass cards */
  .vt__door {
    position: absolute;
    left: calc(50% - var(--fw) / 2 + var(--fw) * 0.229);
    width: calc(var(--fw) * 0.542);
    top: calc(var(--fh) * 0.178);
    height: min(calc(var(--fh) * 0.7), calc(100cqh - var(--fh) * 0.178 - 62px));
    container-type: size;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  /* One pane of frosted glass in sandal and sage green: the picture behind still shows through it, but the tint is deep enough
     that the writing on it stays plainly readable. */
  .vt__title,
  .vt__card {
    border: 1px solid rgba(255, 255, 255, 0.72);
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.34) 0%, rgba(255, 255, 255, 0) 40%),
      linear-gradient(160deg, rgba(238, 243, 214, 0.86) 0%, rgba(222, 234, 197, 0.8) 52%, rgba(245, 235, 205, 0.86) 100%);
    -webkit-backdrop-filter: blur(7px) saturate(1.4);
    backdrop-filter: blur(7px) saturate(1.4);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 0 0 1px rgba(84, 120, 64, 0.42),
      0 10px 26px rgba(40, 50, 20, 0.3);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .vt__title,
    .vt__card {
      background: rgba(236, 241, 212, 0.96);
    }
  }

  .vt__title {
    flex: none;
    align-self: center;
    padding: 7px 18px 7px calc(18px + 0.16em);
    border-radius: 999px;
    text-align: center;
    font: 600 clamp(14px, 5.6cqw, 19px) / 1.15 var(--font-royal);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #5e0e1c;
  }

  .vt__card {
    position: relative;
    padding: 8px;
    border-radius: 16px;
  }

  .vt__card--venue {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    text-align: center;
  }

  .vt__card--travel {
    flex: none;
    padding: 9px 8px 6px;
  }

  /* The map: Google's own, kept still (a swipe over it turns the page; a tap opens Google Maps) */
  .vt__map {
    position: relative;
    flex: 1 1 0;
    min-height: 56px;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 0 0 1px rgba(84, 120, 64, 0.55);
    background: #e6ecc8;
  }

  /* The map in one colourway: sandal land and sage green, whatever Google draws (a muted map under a tint laid over it) */
  .vt__map::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(160deg, rgba(168, 200, 126, 0.46), rgba(238, 222, 176, 0.42));
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .vt__map-slot {
    position: absolute;
    inset: 0;
  }

  .vt__map-frame {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
    opacity: 0;
    filter: sepia(0.3) saturate(0.78);
    transition: opacity 0.5s ease;
  }

  .vt__map-frame.is-in {
    opacity: 1;
  }

  /* What is there while Google's map loads (or if it cannot): a soft map-coloured field with the pin */
  .vt__map-wait {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 5px;
    background:
      linear-gradient(90deg, rgba(84, 120, 64, 0.14) 1px, transparent 1px) 0 0 / 34px 34px,
      linear-gradient(0deg, rgba(84, 120, 64, 0.14) 1px, transparent 1px) 0 0 / 34px 34px,
      linear-gradient(160deg, #eef2d6, #e8dcb4);
    color: #3f5f2a;
    font: 600 11px / 1.3 var(--font-body);
    letter-spacing: 0.04em;
  }

  .vt__map-wait svg {
    width: 28px;
    height: 28px;
  }

  .vt__map-wait::after {
    content: 'Loading the map…';
  }

  .vt__map-wait--note::after {
    content: none;
  }

  .vt__map.is-offline .vt__map-wait::after {
    content: 'The map needs an internet connection';
  }

  .vt__map-link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .vt__label {
    flex: none;
    font: 700 clamp(8.5px, 3cqw, 10.5px) / 1.2 var(--font-royal);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #3f5f2a;
  }

  .vt__name {
    flex: none;
    font: 700 clamp(17px, 7.4cqw, 25px) / 1.1 var(--font-display);
    color: #5e0e1c;
  }

  .vt__addr {
    flex: none;
    margin-top: -2px;
    font: 600 clamp(10.5px, 3.8cqw, 12.5px) / 1.25 var(--font-body);
    color: #2b3a22;
  }

  /* Get Directions glows and gleams (a soft golden pulse round the button and a sheen sweeping across it), so a guest sees it first */
  .vt__go {
    position: relative;
    flex: none;
    width: 100%;
    min-height: 42px;
    margin-top: 2px;
    overflow: hidden;
    isolation: isolate;
    border: 1.5px solid #e6c068;
    white-space: nowrap;
    text-shadow: none;
    animation: vt-glow 1.9s ease-in-out infinite;
  }

  .vt__go::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 32%, rgba(255, 236, 170, 0.6) 50%, transparent 68%);
    transform: translateX(-130%);
    animation: vt-sheen 2.6s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes vt-glow {
    0%,
    100% {
      box-shadow:
        0 0 0 0 rgba(255, 205, 95, 0),
        0 0 0 0 rgba(255, 200, 90, 0),
        0 3px 9px rgba(80, 10, 25, 0.4);
    }

    50% {
      box-shadow:
        0 0 0 3px rgba(255, 214, 120, 0.55),
        0 0 20px 5px rgba(255, 200, 90, 0.85),
        0 3px 9px rgba(80, 10, 25, 0.4);
    }
  }

  @keyframes vt-sheen {
    0% {
      transform: translateX(-130%);
    }

    55%,
    100% {
      transform: translateX(130%);
    }
  }

  .reduce-motion .vt__go,
  .reduce-motion .vt__go::after {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .vt__go,
    .vt__go::after {
      animation: none;
    }
  }

  .vt__sub {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 3px;
    font: 700 clamp(9.5px, 3.3cqw, 11.5px) / 1 var(--font-royal);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #5e0e1c;
  }

  .vt__sub::before,
  .vt__sub::after {
    content: '';
    flex: 0 1 18%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #6f9a52);
  }

  .vt__sub::after {
    transform: scaleX(-1);
  }

  .vt__rows {
    display: grid;
  }

  /* A line of Travel & Stay is one button: the place, and an arrow that opens the route from there to the venue in Google Maps */
  .vt__row {
    width: 100%;
    min-height: 46px;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 34px;
    align-items: center;
    gap: 9px;
    padding: 5px 0;
    border: 0;
    border-top: 1px solid rgba(84, 120, 64, 0.4);
    border-radius: 0;
    background: none;
    color: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .vt__row.is-waiting {
    cursor: default;
  }

  .vt__icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: #3f5f2a;
    background: radial-gradient(circle at 35% 30%, #f8faea, #d3e2b2);
    box-shadow: 0 0 0 1px #7aa05a;
  }

  .vt__icon svg {
    width: 17px;
    height: 17px;
  }

  .vt__row-text {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .vt__row-title {
    font: 700 9.5px / 1.2 var(--font-royal);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #3f5f2a;
  }

  .vt__row-summary {
    font: 600 clamp(11px, 3.9cqw, 13px) / 1.22 var(--font-body);
    color: #1f2b18;
  }

  /* The arrow, like the page's own next arrow: a maroon disc with a gold rim */
  .vt__arrow {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1.5px solid #e0b95e;
    background: linear-gradient(180deg, #a3142e, #6a0f1f);
    color: #fff3d0;
    box-shadow: 0 2px 6px rgba(70, 10, 20, 0.35);
    transition: transform 0.18s ease;
  }

  .vt__arrow svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
  }

  .vt__row:not(.is-waiting):active .vt__arrow {
    transform: scale(0.9);
  }

  .vt__row.is-waiting .vt__arrow {
    opacity: 0.4;
    filter: saturate(0.6);
  }

  /* A short page: the address and the small print give way to the map */
  @container app (max-height: 700px) {
    .vt__addr,
    .vt__label {
      display: none;
    }
  }
</style>
