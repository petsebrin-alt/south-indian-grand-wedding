---
/**
 * Page 3 — Wedding Countdown (PRD §6.5), as the client asked: the client's temple-courtyard picture
 * (the one behind the Parents page, turned the other way), shown pale so the lettering and boards
 * stand out, the heading above, and below it four small palanquins stepping down the page, one for each of
 * days, hours, minutes and seconds: the client's elephant-and-peacock board hanging from their gold
 * rod like a doli on its carrying pole, the count inside it. The palanquins sway gently as if
 * carried, and the elephants raise and lower their trunks (each trunk in two jointed pieces;
 * src/assets/countdown/, npm run countdown:assets). Counting: src/motion/pages/countdown.ts
 */
import PageShell from '../PageShell.astro';
import ScenePhoto from '../ScenePhoto.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import { formatDateLong, formatTime } from '../../lib/format';
import fit from '../../assets/countdown/board.json';
import board from '../../assets/countdown/board.webp';
import boardAvif from '../../assets/countdown/board.avif';
import rod from '../../assets/countdown/rod.webp';
import temple from '../../assets/family/background.webp';
import templeAvif from '../../assets/family/background.avif';
import trunkLLower from '../../assets/countdown/trunk-l-lower.webp';
import trunkLUpper from '../../assets/countdown/trunk-l-upper.webp';
import trunkRLower from '../../assets/countdown/trunk-r-lower.webp';
import trunkRUpper from '../../assets/countdown/trunk-r-upper.webp';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
const { startISO } = wedding.ceremony;
const units = [
  { key: 'days', label: 'Days' },
  { key: 'hours', label: 'Hours' },
  { key: 'minutes', label: 'Minutes' },
  { key: 'seconds', label: 'Seconds' },
];

type Piece = { box: number[]; pivot: number[] };
const pct = (n: number) => `${+n.toFixed(3)}%`;
const at = ([x0, y0, x1, y1]: number[]) => `left:${pct(x0)};top:${pct(y0)};width:${pct(x1 - x0)};height:${pct(y1 - y0)}`;
// The curled upper piece sits inside the lower one, so it rides on the lower piece's swing
const within = (inner: number[], outer: number[]) => {
  const [ox0, oy0, ox1, oy1] = outer, w = ox1 - ox0, h = oy1 - oy0;
  return `left:${pct(((inner[0] - ox0) / w) * 100)};top:${pct(((inner[1] - oy0) / h) * 100)};width:${pct(((inner[2] - inner[0]) / w) * 100)};height:${pct(((inner[3] - inner[1]) / h) * 100)}`;
};
const trunks = [
  { side: 'l', lower: fit['trunk-l-lower'] as Piece, upper: fit['trunk-l-upper'] as Piece, lowerImg: trunkLLower, upperImg: trunkLUpper },
  { side: 'r', lower: fit['trunk-r-lower'] as Piece, upper: fit['trunk-r-upper'] as Piece, lowerImg: trunkRLower, upperImg: trunkRUpper },
];
---

<PageShell page={page} index={index} watermark={false} class="cd">
  <Fragment slot="architecture">
    <div class="layer layer--architecture cd__scene" aria-hidden="true">
      <div class="cd__backdrop" data-backdrop>
        <ScenePhoto class="cd__bg" avif={templeAvif} webp={temple} defer />
      </div>
    </div>
    <span class="layer layer--architecture cd__veil" aria-hidden="true"></span>
  </Fragment>

  <div class="cd__head">
    <h2 class="cd__title" tabindex="-1" data-page-heading>Counting down to the <span class="cd__title-script">Muhurtham</span></h2>
    <p class="sr-only" data-countdown-summary></p>
    <p class="cd__when">{formatDateLong(startISO)} · <span class="cd__time">{formatTime(startISO)} IST</span></p>
    <p class="cd__local" data-localtime hidden></p>
  </div>

  <!-- Four palanquins, stepping down the page: days, hours, minutes, seconds -->
  <div class="cd__palkis" data-countdown={startISO} role="timer" aria-label="Time remaining until the wedding Muhurtham" style={`--board-ratio:${fit.ratio}`}>
    {
      units.map((u, i) => (
        <div class={`cd__palki cd__palki--${i % 2 ? 'r' : 'l'}`} style={`--i:${i}`}>
          <div class="cd__carry">
            <img class="cd__rod" src={rod.src} width={rod.width} height={rod.height} alt="" decoding="async" loading="lazy" />
            <div class="cd__board">
              <ScenePhoto class="cd__frame" avif={boardAvif} webp={board} defer />
              {trunks.map((t) => (
                <div class={`cd__trunk cd__trunk--${t.side}`} style={`${at(t.lower.box)};transform-origin:${t.lower.pivot[0]}% ${t.lower.pivot[1]}%`} aria-hidden="true">
                  <img src={t.lowerImg.src} width={t.lowerImg.width} height={t.lowerImg.height} alt="" decoding="async" loading="lazy" />
                  <div class={`cd__tip cd__tip--${t.side}`} style={`${within(t.upper.box, t.lower.box)};transform-origin:${t.upper.pivot[0]}% ${t.upper.pivot[1]}%`}>
                    <img src={t.upperImg.src} width={t.upperImg.width} height={t.upperImg.height} alt="" decoding="async" loading="lazy" />
                  </div>
                </div>
              ))}
              <div class="cd__panel" style={at(fit.panel)}>
                <span class="cd__num" data-unit={u.key} aria-hidden="true">
                  --
                </span>
                <span class="cd__label">{u.label}</span>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <div class="cd__arrived" data-arrived hidden>
    <p>{wedding.copy.countdownArrived.text}</p>
  </div>
</PageShell>

<style is:global>
  .page--countdown .page__frame {
    display: none;
  }

  /* The temple, structured and sharp but shown at about a third of its strength over ivory */
  .cd__scene {
    inset: 0;
    overflow: hidden;
    background: #f8eedb;
  }

  .cd__backdrop,
  .cd__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cd__bg {
    object-fit: cover;
    object-position: 62% 50%;
    opacity: 0.36;
    transform: scaleX(-1);
  }

  /* A soft ivory veil of morning light behind the heading */
  .cd__veil {
    inset: 0;
    background: radial-gradient(ellipse 76% 15% at 50% 14%, rgba(255, 249, 238, 0.78), rgba(255, 249, 238, 0) 100%);
  }

  .page--countdown .page__content {
    inset: 0;
    display: block;
  }

  .cd__head {
    position: absolute;
    left: 5cqw;
    right: 5cqw;
    top: calc(var(--safe-top) + 6cqh);
    display: grid;
    gap: 0.6cqh;
    text-align: center;
    text-shadow: 0 0 2px rgba(255, 249, 238, 0.95), 0 0 10px rgba(255, 249, 238, 0.9);
  }

  .cd__title {
    font: 700 clamp(13px, 3.9cqw, 17px) / 1.3 var(--font-royal);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6a0f1f;
  }

  .cd__title-script {
    display: block;
    margin-top: 0.15em;
    font: 400 2.5em / 1 var(--font-script);
    letter-spacing: 0;
    text-transform: none;
    -webkit-text-stroke: 0.3px currentColor;
  }

  .cd__when {
    font: 700 clamp(13px, 3.9cqw, 16px) / 1.3 var(--font-display);
    color: #6a0f1f;
  }

  .cd__time {
    font: 700 0.82em / 1 var(--font-royal);
    letter-spacing: 0.14em;
    color: #1d5232;
    white-space: nowrap;
  }

  .cd__local {
    font: 500 12px / 1.3 var(--font-body);
    color: #4a2a1c;
  }

  /* The palanquins: two columns, each one a step lower than the last, so they read 1 → 4 down the
     page; each board is B wide, its pole 1.5 B long (so its finials stay on screen) */
  .cd__palkis {
    --b: min(38cqw, 21cqh);
    --step: calc(var(--b) * var(--board-ratio) * 0.68);
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--safe-top) + 24cqh);
    height: calc(var(--step) * 3 + var(--b) * var(--board-ratio));
  }

  .cd__palki {
    position: absolute;
    top: calc(var(--step) * var(--i));
    width: var(--b);
    aspect-ratio: 1 / var(--board-ratio);
    /* Earlier palanquins in front, so a later one's pole passes behind its neighbour */
    z-index: calc(10 - var(--i));
  }

  .cd__palki--l {
    left: calc(50% - var(--b) - 1cqw);
  }

  .cd__palki--r {
    left: calc(50% + 1cqw);
  }

  /* Carried: a slow sway and bob from the pole, each palanquin at its own moment */
  .cd__carry {
    position: absolute;
    inset: 0;
    transform-origin: 50% 12%;
    animation: cd-carry 3.4s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.85s);
  }

  @keyframes cd-carry {
    from {
      rotate: -1.4deg;
      translate: 0 0;
    }

    to {
      rotate: 1.4deg;
      translate: 0 -3px;
    }
  }

  /* The gold pole, level behind the top of the board, its finials showing either side */
  .cd__rod {
    position: absolute;
    left: -25%;
    top: 10%;
    width: 150%;
    height: auto;
    filter: drop-shadow(0 2px 2px rgba(50, 25, 5, 0.4));
  }

  .cd__board {
    position: absolute;
    inset: 0;
  }

  .cd__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    filter: drop-shadow(0 6px 8px rgba(50, 20, 5, 0.3));
  }

  /* The trunks: each lower piece swings on the trunk's base, and the curled upper piece swings at
     the middle of the S a moment later, so the trunk bends as it rises and falls */
  .cd__trunk,
  .cd__tip {
    position: absolute;
    pointer-events: none;
  }

  .cd__trunk img,
  .cd__tip img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cd__trunk--l {
    animation: cd-trunk-l 3.8s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -1.1s);
  }

  .cd__tip--l {
    animation: cd-tip-l 3.8s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -1.1s - 0.8s);
  }

  .cd__trunk--r {
    animation: cd-trunk-r 4.2s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.7s - 1.6s);
  }

  .cd__tip--r {
    animation: cd-tip-r 4.2s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.7s - 2.5s);
  }

  /* Raised (curled back) at one end, lowered (curled forward) at the other */
  @keyframes cd-trunk-l {
    from {
      rotate: -4deg;
    }

    to {
      rotate: 6deg;
    }
  }

  @keyframes cd-tip-l {
    from {
      rotate: -7deg;
    }

    to {
      rotate: 11deg;
    }
  }

  @keyframes cd-trunk-r {
    from {
      rotate: 4deg;
    }

    to {
      rotate: -6deg;
    }
  }

  @keyframes cd-tip-r {
    from {
      rotate: 7deg;
    }

    to {
      rotate: -11deg;
    }
  }

  .reduce-motion :is(.cd__carry, .cd__trunk, .cd__tip) {
    animation: none;
  }

  /* The count inside each palanquin, on the board's cream panel */
  .cd__panel {
    position: absolute;
    container-type: inline-size;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 4cqw;
    text-align: center;
  }

  .cd__num {
    display: inline-flex;
    justify-content: center;
    font: 700 max(22px, 38cqw) / 1 var(--font-display);
    font-variant-numeric: lining-nums tabular-nums;
    color: #6a0f1f;
  }

  .cd__slot {
    position: relative;
    display: inline-block;
    height: 1em;
    overflow: hidden;
  }

  .cd__digit {
    display: block;
  }

  .cd__digit + .cd__digit {
    position: absolute;
    inset: 0;
  }

  .cd__label {
    font: 700 max(7px, 9.2cqw) / 1 var(--font-royal);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a5a1c;
  }

  /* At the Muhurtham the palanquins give way to the message */
  .cd__arrived {
    position: absolute;
    left: 8cqw;
    right: 8cqw;
    top: 42%;
    text-align: center;
  }

  .cd__arrived p {
    font: 400 clamp(30px, 9cqw, 40px) / 1.15 var(--font-script);
    color: #6a0f1f;
    text-shadow: 0 0 2px rgba(255, 249, 238, 0.95), 0 0 12px rgba(255, 249, 238, 0.9);
  }

  @container app (max-height: 700px) {
    .cd__palkis {
      --b: min(36cqw, 18.5cqh);
      top: calc(var(--safe-top) + 22cqh);
    }

    .cd__head {
      top: calc(var(--safe-top) + 4cqh);
    }
  }
</style>
