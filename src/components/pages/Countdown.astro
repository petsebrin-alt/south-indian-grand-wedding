---
/**
 * Page 3 — Wedding Countdown (PRD §6.5), as the client asked: the courtyard photograph of the
 * earlier pages with the temple tower and the palms taken out (warm morning sky in their place),
 * and their elephant-and-peacock board standing in it with the countdown inside in one straight
 * row. The two elephants raise and lower their trunks, slowly and smoothly (each trunk is cut in
 * two jointed pieces that swing on its base and at the middle of its curve; src/assets/countdown/,
 * npm run countdown:assets). Motion and counting: src/motion/pages/countdown.ts
 */
import PageShell from '../PageShell.astro';
import ScenePhoto from '../ScenePhoto.astro';
import CourtyardScene from '../CourtyardScene.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import { formatDateLong, formatTime } from '../../lib/format';
import fit from '../../assets/countdown/board.json';
import board from '../../assets/countdown/board.webp';
import boardAvif from '../../assets/countdown/board.avif';
import courtyardClear from '../../assets/countdown/courtyard-clear.webp';
import courtyardClearAvif from '../../assets/countdown/courtyard-clear.avif';
import trunkLLower from '../../assets/countdown/trunk-l-lower.webp';
import trunkLUpper from '../../assets/countdown/trunk-l-upper.webp';
import trunkRLower from '../../assets/countdown/trunk-r-lower.webp';
import trunkRUpper from '../../assets/countdown/trunk-r-upper.webp';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
const { startISO } = wedding.ceremony;
const units = [
  { key: 'days', label: 'Days' },
  { key: 'hours', label: 'Hours' },
  { key: 'minutes', label: 'Minutes' },
  { key: 'seconds', label: 'Seconds' },
];

type Piece = { box: number[]; pivot: number[] };
const pct = (n: number) => `${+n.toFixed(3)}%`;
const at = ([x0, y0, x1, y1]: number[]) => `left:${pct(x0)};top:${pct(y0)};width:${pct(x1 - x0)};height:${pct(y1 - y0)}`;
// The curled upper piece sits inside the lower one, so it rides on the lower piece's swing
const within = (inner: number[], outer: number[]) => {
  const [ox0, oy0, ox1, oy1] = outer, w = ox1 - ox0, h = oy1 - oy0;
  return `left:${pct(((inner[0] - ox0) / w) * 100)};top:${pct(((inner[1] - oy0) / h) * 100)};width:${pct(((inner[2] - inner[0]) / w) * 100)};height:${pct(((inner[3] - inner[1]) / h) * 100)}`;
};
const trunks = [
  { side: 'l', lower: fit['trunk-l-lower'] as Piece, upper: fit['trunk-l-upper'] as Piece, lowerImg: trunkLLower, upperImg: trunkLUpper },
  { side: 'r', lower: fit['trunk-r-lower'] as Piece, upper: fit['trunk-r-upper'] as Piece, lowerImg: trunkRLower, upperImg: trunkRUpper },
];
---

<PageShell page={page} index={index} watermark={false} class="cd">
  <Fragment slot="architecture">
    <CourtyardScene webp={courtyardClear} avif={courtyardClearAvif} without={['palm', 'palm-r']} />
    <span class="layer layer--architecture cd__veil" aria-hidden="true"></span>
  </Fragment>

  <h2 class="cd__title" tabindex="-1" data-page-heading>Counting down to the <span class="cd__title-script">Muhurtham</span></h2>

  <div class="cd__board" style={`--board-ratio:${fit.ratio}`}>
    <ScenePhoto class="cd__frame" avif={boardAvif} webp={board} defer />
    {
      trunks.map((t) => (
        <div class={`cd__trunk cd__trunk--${t.side}`} style={`${at(t.lower.box)};transform-origin:${t.lower.pivot[0]}% ${t.lower.pivot[1]}%`} aria-hidden="true">
          <img src={t.lowerImg.src} width={t.lowerImg.width} height={t.lowerImg.height} alt="" decoding="async" loading="lazy" />
          <div class={`cd__tip cd__tip--${t.side}`} style={`${within(t.upper.box, t.lower.box)};transform-origin:${t.upper.pivot[0]}% ${t.upper.pivot[1]}%`}>
            <img src={t.upperImg.src} width={t.upperImg.width} height={t.upperImg.height} alt="" decoding="async" loading="lazy" />
          </div>
        </div>
      ))
    }

    <div class="cd__panel" style={at(fit.panel)}>
      <div class="cd__row" data-countdown={startISO} role="timer" aria-label="Time remaining until the wedding Muhurtham">
        {
          units.map((u) => (
            <div class="cd__unit">
              <span class="cd__num" data-unit={u.key} aria-hidden="true">
                --
              </span>
              <span class="cd__label">{u.label}</span>
            </div>
          ))
        }
      </div>
      <p class="sr-only" data-countdown-summary></p>
      <div class="cd__arrived" data-arrived hidden>
        <p>{wedding.copy.countdownArrived.text}</p>
      </div>
      <div class="cd__meta">
        <p class="cd__when">{formatDateLong(startISO)}</p>
        <p class="cd__time">{formatTime(startISO)} IST</p>
        <p class="cd__local" data-localtime hidden></p>
      </div>
    </div>
  </div>
</PageShell>

<style is:global>
  .page--countdown .page__frame {
    display: none;
  }

  /* A soft ivory veil of morning light behind the heading */
  .cd__veil {
    inset: 0;
    background: radial-gradient(ellipse 72% 12% at 50% 15%, rgba(255, 249, 238, 0.72), rgba(255, 249, 238, 0) 100%);
  }

  .page--countdown .page__content {
    inset: 0;
    display: block;
  }

  .cd__title {
    position: absolute;
    left: 6cqw;
    right: 6cqw;
    top: calc(var(--safe-top) + 10cqh);
    text-align: center;
    font: 700 clamp(14px, 4.2cqw, 18px) / 1.3 var(--font-royal);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6a0f1f;
    text-shadow: 0 0 2px rgba(255, 249, 238, 0.95), 0 0 10px rgba(255, 249, 238, 0.9);
  }

  .cd__title-script {
    display: block;
    margin-top: 0.2em;
    font: 400 2.5em / 1 var(--font-script);
    letter-spacing: 0;
    text-transform: none;
    -webkit-text-stroke: 0.3px currentColor;
  }

  /* The board stands at the foot of the courtyard */
  .cd__board {
    --bw: min(98cqw, calc(70cqh / var(--board-ratio)));
    position: absolute;
    left: 50%;
    bottom: calc(var(--safe-bottom) + 5cqh);
    width: var(--bw);
    aspect-ratio: 1 / var(--board-ratio);
    translate: -50% 0;
  }

  .cd__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* The trunks: each lower piece swings on the trunk's base, and the curled upper piece swings at
     the middle of the S a moment later, so the trunk bends as it rises and falls */
  .cd__trunk,
  .cd__tip {
    position: absolute;
    pointer-events: none;
  }

  .cd__trunk img,
  .cd__tip img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cd__trunk--l {
    animation: cd-trunk-l 3.8s ease-in-out infinite alternate;
  }

  .cd__tip--l {
    animation: cd-tip-l 3.8s ease-in-out -0.8s infinite alternate;
  }

  .cd__trunk--r {
    animation: cd-trunk-r 4.2s ease-in-out -1.6s infinite alternate;
  }

  .cd__tip--r {
    animation: cd-tip-r 4.2s ease-in-out -2.5s infinite alternate;
  }

  /* Raised (curled back) at one end, lowered (curled forward) at the other */
  @keyframes cd-trunk-l {
    from {
      rotate: -4deg;
    }

    to {
      rotate: 6deg;
    }
  }

  @keyframes cd-tip-l {
    from {
      rotate: -7deg;
    }

    to {
      rotate: 11deg;
    }
  }

  @keyframes cd-trunk-r {
    from {
      rotate: 4deg;
    }

    to {
      rotate: -6deg;
    }
  }

  @keyframes cd-tip-r {
    from {
      rotate: 7deg;
    }

    to {
      rotate: -11deg;
    }
  }

  .reduce-motion :is(.cd__trunk, .cd__tip) {
    animation: none;
  }

  /* The countdown, in one straight row on the board's cream panel */
  .cd__panel {
    position: absolute;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cd__row {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .cd__unit {
    display: grid;
    justify-items: center;
    gap: 1.6cqw;
    padding-block: 1cqw;
  }

  /* Fine gold rules between the units */
  .cd__unit + .cd__unit {
    border-left: 1px solid rgba(168, 120, 42, 0.45);
  }

  .cd__num {
    display: inline-flex;
    justify-content: center;
    font: 700 max(20px, 11.5cqw) / 1 var(--font-display);
    font-variant-numeric: lining-nums tabular-nums;
    color: #6a0f1f;
  }

  .cd__slot {
    position: relative;
    display: inline-block;
    height: 1em;
    overflow: hidden;
  }

  .cd__digit {
    display: block;
  }

  .cd__digit + .cd__digit {
    position: absolute;
    inset: 0;
  }

  .cd__label {
    font: 700 max(8px, 3.6cqw) / 1 var(--font-royal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a5a1c;
  }

  .cd__arrived p {
    font: 400 max(20px, 10cqw) / 1.15 var(--font-script);
    color: #6a0f1f;
  }

  .cd__meta {
    margin-top: 4cqw;
    display: grid;
    gap: 1cqw;
  }

  .cd__when {
    font: 700 max(13px, 6.2cqw) / 1.2 var(--font-display);
    color: #6a0f1f;
  }

  .cd__time {
    font: 700 max(9px, 4.2cqw) / 1.3 var(--font-royal);
    letter-spacing: 0.18em;
    color: #1d5232;
  }

  .cd__local {
    max-width: 82cqw;
    margin-inline: auto;
    font: 500 max(9px, 3.6cqw) / 1.3 var(--font-body);
    color: #5a3626;
    text-wrap: balance;
  }
</style>
