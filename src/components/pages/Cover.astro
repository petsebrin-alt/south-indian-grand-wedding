---
/**
 * Cover — the temple entrance opening (PRD §6.1), built from the client's photographs
 * (src/assets/opening/, measured in scene.json, layers made by `npm run opening:assets`).
 * 1. Doors: the decorated entrance; garlands, swag and banana leaves stir in the breeze.
 * 2. Entering: the hanging bell is rung, the doors swing open on their hinges, birds cross the
 *    sky, we walk through into the courtyard, the R·D monogram descends and comes forward,
 *    giving way to the invitation card.
 * 3. Invitation: the client's velvet card photograph, with "Dear" in calligraphy and the guest's name
 *    (the link's ?to= name) beneath it in serif capitals, the couple's names set in its gold under the
 *    couple, and its printed "Open the Invitation" as the button, its ring blinking so a guest knows
 *    to touch it: the card's cover opens on its hinge and the book's first page turns.
 * Without JavaScript only the invitation is shown. Motion: src/motion/pages/cover.ts
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import PageShell from '../PageShell.astro';
import Icon from '../Icon.astro';
import MonogramRD from '../MonogramRD.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import ScenePhoto from '../ScenePhoto.astro';
import scene from '../../assets/opening/scene.json';
import entrance from '../../assets/opening/entrance.webp';
import entranceAvif from '../../assets/opening/entrance.avif';
import frameCut from '../../assets/opening/frame.webp';
import frameCutAvif from '../../assets/opening/frame.avif';
import leaves from '../../assets/opening/leaves.webp';
import leavesAvif from '../../assets/opening/leaves.avif';
import hangings from '../../assets/opening/hangings.webp';
import courtyard from '../../assets/opening/courtyard.webp';
import courtyardAvif from '../../assets/opening/courtyard.avif';
import bellAvif from '../../assets/opening/bell.avif';
import bell from '../../assets/opening/bell.webp';
import bellFit from '../../assets/opening/bell.json';
import chain from '../../assets/opening/chain.webp';
import cardAvif from '../../assets/opening/card.avif';
import cardWebp from '../../assets/opening/card.webp';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
const { groom, bride } = wedding.couple;
const bellRecording = existsSync(join(process.cwd(), 'public/audio/temple-bell.mp3')) ? '/audio/temple-bell.mp3' : '';

const { door, court } = scene;
const pct = (n: number) => `${+n.toFixed(3)}%`;
const ratio = scene.photo.height / scene.photo.width;
const box = ([x0, y0, x1, y1]: number[]) => `left:${pct(x0)};top:${pct(y0)};width:${pct(x1 - x0)};height:${pct(y1 - y0)}`;
/** An element showing one region of the photograph: the full image, offset so the region shows. */
const cropImg = ([x0, y0, x1, y1]: number[]) => `width:${pct((100 / (x1 - x0)) * 100)};left:${pct((-x0 / (x1 - x0)) * 100)};top:${pct((-y0 / (y1 - y0)) * 100)}`;

// Each door leaf is half of the doorway, its top following the carved arch
const leafClip = (side: 'l' | 'r') => {
  const [a, b] = side === 'l' ? [door.x0, door.seam] : [door.seam, door.x1];
  const top = door.arch.filter(([x]) => x >= a - 0.01 && x <= b + 0.01).map(([x, y]) => `${pct(((x - a) / (b - a)) * 100)} ${pct(((y - door.y0) / (door.y1 - door.y0)) * 100)}`);
  return `polygon(${[...top, '100% 100%', '0% 100%'].join(', ')})`;
};
// Places on the card photograph (scene.json `card`, source pixels) as % of the card
const { card } = scene;
const [kx0, ky0, kx1, ky1] = card.box;
const onCard = ([x0, y0, x1, y1]: number[]) =>
  `left:${pct(((x0 - kx0) / (kx1 - kx0)) * 100)};top:${pct(((y0 - ky0) / (ky1 - ky0)) * 100)};width:${pct(((x1 - x0) / (kx1 - kx0)) * 100)};height:${pct(((y1 - y0) / (ky1 - ky0)) * 100)}`;
// The photographed card is a touch wider at the bottom than the top
const cardShape = `polygon(${pct(card.top[0])} 0, ${pct(card.top[1])} 0, 100% 100%, 0 100%)`;
const bellHeight = scene.bell.height; // % of the scene height
const bellWidth = (bellHeight * ratio) / (bell.height / bell.width);
---

<PageShell page={page} index={index} watermark={false} class="cover">
  <Fragment slot="architecture">
    <!-- The temple courtyard beyond the doors; the invitation rests here afterwards -->
    <div class="layer layer--architecture op-scene op-scene--back" style={`--ratio:${ratio}`} aria-hidden="true">
      <div class="op-court" data-court data-shrine={court.shrine.join(' ')} style={`--behind:${court.behind};--near:${court.near};transform-origin:${court.origin[0]}% ${court.origin[1]}%`}>
        <ScenePhoto class="op-court__img" avif={courtyardAvif} webp={courtyard} defer />
        <div class="op-birds" data-birds></div>
      </div>
    </div>
    <span class="layer layer--architecture op-scrim" data-scrim aria-hidden="true"></span>
  </Fragment>

  <!-- 3. The invitation card (the only stage without JavaScript) -->
  <div class="cv-card" data-book style={`--card-ratio:${(kx1 - kx0) / (ky1 - ky0)};--card-shape:${cardShape}`}>
    <div class="cv-inv__inside" aria-hidden="true"><MonogramRD class="cv-inv__mono" /></div>
    <div class="cv-inv__cover" data-cover>
      <div class="cv-inv__front">
        <ScenePhoto class="cv-inv__photo" avif={cardAvif} webp={cardWebp} lazy />
        <p class="cv-inv__dear cv-inv__text" style={onCard(card.greeting)}><span class="cv-inv__dear-word cv-foil">Dear</span><span class="cv-inv__guest cv-foil" data-guest>Guest</span></p>
        <h1 class="cv-inv__names cv-inv__text" style={onCard(card.names)} tabindex="-1" data-page-heading><span class="cv-foil">{groom.name} <span class="amp">&amp;</span> {bride.name}</span></h1>
        <a class="cv-open" href="#welcome" data-open-book style={onCard(card.open)}><span class="sr-only">Open the Invitation</span></a>
        <span class="cv-inv__shade" data-cover-shade aria-hidden="true"></span>
      </div>
      <div class="cv-inv__back" aria-hidden="true"></div>
    </div>
  </div>

  <Fragment slot="foreground">
    <!-- 2. The monogram that descends from the sky -->
    <div class="layer layer--foreground cv-mono js-only" data-mono aria-hidden="true"><MonogramRD /></div>

    <!-- 1. The temple entrance, from the photograph -->
    <div class="layer layer--foreground op js-only" data-entrance data-gesture="none" data-bell-src={bellRecording}>
      <div class="op-scene op-scene--front" style={`--ratio:${ratio}`}>
        <div class="op-front" data-front>
          <span class="op-lintel" style={box([door.x0, door.y0 - 1, door.x1, door.y0 + 9])}></span>
          <span class="op-glow" data-glow style={box([door.x0, door.y0 - 2, door.x1, door.y1])}></span>
          <div class="op-doorway" style={box([door.x0, door.y0, door.x1, door.y1])}>
            {
              (['l', 'r'] as const).map((side) => (
                <div class:list={['op-leaf', `op-leaf--${side}`]} data-door={side} style={`clip-path:${leafClip(side)}`}>
                  <ScenePhoto avif={leavesAvif} webp={leaves} defer style={side === 'l' ? 'width:200%;left:0' : 'width:200%;left:-100%'} />
                </div>
              ))
            }
          </div>
          <ScenePhoto class="op-hangings" webp={hangings} defer style={box([door.x0, door.y0, door.x1, 22.6])} />
          <!-- The whole photograph while the doors are shut; the same with the doorway cut out once they move -->
          <ScenePhoto class="op-frame op-frame--whole" avif={entranceAvif} webp={entrance} priority />
          <ScenePhoto class="op-frame op-frame--cut" avif={frameCutAvif} webp={frameCut} defer />
          {
            scene.wind.map((w) => (
              <div
                class:list={['op-wind', `op-wind--${w.feather}`]}
                data-wind={w.amp}
                style={`${box(w.box)};transform-origin:${pct(((w.pivot[0] - w.box[0]) / (w.box[2] - w.box[0])) * 100)} ${pct(((w.pivot[1] - w.box[1]) / (w.box[3] - w.box[1])) * 100)}`}
              >
                <ScenePhoto avif={entranceAvif} webp={entrance} style={cropImg(w.box)} />
              </div>
            ))
          }
          <button class="op-bell" type="button" data-ring aria-label="Ring the temple bell to open the doors" style={`left:${pct(scene.bell.x - bellWidth / 2)};top:${pct(scene.bell.top)};width:${pct(bellWidth)}`}>
            <span class="op-bell__chain" style={`background-image:url("${chain.src}");left:${pct(bellFit.chainCenter - bellFit.chainWidth / 2)};width:${pct(bellFit.chainWidth)}`} aria-hidden="true"></span>
            <ScenePhoto avif={bellAvif} webp={bell} />
            <span class="op-bell__halo" aria-hidden="true"></span>
          </button>
        </div>
      </div>
      <button class="cv-enter" type="button" data-ring>Tap the bell to enter</button>
    </div>
    <button class="cv-sound js-only" type="button" data-sound aria-pressed="true" aria-label="Bell sound">
      <span class="cv-sound__on"><Icon name="sound-on" /></span>
      <span class="cv-sound__off"><Icon name="sound-off" /></span>
    </button>
  </Fragment>
</PageShell>

<style is:global>
  /* ------------------------------------------------------------------ stages */

  .cover .page__content {
    gap: 2.4cqh;
  }

  .js .cover:not([data-stage='book']) :is(.cv-card, .cv-open, .page__frame, .op-scrim) {
    opacity: 0;
    visibility: hidden;
  }

  /* Until the bell is rung the card is not laid out at all, so its fonts and artwork wait
     until after the door photograph */
  .js .cover:not([data-stage='entering'], [data-stage='book']) :is(.cv-card, .cv-open) {
    display: none;
  }

  .js .cover[data-stage='book'] :is(.op, .cv-mono, .cv-sound) {
    display: none;
  }

  .cv-mono {
    opacity: 0;
    visibility: hidden;
  }

  /* ------------------------------------------------------------------ the photographed scene */

  /* A box with the photograph's proportions that covers the page; every layer inside is
     positioned in percent of the photograph, so the pieces stay aligned on any screen. */
  .op-scene {
    position: absolute;
    left: 50%;
    top: 50%;
    height: max(100cqh, calc(100cqw * var(--ratio)));
    aspect-ratio: 1 / var(--ratio);
    translate: -50% -50%;
  }

  .op-court {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform: scale(var(--behind));
  }

  .op-court__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The walk ends nearer the gopuram (src/motion/pages/cover.ts) */
  .js .cover[data-stage='book'] .op-court {
    transform: scale(var(--near));
  }

  .op-scrim {
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 50%, rgba(40, 20, 10, 0.2), rgba(40, 20, 10, 0.55));
  }

  .op-birds {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .op {
    inset: 0;
    overflow: hidden;
    overflow: clip; /* never scrolled by focus: the scene must stay aligned */
    z-index: calc(var(--z-foreground) + 2);
    pointer-events: auto;
  }

  .op-front {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
  }

  .op-front > *,
  .op-doorway > * {
    position: absolute;
  }

  .op-front img {
    display: block;
    max-width: none;
  }

  .op-glow {
    background: radial-gradient(ellipse at 50% 45%, rgba(255, 250, 235, 0.95), rgba(255, 244, 220, 0.55) 45%, rgba(255, 244, 220, 0) 75%);
    opacity: 0;
  }

  .op-doorway {
    perspective: 900px;
    perspective-origin: 50% 48%;
  }

  .op-leaf {
    top: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    will-change: transform;
  }

  .op-leaf img {
    position: absolute;
    top: 0;
    height: 100%;
  }

  /* The leaves darken as they turn away from the light */
  .op-leaf::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20, 8, 4, 0.12), rgba(20, 8, 4, 0.6));
    opacity: var(--shade, 0);
  }

  .op-leaf--l {
    left: 0;
    transform-origin: 0 50%;
  }

  .op-leaf--r {
    right: 0;
    transform-origin: 100% 50%;
  }

  .op-leaf--r::after {
    background: linear-gradient(270deg, rgba(20, 8, 4, 0.12), rgba(20, 8, 4, 0.6));
  }

  .op-hangings {
    position: absolute;
    pointer-events: none;
  }

  .op-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Once the doors move, the photograph with the doorway cut out takes over (made in advance by
     npm run opening:assets, so nothing is masked while the scene moves) */
  .op-frame--cut,
  .op-front.is-open .op-frame--whole {
    visibility: hidden;
  }

  .op-front.is-open .op-frame--cut {
    visibility: visible;
  }

  /* Garlands, swag and banana leaves: pieces of the photograph that stir in the breeze. Their
     edges fade into the still photograph, so a moving piece reads as the flowers flexing. */
  .op-wind {
    overflow: hidden;
    pointer-events: none;
    will-change: transform;
    mask-image: linear-gradient(90deg, transparent 0, #000 16%, #000 84%, transparent 100%), linear-gradient(180deg, #000 0, #000 72%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 16%, #000 84%, transparent 100%), linear-gradient(180deg, #000 0, #000 72%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  .op-wind--all {
    mask-image: linear-gradient(90deg, transparent 0, #000 22%, #000 78%, transparent 100%), linear-gradient(180deg, transparent 0, #000 22%, #000 78%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22%, #000 78%, transparent 100%), linear-gradient(180deg, transparent 0, #000 22%, #000 78%, transparent 100%);
  }

  /* The depth of the lintel above the doorway, seen as the doors draw back */
  .op-lintel {
    background: linear-gradient(180deg, rgba(36, 14, 6, 0.85), rgba(36, 14, 6, 0.45) 45%, rgba(36, 14, 6, 0));
  }

  .op-wind img {
    position: absolute;
    height: auto;
  }

  /* The bell hangs in the doorway on a long chain from the beam above */
  .op-bell {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform-origin: 50% -60%;
    z-index: 3;
  }

  .op-bell img {
    position: relative;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 6px 6px rgba(40, 20, 5, 0.35));
  }

  /* The beaded chain above the bell: one repeat of it, tiled up to the beam, its links meeting
     the bell's own (placed from bell.json; npm run opening:assets) */
  .op-bell__chain {
    position: absolute;
    bottom: 99%;
    height: 72%;
    background-position: center bottom;
    background-size: 100% auto;
    background-repeat: repeat-y;
  }

  .op-bell__halo {
    position: absolute;
    left: 50%;
    bottom: 2%;
    width: 110%;
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: 50%;
    border: 2px solid rgba(255, 236, 190, 0.85);
    box-shadow: 0 0 16px rgba(255, 220, 150, 0.7);
    animation: bell-call 2.6s ease-out infinite;
    pointer-events: none;
  }

  @keyframes bell-call {
    0% {
      transform: scale(0.55);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.15);
      opacity: 0;
    }
  }

  .reduce-motion .op-bell__halo {
    animation: none;
    opacity: 0.7;
  }

  .cv-enter {
    position: absolute;
    left: 50%;
    bottom: calc(var(--safe-bottom) + 3.5cqh);
    translate: -50% 0;
    z-index: 4;
    min-height: 46px;
    padding: 0 26px;
    border: 1px solid #e9c97f;
    border-radius: 999px;
    background: rgba(122, 38, 53, 0.9);
    color: #fff4dc;
    font: 600 12px/1 var(--font-royal);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 8px 20px rgba(60, 20, 20, 0.4);
    cursor: pointer;
  }

  /* On a narrow screen (a small desktop mockup) the prompt sits just above the sound button */
  @container app (max-width: 359px) {
    .cv-enter {
      bottom: calc(var(--safe-bottom) + 3.5cqh + 56px);
    }
  }

  /* Sound: bottom-left, clear of the page-curl corner on the right */
  .cv-sound {
    position: absolute;
    left: calc(var(--safe-left) + 14px);
    bottom: calc(var(--safe-bottom) + 3.5cqh);
    z-index: calc(var(--z-foreground) + 3);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(233, 201, 127, 0.9);
    border-radius: 50%;
    background: rgba(122, 38, 53, 0.88);
    color: #fff4dc;
    padding: 0;
  }

  .cv-sound svg {
    width: 22px;
    height: 22px;
  }

  .cv-sound[aria-pressed='true'] .cv-sound__off,
  .cv-sound[aria-pressed='false'] .cv-sound__on {
    display: none;
  }

  /* ------------------------------------------------------------------ the monogram */

  /* Where the logo comes to rest, having come out of the temple towards us (cover.ts, emerge) */
  .cv-mono {
    left: 50%;
    top: 42%;
    width: min(80cqw, 46cqh);
    translate: -50% -50%;
    z-index: calc(var(--z-foreground) + 1);
  }

  .cv-mono .monogram-rd {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 16px rgba(40, 20, 5, 0.35));
  }

  /* ------------------------------------------------------------------ the invitation card */

  /* The client's velvet card photograph; its own lettering and the live text share one gold */
  .cv-card {
    position: relative;
    flex: none;
    width: min(84cqw, calc(66cqh * var(--card-ratio)));
    height: min(calc(84cqw / var(--card-ratio)), 66cqh);
    perspective: 2400px;
    container-type: size;
  }

  /* The card's shadow on the scene. A box shadow, not a filter: filters here upset the depth
     order of the opening cover in some browsers. */
  .cv-card::before {
    content: '';
    position: absolute;
    inset: 0.6% 0.8% 0;
    transform: translateZ(-4px);
    box-shadow: 0 2.4cqh 3.4cqh rgba(30, 8, 4, 0.42), 0 0.4cqh 0.8cqh rgba(30, 8, 4, 0.3);
  }

  /* Inside the card, seen as the cover opens */
  .cv-inv__inside {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    /* A hair behind the cover, so no browser draws it in front where the two meet */
    transform: translateZ(-2px);
  }

  .cv-inv__inside::before,
  .cv-inv__back {
    clip-path: var(--card-shape);
    background-color: #f3e9d4;
    background-image: linear-gradient(90deg, rgba(70, 35, 10, 0.22), rgba(70, 35, 10, 0) 22%), var(--paper-texture);
    background-blend-mode: normal, multiply;
    box-shadow:
      inset 0 0 0 3cqw #f3e9d4,
      inset 0 0 0 3.3cqw #c39a4e,
      inset 0 0 0 3.9cqw #f3e9d4,
      inset 0 0 0 4.1cqw #c39a4e;
  }

  .cv-inv__inside::before {
    content: '';
    position: absolute;
    inset: 0;
  }

  .cv-inv__mono {
    position: relative;
    width: 46%;
    height: auto;
  }

  /* The cover turns on its left edge */
  .cv-inv__cover {
    position: absolute;
    inset: 0;
    transform-origin: 0 50%;
    transform-style: preserve-3d;
  }

  .cv-inv__front,
  .cv-inv__back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .cv-inv__back {
    transform: rotateY(180deg);
    background-image: linear-gradient(270deg, rgba(70, 35, 10, 0.26), rgba(70, 35, 10, 0) 26%), var(--paper-texture);
  }

  .cv-inv__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cv-inv__shade {
    position: absolute;
    inset: 0;
    clip-path: var(--card-shape);
    background: linear-gradient(90deg, rgba(25, 0, 4, 0.2), rgba(25, 0, 4, 0.65));
    opacity: 0;
    pointer-events: none;
  }

  /* Gold foil, matched to the card's printing: pale highlights, warm brown in the shadows,
     and the faint emboss of a stamped impression */
  .cv-inv__text {
    position: absolute;
    margin: 0;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .cv-foil {
    display: inline-block;
    max-width: 100%;
    color: #e3bd6c;
    background-image: linear-gradient(180deg, #fae4a2 2%, #efcb76 34%, #e3b961 58%, #c9984b 80%, #eac672 98%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0.18cqh 0 rgba(42, 0, 8, 0.75)) drop-shadow(0 -0.05cqh 0 rgba(255, 236, 190, 0.3));
  }

  /* "Dear" in calligraphy, the guest's name beneath it in clear serif capitals. The name is sized to
     fit by src/motion/pages/cover.ts (fitGreeting); a very long name takes two lines */
  .cv-inv__dear {
    align-content: center;
    gap: 0.5cqh;
  }

  .cv-inv__dear-word {
    font: 400 7.6cqh / 1 var(--font-script);
  }

  .cv-inv__guest {
    font: 600 calc(4.3cqh * var(--guest-scale, 1)) / 1.2 var(--font-royal);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* The couple's names, under the couple */
  .cv-inv__names {
    font: 600 4.3cqh / 1.1 var(--font-display);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Inline (not the usual inline-block) so the gold fill reaches it too */
  .cv-inv__names .amp {
    display: inline;
    transform: none;
    color: inherit;
    font-size: 0.86em;
  }

  /* The printed "Open the Invitation" is the button: a stamped gold ring around it that blinks, so a
     guest knows to touch it, light passing across it now and then, and a slight press when tapped */
  .cv-open {
    position: absolute;
    border: max(1px, 0.22cqh) solid rgba(234, 198, 120, 0.92);
    border-radius: 999px;
    outline: max(1px, 0.14cqh) solid rgba(234, 198, 120, 0.5);
    outline-offset: 0.55cqh;
    box-shadow: inset 0 0 1.4cqh rgba(255, 214, 150, 0.16), 0 0.3cqh 0.8cqh rgba(30, 0, 4, 0.35);
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.15s ease-out;
