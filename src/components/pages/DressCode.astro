---
/**
 * Page 12 — Dress Code (PRD §6.12), after the client's picture: a garden of jasmine garlands and temple bells
 * (src/assets/dresscode/, cut from the client's two pictures; npm run dresscode:assets), the heading over it, and a stack
 * of the five finished cards (Mehendi, Haldi, Sangeet Night, Wedding, Reception) that turn by themselves, one after
 * another, and by arrow, dot or swipe. Each card is the client's picture with its couple, garlands and lamps; its
 * title, mood, "Suggested Colours", the four colour discs and the line of guidance are real text and real colours
 * from `dressCode` in src/data/wedding.ts, so they can be changed. Behaviour: src/motion/deck.ts
 */
import PageShell from '../PageShell.astro';
import ScenePhoto from '../ScenePhoto.astro';
import Icon from '../Icon.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import meta from '../../assets/dresscode/dresscode.json';
import scene from '../../assets/dresscode/scene.webp';
import sceneAvif from '../../assets/dresscode/scene.avif';
import ornament from '../../assets/dresscode/ornament.webp';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/dresscode/card-*.webp', { eager: true });
type CardMeta = (typeof meta.cards)[keyof typeof meta.cards];
const cards = wedding.dressCode.map((d) => {
  const event = wedding.events.find((e) => e.id === d.eventId)!;
  const m = (meta.cards as Record<string, CardMeta>)[d.eventId];
  const img = images[`../../assets/dresscode/card-${d.eventId}.webp`].default;
  return { ...d, event, m, img };
});
const first = cards[0].m;
---

<PageShell page={page} index={index} watermark={false} class="dc">
  <Fragment slot="architecture">
    <div class="layer layer--architecture dc__scene" aria-hidden="true">
      <ScenePhoto class="dc__bg" avif={sceneAvif} webp={scene} defer />
    </div>
  </Fragment>

  <div class="dc__head">
    <img class="dc__orn" data-src={ornament.src} width={meta.ornament.width} height={meta.ornament.height} alt="" decoding="async" />
    <h2 class="dc__title" tabindex="-1" data-page-heading>Dress Code</h2>
    <p class="dc__sub">Suggestions to celebrate in colour</p>
    <span class="dc__pill">Suggested</span>
  </div>

  <div
    class="dc__deck"
    data-deck
    data-gesture="x"
    tabindex="0"
    role="group"
    aria-roledescription="carousel"
    aria-label="Dress code suggestions for each celebration. They turn by themselves; use the arrow keys to move between them."
    style={`--deck-ratio:${first.width} / ${first.height}`}
  >
    {
      cards.map((c, i) => (
        <div class="dc__slot" data-card={i} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${cards.length}: ${c.title}. ${c.suggestion} Suggested colours: ${c.palette.map((p) => p.name).join(', ')}.`}>
          <article class="dc__card" style={`--ar:${c.m.width} / ${c.m.height};--s:${(487 / c.m.srcWidth).toFixed(4)}`}>
            <img class="dc__art" data-src={c.img.src} width={c.m.width} height={c.m.height} alt="" decoding="async" />
            <noscript><img class="dc__art" src={c.img.src} width={c.m.width} height={c.m.height} alt="" decoding="async" /></noscript>
            <h3 class="dc__t" style={`left:${c.m.title.cx}%;top:${c.m.title.cy}%;--cap:${c.m.title.cap}`}>{c.title}</h3>
            <p class="dc__tag" style={`left:${c.m.tagline.cx}%;top:${c.m.tagline.cy}%;--h:${c.m.tagline.h}`}>{c.tagline}</p>
            <p class="dc__label" style={`left:${c.m.label.cx}%;top:${c.m.label.cy}%;--h:${c.m.label.h}`}>Suggested Colours</p>
            <ul class="dc__discs" aria-hidden="true">
              {c.palette.map((p, j) => (
                <li class="dc__disc" title={p.name} style={`left:${c.m.discs[j].cx}%;top:${c.m.discs[j].cy}%;--d:${c.m.disc};--sw:${p.color}`} />
              ))}
            </ul>
            <p class="dc__desc" style={`left:${c.m.desc.cx}%;top:${c.m.desc.cy}%;--w:${c.m.desc.w}`}>{c.suggestion}</p>
          </article>
        </div>
      ))
    }
  </div>

  <div class="dc__nav">
    <button class="ls__arrow" type="button" data-deck-prev aria-label="Previous card"><Icon name="chevron-left" /></button>
    <div class="dc__dots">
      {cards.map((c, i) => <button class:list={['ls__dot', i === 0 && 'is-active']} type="button" data-deck-dot={i} aria-label={`Show ${c.title}`} />)}
    </div>
    <button class="ls__arrow" type="button" data-deck-next aria-label="Next card"><Icon name="chevron-right" /></button>
    <p class="sr-only" aria-live="polite" data-deck-live></p>
  </div>
</PageShell>

<style is:global>
  /* One design unit (--u) is a pixel of a 430 × 932 phone, scaled to the page, so the layout keeps its shape on any phone. */
  .dc {
    --u: min(0.2326cqw, 0.1073cqh);
  }

  .dc .page__frame {
    display: none;
  }

  .dc .page__content {
    inset: 0;
    display: block;
  }

  /* ---------------------------------------------------------------- the garden */
  .dc__scene {
    inset: 0;
    overflow: hidden;
    background: #cfe0ee;
  }

  .dc__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  /* ---------------------------------------------------------------- the heading */
  .dc__head {
    position: absolute;
    left: 50%;
    top: calc(var(--u) * 48);
    width: calc(var(--u) * 232);
    translate: -50% 0;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .dc__orn {
    display: block;
    width: calc(var(--u) * 170);
    max-width: none;
    height: auto;
  }

  .dc__title {
    margin-top: calc(var(--u) * 2);
    font: 600 calc(var(--u) * 29) / 1.1 var(--font-display);
    letter-spacing: 0.12em;
    text-indent: 0.12em;
    text-transform: uppercase;
    color: #4a3126;
    text-shadow: 0 0 calc(var(--u) * 10) rgba(255, 252, 244, 0.85);
  }

  .dc__sub {
    margin-top: calc(var(--u) * 5);
    font: 400 calc(var(--u) * 12) / 1.3 var(--font-body);
    color: #5d4637;
    text-shadow: 0 0 calc(var(--u) * 8) rgba(255, 252, 244, 0.95);
  }

  .dc__pill {
    margin-top: calc(var(--u) * 9);
    padding: calc(var(--u) * 5) calc(var(--u) * 22);
    border: 2px dotted #c9a24a;
    border-radius: 999px;
    background: rgba(250, 240, 214, 0.88);
    box-shadow: 0 0 0 calc(var(--u) * 2) rgba(250, 240, 214, 0.5);
    font: 500 calc(var(--u) * 11.5) / 1.2 var(--font-royal);
    letter-spacing: 0.2em;
    text-indent: 0.2em;
    text-transform: uppercase;
    color: #8a6420;
  }

  /* ---------------------------------------------------------------- the stack of cards */
  .dc__deck {
    position: absolute;
    left: 50%;
    top: calc(var(--u) * 206);
    width: calc(var(--u) * 372);
    aspect-ratio: var(--deck-ratio);
    translate: -50% 0;
    touch-action: pan-y pinch-zoom;
    outline-offset: 8px;
  }

  .dc__slot {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    will-change: transform;
  }

  .dc__card {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ar);
    container-type: inline-size;
    border-radius: calc(var(--u) * 5);
    filter: drop-shadow(0 calc(var(--u) * 9) calc(var(--u) * 12) rgba(60, 38, 10, 0.36));
  }

  .dc__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }

  /* The card's writing, set where the picture had it (the positions and sizes are % of the card) */
  .dc__t,
  .dc__tag,
  .dc__label,
  .dc__desc {
    position: absolute;
    translate: -50% -50%;
    text-align: center;
    pointer-events: none;
  }

  .dc__t {
    font: 600 calc(var(--cap) * 1.46cqw) / 1 var(--font-royal);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #4a3126;
  }

  .dc__tag {
    font: 400 calc(var(--h) * 1cqw) / 1 var(--font-body);
    white-space: nowrap;
    color: #66503f;
  }

  .dc__label {
    font: 500 calc(var(--h) * 1.1cqw) / 1.2 var(--font-display);
    white-space: nowrap;
    color: #55402f;
  }

  .dc__discs {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .dc__disc {
    position: absolute;
    width: calc(var(--d) * 1cqw);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--sw);
    box-shadow:
      inset 0 0 0 1px rgba(60, 40, 20, 0.12),
      inset 0 calc(var(--d) * -0.1cqw) calc(var(--d) * 0.16cqw) rgba(0, 0, 0, 0.1),
      0 1px 2px rgba(60, 40, 20, 0.18);
  }

  /* the lettering is the same size on every card (--s: the card's width against the narrowest) */
  .dc__desc {
    width: calc(var(--s) * 29cqw);
    font: 500 calc(var(--s) * 3.5cqw) / 1.26 var(--font-display);
    color: #55402f;
    text-wrap: balance;
  }

  /* ---------------------------------------------------------------- arrows and dots */
  .dc__nav {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--u) * 616);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--u) * 14);
  }

  .dc__dots {
    display: flex;
    gap: 2px;
  }

  html:not(.js) .dc__slot:not(:first-child) {
    display: none;
  }
</style>
