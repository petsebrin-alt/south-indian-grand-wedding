---
/**
 * Page 10 — The Sacred Wedding Ceremony (PRD §6.10), on the client's picture of a real golden
 * mandapam (src/assets/ceremony/, npm run ceremony:assets): carved pillars and beam, a mango-leaf
 * toran, hanging jasmine garlands, banana plants, brass lamps and kalasams, a bowl of petals and a
 * rangoli on marble. When the page turns in, its pieces arrive one by one from above (the beam, the
 * pillars, the toran, the garlands unrolling, the lamps, the banana plants, the floor) over a soft
 * glow of the hall, and the board follows with only the essentials in live text (the ceremony's name,
 * Rahul & Divya and the date) and a blinking "Accept the Invitation" button with a tapping hand.
 * Accepting turns the button to "Accepted" and sets off a shower of petals, music and two cone
 * crackers on the floor throwing sparks; meanwhile the lines above float up and away and the couple
 * from the first page appear with a thank-you and a "Return to RSVP" button, which brings the board
 * back to the invitation and its Accept button (it does not turn the page).
 * Motion: src/motion/pages/ceremony.ts, src/motion/celebrate.ts
 */
import PageShell from '../PageShell.astro';
import ScenePhoto from '../ScenePhoto.astro';
import Icon from '../Icon.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import { formatDateLong } from '../../lib/format';
import couple from '../../assets/welcome/couple.webp';
import coupleAvif from '../../assets/welcome/couple.avif';
import meta from '../../assets/ceremony/ceremony.json';
import base from '../../assets/ceremony/base.webp';
import clean from '../../assets/ceremony/clean.webp';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
const { groom, bride } = wedding.couple;
const { startISO } = wedding.ceremony;
const pieceImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/ceremony/piece-*.webp', { eager: true });
const pieceSrc = (id: string) => pieceImages[`../../assets/ceremony/piece-${id}.webp`].default.src;
const box = (b: number[]) => `left:${b[0]}%;top:${b[1]}%;width:${b[2]}%;height:${b[3]}%`;
---

<PageShell page={page} index={index} watermark={false} class="cm">
  <Fragment slot="architecture">
    <div class="layer layer--architecture cm__scene" aria-hidden="true" style={`--ratio:${meta.height / meta.width}`}>
      <div class="cm__box">
        <div class="cm__base" style={`background-image:url("${base.src}")`}></div>
        <img class="cm__rest" data-src={clean.src} alt="" decoding="async" />
        <noscript><img class="cm__rest" src={clean.src} alt="" decoding="async" /></noscript>
        {meta.pieces.map((p) => <img class={`cm__piece cm__piece--${p.id.replace(/-\d+$|-[lr]$/, '')}`} data-piece={p.id} data-src={pieceSrc(p.id)} style={box(p.box)} alt="" decoding="async" />)}
        {
          meta.crackers.map((c, i) => (
            <div class="cm__cracker" data-cracker style={`left:${c[0]}%;top:${c[1]}%`}>
              <svg viewBox="0 0 80 104" focusable="false">
                <defs>
                  <linearGradient id={`cm-cone-${i}`} x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0" stop-color="#5a0814" />
                    <stop offset="0.22" stop-color="#b8142b" />
                    <stop offset="0.5" stop-color="#e03a4f" />
                    <stop offset="0.78" stop-color="#99111f" />
                    <stop offset="1" stop-color="#4d0610" />
                  </linearGradient>
                  <linearGradient id={`cm-band-${i}`} x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0" stop-color="#8a5a16" />
                    <stop offset="0.4" stop-color="#f7dc8e" />
                    <stop offset="0.7" stop-color="#d4a443" />
                    <stop offset="1" stop-color="#7a4c10" />
                  </linearGradient>
                  <radialGradient id={`cm-hole-${i}`} cx="0.5" cy="0.5" r="0.5">
                    <stop offset="0" stop-color="#0d0503" />
                    <stop offset="1" stop-color="#2a0f08" />
                  </radialGradient>
                </defs>
                <ellipse cx="40" cy="97" rx="36" ry="6.5" fill="rgba(35,15,8,0.38)" />
                <path d="M5 95C11 71 25 37 32.5 14h15C55 37 69 71 75 95C60 102 20 102 5 95Z" fill={`url(#cm-cone-${i})`} />
                <path d="M19.4 54h41.2l2 6H17.4zM12.1 76h55.8l2.1 6H10z" fill={`url(#cm-band-${i})`} />
                <path d="M34 20C31 44 24 70 16 92" stroke="rgba(255,255,255,0.28)" stroke-width="2.2" fill="none" stroke-linecap="round" />
                <path d="M5 95C20 102 60 102 75 95" stroke="rgba(60,5,12,0.55)" stroke-width="2" fill="none" />
                <ellipse cx="40" cy="14" rx="8.4" ry="3.1" fill={`url(#cm-hole-${i})`} stroke="#d9b062" stroke-width="1" />
              </svg>
              <span class="cm__cracker-glow"></span>
            </div>
          ))
        }
      </div>
    </div>
  </Fragment>

  <div class="cm__clip" style={`--ratio:${meta.height / meta.width}`}>
   <div class="cm__frame">
    <div class="cm__board" style={box([meta.board.x, meta.board.y, meta.board.w, meta.board.h])}>
      <div class="cm__in">
        <div class="cm__top">
          <div class="cm__invite">
            <Icon name="lotus" class="cm__lotus" />
            <h2 class="cm__title cm__line" tabindex="-1" data-page-heading>The Sacred Wedding Ceremony</h2>
            <p class="cm__names cm__line">{groom.name} <span class="cm__amp">&amp;</span> {bride.name}</p>
            <p class="cm__date cm__line">{formatDateLong(startISO)}</p>
            <span class="cm__rule cm__line" aria-hidden="true"></span>
            <p class="cm__ask cm__line">Will you grace our wedding?</p>
          </div>
          <!-- After accepting: the couple from the first page, and their thanks -->
          <div class="cm__thanks" data-accept-thanks role="status">
            <div class="cm__cameo" data-thanks-part><ScenePhoto class="cm__cameo-img" avif={coupleAvif} webp={couple} defer /></div>
            <p class="cm__thanks-script" data-thanks-part>Thank you for accepting our invitation</p>
            <p class="cm__thanks-quote" data-thanks-part>&ldquo;Your presence and blessings will make our celebration complete.&rdquo;</p>
            <p class="cm__thanks-sign" data-thanks-part>&mdash; {groom.name} &amp; {bride.name}</p>
          </div>
        </div>
        <div class="cm__foot">
          <div class="cm__accept-wrap">
            <button class="cm__accept" type="button" data-accept aria-live="polite">
              <span class="cm__accept-text" data-accept-text>Accept the Invitation</span>
            </button>
            <!-- A tapping hand under the button, blinking softly, until it has been accepted -->
            <span class="cm__tap" data-accept-hand aria-hidden="true">
              <span class="cm__tap-ring"></span>
              <span class="cm__tap-ring cm__tap-ring--late"></span>
              <svg class="cm__hand" viewBox="0 0 40 48" focusable="false">
                <defs>
                  <linearGradient id="cm-hand-fill" x1="0" y1="0" x2="0.6" y2="1">
                    <stop offset="0" stop-color="#fff2c9" />
                    <stop offset="0.45" stop-color="#e9c46f" />
                    <stop offset="1" stop-color="#b8862f" />
                  </linearGradient>
                </defs>
                <g fill="url(#cm-hand-fill)" stroke="#6b3a10" stroke-width="1.1" stroke-linejoin="round">
                  <rect x="4" y="23" width="7" height="14" rx="3.5" transform="rotate(-36 7.5 30)" />
                  <rect x="30.5" y="19.5" width="5.6" height="12" rx="2.8" />
                  <rect x="24.5" y="17" width="6.4" height="14" rx="3.2" />
                  <rect x="18.5" y="15" width="6.6" height="16" rx="3.3" />
                  <path d="M12 26h24v6c0 8-5 14-12 14h-2c-5 0-8-2.5-10-7z" />
                  <rect x="12" y="2" width="7" height="30" rx="3.5" />
                </g>
              </svg>
            </span>
          </div>
          <button class="cm__rsvp-link" type="button" data-return>Return to RSVP</button>
        </div>
      </div>
    </div>
   </div>
  </div>

  <Fragment slot="foreground">
    <canvas class="layer layer--foreground cm__fx" aria-hidden="true" data-sparks></canvas>
  </Fragment>
</PageShell>

<style is:global>
  .cm .page__frame {
    display: none;
  }

  .cm .page__content {
    inset: 0;
    display: block;
  }

  /* The picture keeps its own proportions (nothing is stretched) and covers the whole page: as wide as the
     page, or on a tall phone wider (its plain sides, with the pillars' outer garlands, are cropped a little),
     sitting on the page's foot. The carved beam is stacked up to fill the height (npm run ceremony:assets). */
  .cm__scene,
  .cm__clip {
    --w: max(100cqw, calc(100cqh / var(--ratio)));
    --scene-h: calc(var(--w) * var(--ratio));
  }

  .cm__scene {
    inset: 0;
    overflow: hidden;
    background: #6f5230;
  }

  .cm__box,
  .cm__frame {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: var(--w);
    height: var(--scene-h);
    translate: -50% 0;
  }

  /* The board layer is clipped to the page, so nothing of the wider picture lies outside it */
  .cm__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .cm__base,
  .cm__rest {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cm__base {
    background: center / 100% 100% no-repeat;
  }

  .cm__piece {
    position: absolute;
    display: block;
    pointer-events: none;
    will-change: transform;
  }

  /* The cone crackers stand on the floor, their bases on the marked places */
  .cm__cracker {
    position: absolute;
    width: 9.2%;
    aspect-ratio: 80 / 104;
    translate: -50% -90%;
  }

  .cm__cracker svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* A warm light at the cone's mouth while it burns */
  .cm__cracker-glow {
    position: absolute;
    left: 50%;
    top: 13%;
    width: 160%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 233, 170, 0.95), rgba(255, 170, 70, 0.45) 35%, rgba(255, 140, 40, 0) 70%);
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }

  .cm.is-burning .cm__cracker-glow {
    animation: cm-glow 0.14s ease-in-out infinite alternate;
  }

  @keyframes cm-glow {
    from {
      opacity: 0.55;
      scale: 0.9;
    }

    to {
      opacity: 1;
      scale: 1.1;
    }
  }

  .cm__fx {
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ---------------------------------------------------------------- the board */
  .cm__board {
    position: absolute;
    container-type: inline-size;
    pointer-events: auto;
  }

  .cm__in {
    position: absolute;
    inset: 4.4cqw 6cqw 4.6cqw;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: #4a2418;
  }

  /* The top of the board holds the invitation, then (after accepting) the thanks in the same place */
  .cm__top {
    position: relative;
    flex: 1;
    width: 100%;
    min-height: 0;
  }

  .cm__invite,
  .cm__thanks {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 2.2cqw;
  }

  .cm__lotus {
    width: 9cqw;
    height: 9cqw;
    fill: none;
    stroke: #b8863a;
    stroke-width: 1.4;
  }

  .cm__title {
    font: 700 3.8cqw / 1.25 var(--font-royal);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #4a2418;
    text-wrap: balance;
  }

  .cm__names {
    font: 600 13.6cqw / 1.05 var(--font-display);
    color: #6a0f1f;
  }

  .cm__amp {
    font-size: 0.8em;
    color: #b8863a;
  }

  .cm__date {
    font: 500 6.4cqw / 1.15 var(--font-display);
    color: #4a2418;
  }

  .cm__rule {
    width: 44%;
    height: 1px;
    margin-block: 1cqw;
    background: linear-gradient(90deg, transparent, #b8863a 20%, #b8863a 80%, transparent);
  }

  .cm__ask {
    font: 400 8.4cqw / 1.05 var(--font-script);
    color: #8a1426;
    -webkit-text-stroke: 0.2px currentColor;
  }

  /* After accepting, the lines of the invitation are gone and the thanks stand in their place */
  .cm__thanks {
    display: none;
    gap: 1.8cqw;
  }

  .cm.is-thanks .cm__invite {
    display: none;
  }

  .cm.is-thanks .cm__thanks {
    display: grid;
  }

  /* The couple from the first page, in an oval with a gold edge */
  .cm__cameo {
    width: 30cqw;
    aspect-ratio: 4 / 4.6;
    overflow: hidden;
    border-radius: 50%;
    border: max(1.5px, 0.7cqw) solid #b8863a;
    background: radial-gradient(circle at 50% 38%, #fff6dc, #f1d89f);
    box-shadow: 0 0 0 1.2cqw #fff9ec, 0 0 0 1.7cqw rgba(184, 134, 58, 0.55), 0 2px 8px rgba(60, 30, 5, 0.3);
  }

  .cm__cameo-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 14%;
  }

  .cm__thanks-script {
    margin-top: 1.4cqw;
    font: 400 7.4cqw / 1.02 var(--font-script);
    color: #8a1426;
    -webkit-text-stroke: 0.2px currentColor;
    text-wrap: balance;
  }

  .cm__thanks-quote {
    font: italic 600 3.9cqw / 1.22 var(--font-display);
    color: #4a2418;
    text-wrap: balance;
  }

  .cm__thanks-sign {
    font: 700 3.1cqw / 1.2 var(--font-royal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #85540f;
  }

  /* The foot of the board: the Accept button, and the way on to the RSVP page once accepted */
  .cm__foot {
    display: grid;
    justify-items: center;
    gap: 2.2cqw;
    padding-bottom: 0.4cqw;
  }

  .cm__accept-wrap {
    position: relative;
  }

  /* The Accept button: a gold pill that blinks, so a guest knows to touch it */
  .cm__accept {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 11cqw;
    padding: 2.4cqw 7cqw;
    border: max(1px, 0.5cqw) solid #b8863a;
    border-radius: 999px;
    background: linear-gradient(180deg, #fff9e8, #f1d9a0);
    color: #6a0f1f;
    font: 700 4.4cqw / 1 var(--font-royal);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    box-shadow: 0 1px 2px rgba(60, 30, 5, 0.3);
    animation: cm-blink 1.5s ease-in-out infinite;
  }

  /* At least 44 px to tap, though the pill is drawn smaller */
  .cm__accept::before {
    content: '';
    position: absolute;
    inset: -10px -8px;
  }

  @keyframes cm-blink {
    0%,
    100% {
      border-color: #b8863a;
      background: linear-gradient(180deg, #fff9e8, #f1d9a0);
      box-shadow: 0 1px 2px rgba(60, 30, 5, 0.3), 0 0 0 0 rgba(236, 184, 72, 0);
    }

    50% {
      border-color: #e0a52f;
      background: linear-gradient(180deg, #fffdf2, #ffe9a8);
      box-shadow: 0 1px 2px rgba(60, 30, 5, 0.3), 0 0 5cqw 1.4cqw rgba(240, 180, 60, 0.9);
    }
  }

  .cm__accept:active {
    transform: scale(0.97);
  }

  .cm__accept:focus-visible,
  .cm__rsvp-link:focus-visible {
    outline: 2px solid #8a1426;
    outline-offset: 3px;
  }

  /* Once accepted the button stays lit in deep red, with a tick */
  .cm.is-accepted .cm__accept {
    animation: none;
    border-color: #e9c46a;
    background: linear-gradient(180deg, #a3182d, #6d0f1f);
    color: #fbe9b7;
    box-shadow: 0 1px 2px rgba(60, 30, 5, 0.4), 0 0 4cqw 0.8cqw rgba(240, 180, 60, 0.55);
  }

  .cm.is-accepted .cm__accept-text::before {
    content: '✓ ';
  }

  /* The tapping hand: a gold hand pointing up at the button, tapping, with soft rings from its fingertip */
  .cm__tap {
    position: absolute;
    left: 66%;
    top: 62%;
    width: 11cqw;
    aspect-ratio: 40 / 48;
    z-index: 3;
    pointer-events: none;
  }

  .cm__hand {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 2px 3px rgba(40, 8, 4, 0.55));
    animation: cm-tap 1.4s ease-in-out infinite;
  }

  @keyframes cm-tap {
    0%,
    100% {
      transform: translateY(0) scale(1);
      opacity: 1;
    }

    30% {
      transform: translateY(-9%) scale(0.94);
      opacity: 0.72;
    }

    55% {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  .cm__tap-ring {
    position: absolute;
    left: 29%;
    top: 4%;
    width: 150%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    border: 2px solid rgba(255, 236, 190, 0.95);
    box-shadow: 0 0 10px rgba(255, 210, 120, 0.8);
    animation: cm-ring 1.4s ease-out infinite;
  }

  .cm__tap-ring--late {
    animation-delay: 0.7s;
  }

  @keyframes cm-ring {
    0%,
    20% {
      transform: scale(0.2);
      opacity: 0;
    }

    32% {
      opacity: 1;
    }

    100% {
      transform: scale(1);
      opacity: 0;
    }
  }

  .cm.is-accepted .cm__tap {
    display: none;
  }

  .cm__rsvp-link {
    display: none;
    align-items: center;
    padding: 1.4cqw 5.2cqw;
    border: 1px solid rgba(138, 20, 38, 0.55);
    border-radius: 999px;
    background: rgba(255, 252, 244, 0.92);
    color: #8a1426;
    font: 700 3.6cqw / 1.1 var(--font-royal);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .cm__rsvp-link::before {
    content: '';
    position: absolute;
    inset: -8px -6px;
  }

  .cm__rsvp-link {
    position: relative;
  }

  .cm.is-thanks .cm__rsvp-link {
    display: inline-flex;
  }

  /* Without motion the button stays lit instead of blinking and the hand does not tap */
  .reduce-motion .cm__accept {
    animation: none;
    box-shadow: 0 1px 2px rgba(60, 30, 5, 0.3), 0 0 4cqw 1cqw rgba(240, 180, 60, 0.75);
  }

  .reduce-motion .cm__hand,
  .reduce-motion .cm__tap-ring {
    animation: none;
  }

  .reduce-motion .cm__tap-ring {
    opacity: 0.6;
    transform: scale(0.7);
  }

  /* Without scripts: the finished picture and the details (the pieces and crackers are placed by the
     script, so the plain picture shows) */
  html:not(.js) .cm__piece,
  html:not(.js) .cm__cracker,
  html:not(.js) .cm__tap,
  html:not(.js) .cm__accept {
    display: none;
  }
</style>
