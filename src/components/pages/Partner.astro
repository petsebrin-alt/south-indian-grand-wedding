---
/**
 * Pages 4–5 — Meet the Couple (PRD §6.6), one page per partner, from the client's groom-and-bride
 * picture (src/assets/couple/, npm run couple:assets): the groom's or bride's photograph behind,
 * "The Groom Rahul" / "The Bride Divya" in script letters that jump into place one by one, and their
 * interest polaroids (cut from the same picture) popping in one by one down both edges, as in the
 * client's reference video. Motion: src/motion/pages/couple.ts
 */
import PageShell from '../PageShell.astro';
import ScenePhoto from '../ScenePhoto.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import cards from '../../assets/couple/cards.json';
import groomPhoto from '../../assets/couple/groom.webp';
import groomPhotoAvif from '../../assets/couple/groom.avif';
import bridePhoto from '../../assets/couple/bride.webp';
import bridePhotoAvif from '../../assets/couple/bride.avif';

interface Props {
  page: BookPage;
  index: number;
  role: 'groom' | 'bride';
}

const { page, index, role } = Astro.props;
const person = wedding.couple[role];
const isGroom = role === 'groom';
const photo = isGroom ? { webp: groomPhoto, avif: groomPhotoAvif } : { webp: bridePhoto, avif: bridePhotoAvif };
const cardImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/couple/card-*.webp', { eager: true });
const cardSrc = (id: string) => cardImages[`../../assets/couple/card-${id}.webp`].default;
const mine = cards[role];
const columns = (['l', 'r'] as const).map((c) => mine.filter((card) => card.column === c));
const lines = [
  { text: 'The', size: 's' },
  { text: isGroom ? 'Groom' : 'Bride', size: 'l' },
  { text: person.name, size: 'l' },
];
---

<PageShell page={page} index={index} watermark={false} class:list={['pc', `pc--${role}`]}>
  <Fragment slot="architecture">
    <div class="layer layer--architecture pc__scene" aria-hidden="true">
      <ScenePhoto class="pc__photo" avif={photo.avif} webp={photo.webp} defer />
    </div>
  </Fragment>

  <h2 class="pc__title" tabindex="-1" data-page-heading aria-label={`The ${isGroom ? 'Groom' : 'Bride'}, ${person.name}`}>
    {
      lines.map((l) => (
        <span class={`pc__line pc__line--${l.size}`} aria-hidden="true">
          {[...l.text].map((ch) => (
            <span class="pc__ch">{ch}</span>
          ))}
        </span>
      ))
    }
  </h2>

  <!-- Their interests, down both edges -->
  {
    columns.map((col, c) => (
      <ul class={`pc__col pc__col--${c ? 'r' : 'l'}`} aria-label={c ? undefined : `${person.name}'s interests`}>
        {col.map((card) => {
          const img = cardSrc(card.id);
          return (
            <li class="pc__card">
              <img src={img.src} width={img.width} height={img.height} alt={card.label} decoding="async" loading="lazy" />
            </li>
          );
        })}
      </ul>
    ))
  }
</PageShell>

<style is:global>
  .pc .page__frame {
    display: none;
  }

  /* The photograph (the couple sitting in the temple courtyard, their feet on the marble) covers the page,
     from the foot up, so the floor and the feet always show (a short page crops only the sky) */
  .pc__scene {
    inset: 0;
    overflow: hidden;
  }

  .pc__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }

  .pc .page__content {
    inset: 0;
    display: block;
  }

  /* "The Groom Rahul": script letters in the sky above the photograph's subject */
  .pc__title {
    position: absolute;
    left: 22cqw;
    right: 22cqw;
    top: calc(var(--safe-top) + 9cqh);
    display: grid;
    justify-items: center;
    font-family: var(--font-script);
    font-weight: 400;
    color: #7a1f2b;
    text-shadow: 0 0 2px rgba(255, 249, 238, 0.95), 0 0 12px rgba(255, 249, 238, 0.85);
    -webkit-text-stroke: 0.35px currentColor;
    white-space: nowrap;
  }

  .pc__line {
    display: block;
    line-height: 1.02;
  }

  .pc__line--s {
    font-size: min(8cqw, 4.6cqh);
  }

  .pc__line--l {
    font-size: min(15cqw, 8.4cqh);
  }

  .pc__line--l + .pc__line--l {
    margin-top: -0.12em;
  }

  .pc__ch {
    display: inline-block;
  }

  /* The polaroids: two columns at the edges, spread evenly from below the title to the foot */
  .pc__col {
    position: absolute;
    top: calc(var(--safe-top) + 16cqh);
    bottom: calc(var(--safe-bottom) + 5cqh);
    width: min(26cqw, 15.5cqh);
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .pc__col--l {
    left: 2cqw;
  }

  .pc__col--r {
    right: 2cqw;
    top: calc(var(--safe-top) + 21cqh);
  }

  .pc__card img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 3px 4px rgba(50, 25, 10, 0.35));
  }
</style>
