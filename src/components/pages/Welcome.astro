---
/**
 * Page 1 — Welcome Invitation (PRD §6.2), staged like the client's reference: their temple
 * courtyard photograph (the seated figure taken out; src/assets/welcome/, npm run welcome:assets),
 * the couple standing together at its front, and above them their names written in script with the date,
 * time, place and welcome message. Garlands, bells, the banana leaf and the palms stir in the
 * breeze and red garland flowers drift down. Motion: src/motion/pages/welcome.ts
 */
import PageShell from '../PageShell.astro';
import Ornament from '../Ornament.astro';
import Draft from '../Draft.astro';
import ScenePhoto from '../ScenePhoto.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import { formatDateLong, formatTime } from '../../lib/format';
import { lettering } from '../../lib/handwriting';
import scene from '../../assets/welcome/scene.json';
import courtyard from '../../assets/welcome/courtyard.webp';
import courtyardAvif from '../../assets/welcome/courtyard.avif';
import couple from '../../assets/welcome/couple.webp';
import coupleAvif from '../../assets/welcome/couple.avif';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
const { groom, bride } = wedding.couple;
const { startISO, city } = wedding.ceremony;
const names = lettering([`${groom.name} & ${bride.name}`]);

const { width: PW, height: PH } = scene.photo;
const pct = (n: number) => `${+n.toFixed(3)}%`;
const box = ([x0, y0, x1, y1]: number[]) => `left:${pct((x0 / PW) * 100)};top:${pct((y0 / PH) * 100)};width:${pct(((x1 - x0) / PW) * 100)};height:${pct(((y1 - y0) / PH) * 100)}`;
/** The whole photograph inside a piece's box, offset so the piece's region shows. */
const crop = ([x0, y0, x1, y1]: number[]) => `width:${pct((PW / (x1 - x0)) * 100)};left:${pct((-x0 / (x1 - x0)) * 100)};top:${pct((-y0 / (y1 - y0)) * 100)}`;
---

<PageShell page={page} index={index} watermark={false} class="wl">
  <Fragment slot="architecture">
    <!-- The temple courtyard; pieces of it stir in the breeze -->
    <div class="layer layer--architecture wl-scene" style={`--ratio:${PH / PW}`} aria-hidden="true">
      <div class="wl-scene__inner" data-wl-scene>
        <ScenePhoto class="wl-scene__photo" avif={courtyardAvif} webp={courtyard} defer />
        {
          scene.wind.pieces.map((w) => (
            <div class={`wl-wind wl-wind--${w.feather}`} data-wind={w.amp} style={`${box(w.box)};transform-origin:${w.pivot[0]}% ${w.pivot[1]}%`}>
              <ScenePhoto avif={courtyardAvif} webp={courtyard} style={crop(w.box)} defer />
            </div>
          ))
        }
      </div>
    </div>
    <!-- Soft morning haze behind the lettering, so it reads over the photograph -->
    <span class="layer layer--architecture wl-haze" aria-hidden="true"></span>
  </Fragment>

  <h2 class="wl__names" tabindex="-1" data-page-heading>
    <span class="sr-only">{groom.name} &amp; {bride.name}</span>
    <svg class="wl__script" viewBox={names.viewBox} aria-hidden="true" focusable="false">
      {names.glyphs.map((g) => <path class="wl__glyph" d={g.d} />)}
    </svg>
  </h2>
  <Ornament name="divider-line" class="divider wl__divider" />
  <div class="wl__details">
    <p class="wl__date wl__detail">{formatDateLong(startISO)}</p>
    <p class="wl__time wl__detail">{formatTime(startISO)} IST</p>
    <p class="wl__place wl__detail">{city}</p>
  </div>
  <p class="wl__message"><Draft copy={wedding.copy.welcomeMessage} /></p>

  <Fragment slot="foreground">
    <!-- The couple, standing together in the courtyard -->
    <div class="layer layer--foreground wl-couple" style={`--h:${scene.couple.height}cqh;--b:${scene.couple.bottom}cqh;aspect-ratio:${couple.width} / ${couple.height}`} aria-hidden="true">
      <span class="wl-couple__glow"></span>
      <div class="wl-couple__body">
        <ScenePhoto class="wl-couple__img" avif={coupleAvif} webp={couple} defer />
      </div>
    </div>
  </Fragment>
</PageShell>

<style is:global>
  /* Full-bleed photograph: no drawn frame */
  .page--welcome .page__frame {
    display: none;
  }

  /* The photograph covers the page at its own proportions (wider screens crop its sides) */
  .wl-scene {
    left: 50%;
    top: 50%;
    height: max(100cqh, calc(100cqw * var(--ratio)));
    aspect-ratio: 1 / var(--ratio);
    translate: -50% -50%;
    overflow: hidden;
  }

  .wl-scene__inner {
    position: absolute;
    inset: 0;
    transform-origin: 50% 70%;
  }

  .wl-scene__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Pieces of the photograph that sway; their edges fade into the still photograph */
  .wl-wind {
    position: absolute;
    overflow: hidden;
    will-change: transform;
    mask-image: linear-gradient(90deg, transparent 0, #000 18%, #000 82%, transparent 100%), linear-gradient(180deg, #000 0, #000 80%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 18%, #000 82%, transparent 100%), linear-gradient(180deg, #000 0, #000 80%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  .wl-wind--all {
    mask-image: linear-gradient(90deg, transparent 0, #000 22%, #000 78%, transparent 100%), linear-gradient(180deg, transparent 0, #000 22%, #000 78%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22%, #000 78%, transparent 100%), linear-gradient(180deg, transparent 0, #000 22%, #000 78%, transparent 100%);
  }

  .wl-wind img {
    position: absolute;
    height: auto;
    max-width: none;
  }

  /* Only a light veil behind the lettering, so the courtyard stays clear */
  .wl-haze {
    inset: 0;
    background: radial-gradient(ellipse 70% 22% at 50% 25%, rgba(255, 248, 238, 0.5), rgba(255, 248, 238, 0.22) 55%, rgba(255, 248, 238, 0) 80%);
  }

  /* The lettering sits in the sky above the couple */
  .page--welcome .page__content {
    inset-block: calc(var(--safe-top) + 5cqh) calc(var(--safe-bottom) + 47cqh);
    gap: 1.3cqh;
  }

  .wl__names {
    width: 100%;
  }

  .wl__script {
    display: block;
    width: min(82cqw, 100%);
    max-height: 11cqh;
    margin-inline: auto;
    overflow: visible;
    filter: drop-shadow(0 0 6px rgba(255, 248, 236, 0.95));
  }

  /* Finished state (no JavaScript, revisits, reduced motion): solid ink */
  .wl__glyph {
    fill: #7a1f2b;
    stroke: #7a1f2b;
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  .wl__divider {
    width: 48cqw;
    color: #a8782a;
  }

  .wl__details {
    display: grid;
    gap: 0.5cqh;
    text-shadow: 0 0 10px rgba(255, 248, 236, 0.95), 0 0 2px rgba(255, 248, 236, 0.9);
  }

  .wl__date {
    font: 600 clamp(19px, 5.4cqw, 24px) / 1.2 var(--font-display);
    color: #4a2418;
  }

  .wl__time {
    font: 600 12px / 1.4 var(--font-royal);
    letter-spacing: 0.2em;
    color: #85540f;
  }

  .wl__place {
    font: 500 14px / 1.4 var(--font-body);
    color: #5a3626;
  }

  .wl__message {
    max-width: 30em;
    font: italic 500 clamp(15px, 4.3cqw, 18px) / 1.35 var(--font-display);
    color: #4a2418;
    text-shadow: 0 0 10px rgba(255, 248, 236, 0.95), 0 0 2px rgba(255, 248, 236, 0.9);
  }

  /* The couple, standing at the front of the courtyard */
  .wl-couple {
    left: 50%;
    bottom: var(--b);
    height: var(--h);
    translate: -50% 0;
  }

  /* Warm morning light behind them, brightening as they arrive */
  .wl-couple__glow {
    position: absolute;
    inset: -8% -20% 10%;
    background: radial-gradient(ellipse 50% 46% at 50% 40%, rgba(255, 226, 170, 0.5), rgba(255, 226, 170, 0) 70%);
  }

  /* A slow breath, so the couple is never quite still */
  .wl-couple__body {
    position: absolute;
    inset: 0;
    transform-origin: 50% 100%;
    animation: wl-breathe 4.8s ease-in-out infinite alternate;
  }

  @keyframes wl-breathe {
    to {
      transform: scale(1.004, 1.009);
    }
  }

  .reduce-motion .wl-couple__body {
    animation: none;
  }

  .wl-couple__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  @container app (max-height: 700px) {
    .page--welcome .page__content {
      inset-block-end: calc(var(--safe-bottom) + 44cqh);
      gap: 1cqh;
    }

    .wl__message {
      font-size: 15px;
    }

    .wl-couple {
      --h: 44cqh;
    }
  }

  @container app (max-height: 620px) {
    .wl__message {
      display: none;
    }
  }
</style>
