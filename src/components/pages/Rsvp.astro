---
/**
 * Page 16 — RSVP (PRD §6.16, THEME §13 P17). The card shows Step 1; tapping any of its fields
 * lifts it into focus mode (RsvpForm.astro) with that choice made. Behaviour: src/forms/rsvp.ts
 */
import PageShell from '../PageShell.astro';
import Decor from '../Decor.astro';
import Ornament from '../Ornament.astro';
import Ph from '../Ph.astro';
import type { BookPage } from '../../data/pages';
import { wedding } from '../../data/wedding';
import { formatDateLong } from '../../lib/format';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
const deadline = wedding.rsvp.deadline ? formatDateLong(`${wedding.rsvp.deadline}T12:00:00+05:30`) : null;
---

<PageShell page={page} index={index} watermark={false} class="rv" note="Placeholder art: D-33 handmade paper (CSS), D-03 jasmine, D-17 kalasam, S-01 corners, S-15 zari band. Responses are stored by the RSVP backend and emailed to the families.">
  <div class="rv__card" data-rsvp-page>
    {['tl', 'tr', 'bl', 'br'].map((c) => <Ornament name="kolam-corner" class={`rv__corner rv__corner--${c}`} />)}
    <Decor name="jasmine-cluster" asset="D-03" class="rv__jasmine rv__jasmine--l sway" style="--sway:2.5deg;--sway-dur:5.5s" />
    <Decor name="jasmine-cluster" asset="D-03" class="rv__jasmine rv__jasmine--r sway" style="--sway:2.5deg;--sway-dur:6.2s;--sway-delay:-2s" />
    <Decor name="kalasam-crest" asset="D-17" class="rv__crest" />

    <h2 class="page-title rv__line" tabindex="-1" data-page-heading>Kindly Respond</h2>
    <p class="caption rv__line" data-hide-if-missing>by <Ph value={deadline} label="RSVP deadline" /></p>

    <div class="rv__preview rv__line" data-rsvp-preview>
      <button class="rv__ruled" type="button" data-open-dialog="rsvp-form" data-rsvp-intent="name" aria-haspopup="dialog" data-needs-api="RSVP">
        <span class="rv__ruled-label">Guest name</span>
        <span class="rv__ruled-line" aria-hidden="true"></span>
      </button>
      <div class="rv__choices" role="group" aria-label="Will you attend?">
        <button class="choice-card" type="button" data-open-dialog="rsvp-form" data-rsvp-intent="accept" aria-haspopup="dialog" data-needs-api="RSVP">
          <span class="choice-card__title">Joyfully accept</span>
          <span class="choice-card__sub">I'll be there</span>
        </button>
        <button class="choice-card" type="button" data-open-dialog="rsvp-form" data-rsvp-intent="decline" aria-haspopup="dialog" data-needs-api="RSVP">
          <span class="choice-card__title">Regretfully decline</span>
          <span class="choice-card__sub">Sending blessings</span>
        </button>
      </div>
    </div>

    <div class="rv__status rv__line" data-rsvp-status hidden>
      <p class="rv__status-label">Your response</p>
      <p class="rv__status-text" data-rsvp-status-text></p>
    </div>
    <p class="rv__closed" data-rsvp-closed hidden>RSVPs have now closed. Please contact the families on the Need Help page.</p>

    <button class="btn-primary rv__open rv__line" type="button" data-open-dialog="rsvp-form" aria-haspopup="dialog" data-rsvp-open data-needs-api="RSVP">Respond now</button>
    <p class="rv__privacy rv__line">
      Your response is shared only with the families.{' '}
      <button class="link-button" type="button" data-open-dialog="privacy" aria-haspopup="dialog">How we use your details</button>
    </p>
    <span class="rv__zari" aria-hidden="true"></span>
  </div>
</PageShell>

<style is:global>
  .rv {
    background-image: var(--paper-texture), radial-gradient(ellipse at 50% 30%, rgba(255, 249, 239, 0.6), rgba(234, 216, 183, 0) 70%);
  }

  .rv__card {
    position: relative;
    width: 108%;
    display: grid;
    justify-items: center;
    gap: 1.5cqh;
    padding: 7cqh 7cqw 6.5cqh;
    background-color: var(--jasmine);
    background-image: var(--paper-texture);
    background-blend-mode: multiply;
    border-radius: 3px;
    box-shadow:
      inset 0 0 0 1.5px var(--gold),
      inset 0 0 0 6px var(--jasmine),
      inset 0 0 0 7px var(--gold),
      0 18px 34px rgba(75, 48, 38, 0.22);
  }

  .rv__corner {
    position: absolute;
    width: 11cqw;
    color: var(--gold);
    opacity: 0.75;
    pointer-events: none;
  }

  .rv__corner--tl {
    left: 10px;
    top: 10px;
  }

  .rv__corner--tr {
    right: 10px;
    top: 10px;
    transform: scaleX(-1);
  }

  .rv__corner--bl {
    left: 10px;
    bottom: 10px;
    transform: scaleY(-1);
  }

  .rv__corner--br {
    right: 10px;
    bottom: 10px;
    transform: scale(-1);
  }

  .rv__crest {
    position: absolute;
    left: 50%;
    top: -5.5cqh;
    width: 15cqw;
    translate: -50% 0;
  }

  .rv__jasmine {
    position: absolute;
    top: -3cqh;
    width: 17cqw;
    transform-origin: 50% 0;
    pointer-events: none;
  }

  .rv__jasmine--l {
    left: -3cqw;
  }

  .rv__jasmine--r {
    right: -3cqw;
    scale: -1 1;
  }

  .rv__preview {
    display: grid;
    gap: 1.6cqh;
    width: 100%;
  }

  .rv__ruled {
    display: grid;
    gap: 6px;
    width: 100%;
    min-height: 48px;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: text;
  }

  .rv__ruled-label {
    font: 500 11px/1.4 var(--font-royal);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .rv__ruled-line {
    height: 26px;
    border-bottom: 1px solid var(--hairline);
  }

  .rv__choices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .rv__choices .choice-card {
    font: inherit;
    cursor: pointer;
  }

  .rv__choices .choice-card:active {
    transform: scale(0.97);
  }

  .rv__status {
    width: 100%;
    padding: 1.4cqh 4cqw;
    border: 1px dashed var(--gold);
    border-radius: 10px;
    background: rgba(244, 234, 214, 0.5);
  }

  .rv__status-label {
    font: 500 10px/1.4 var(--font-royal);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .rv__status-text {
    font: 600 17px/1.35 var(--font-display);
    color: var(--brown);
  }

  .rv__closed {
    font-size: 14px;
    color: var(--maroon);
  }

  .rv__open {
    width: 100%;
    min-height: 52px;
  }

  .rv__privacy {
    font-size: 13px;
    line-height: 1.5;
    color: var(--brown-soft);
  }

  .rv__zari {
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: 2.2cqh;
    height: 10px;
    background: url('../../assets/placeholders/zari-band.svg') repeat-x center / auto 100%;
    opacity: 0.85;
  }

  @container app (max-height: 699px) {
    .rv__card {
      gap: 1.1cqh;
      padding-block: 6cqh 5.5cqh;
    }

    .rv__privacy {
      font-size: 12px;
    }
  }
</style>
