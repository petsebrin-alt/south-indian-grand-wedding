---
/** Page 14 — Transportation and Accommodation (PRD §6.14, THEME §13 P15). Motion: src/motion/pages/travel.ts */
import PageShell from '../PageShell.astro';
import Decor from '../Decor.astro';
import Icon from '../Icon.astro';
import type { BookPage } from '../../data/pages';
import { assistanceContact, travelItem, travelTiles, whatsappLink } from '../../lib/travel';

interface Props {
  page: BookPage;
  index: number;
}

const { page, index } = Astro.props;
const helper = assistanceContact();
const pendingHelp = 'The guest-assistance contact will be shared soon';
---

<PageShell page={page} index={index} watermark={false} class="tv" note="Placeholder art: D-36 travel board (CSS), D-03 jasmine and D-05 marigold corners, D-13 thoranam. Airport and railway facts are marked to verify before launch.">
  <div class="tv__board">
    <Decor name="mango-toran" asset="D-13" class="tv__toran" />
    <Decor name="jasmine-cluster" asset="D-03" class="tv__corner tv__corner--tl" />
    <Decor name="jasmine-cluster" asset="D-03" class="tv__corner tv__corner--tr" />
    <Decor name="marigold-cluster" asset="D-05" class="tv__corner tv__corner--bl" />
    <Decor name="marigold-cluster" asset="D-05" class="tv__corner tv__corner--br" />

    <h2 class="page-title tv__title" tabindex="-1" data-page-heading>Travel &amp; Stay</h2>
    <p class="caption tv__intro">Getting to Tirupati, finding your way and resting well</p>

    <ul class="tv__tiles">
      {
        travelTiles.map(({ key, icon }) => {
          const item = travelItem(key);
          return (
            <li>
              <button class="tv__tile" type="button" data-open-dialog={`travel-${key}`} aria-haspopup="dialog">
                <span class="tv__icon" aria-hidden="true">
                  <Icon name={icon} />
                </span>
                <span class="tv__tile-title">{item.title}</span>
                <span class="tv__tile-summary">{item.status === 'toBeConfirmed' ? 'To be announced' : item.summary}</span>
              </button>
            </li>
          );
        })
      }
    </ul>

    <div class="tv__ribbon">
      <span class="tv__ribbon-text"><Icon name="help" /> Need travel help?</span>
      <span class="tv__ribbon-actions">
        {
          helper?.phone ? (
            <a class="tv__ribbon-btn" href={`tel:${helper.phone}`}>
              <Icon name="phone" /> Call
            </a>
          ) : (
            <button class="tv__ribbon-btn" type="button" aria-disabled="true" data-disabled-message={pendingHelp}>
              <Icon name="phone" /> Call
            </button>
          )
        }
        {
          helper?.whatsapp ? (
            <a class="tv__ribbon-btn" href={whatsappLink(helper.whatsapp)} target="_blank" rel="noopener">
              <Icon name="chat" /> WhatsApp
            </a>
          ) : (
            <button class="tv__ribbon-btn" type="button" aria-disabled="true" data-disabled-message={pendingHelp}>
              <Icon name="chat" /> WhatsApp
            </button>
          )
        }
      </span>
    </div>
  </div>
</PageShell>

<style is:global>
  .tv .page__content {
    inset-inline: 5cqw;
  }

  /* D-36 carved ivory travel board */
  .tv__board {
    position: relative;
    width: 100%;
    display: grid;
    justify-items: center;
    gap: 1.1cqh;
    padding: 5cqh 5cqw 2cqh;
    background-color: var(--jasmine);
    background-image: var(--paper-texture);
    background-blend-mode: multiply;
    border-radius: 10px;
    box-shadow:
      inset 0 0 0 2px var(--gold),
      inset 0 0 0 7px var(--jasmine),
      inset 0 0 0 8px var(--hairline),
      0 16px 32px rgba(75, 48, 38, 0.2);
  }

  .tv__toran {
    position: absolute;
    left: 6%;
    top: 4px;
    width: 88%;
  }

  .tv__corner {
    position: absolute;
    width: 20cqw;
    pointer-events: none;
  }

  .tv__corner--tl {
    left: -3cqw;
    top: -3cqw;
  }

  .tv__corner--tr {
    right: -3cqw;
    top: -3cqw;
    transform: scaleX(-1);
  }

  .tv__corner--bl {
    left: -3cqw;
    bottom: -3cqw;
    transform: scaleY(-1);
  }

  .tv__corner--br {
    right: -3cqw;
    bottom: -3cqw;
    transform: scale(-1, -1);
  }

  .tv__title {
    margin-top: 1cqh;
  }

  .tv__tiles {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.6cqw;
  }

  .tv__tile {
    width: 100%;
    height: 100%;
    min-height: 12.5cqh;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 4px;
    padding: 1.6cqh 3cqw;
    text-align: left;
    border: 0;
    border-radius: 8px;
    background: rgba(255, 253, 248, 0.94);
    box-shadow:
      inset 0 0 0 1px var(--gold),
      inset 0 0 0 4px var(--jasmine),
      inset 0 0 0 5px var(--hairline);
  }

  .tv__tile:active {
    transform: scale(0.98);
  }

  .tv__icon {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--sandal-light);
    color: var(--gold-text);
  }

  .tv__icon svg {
    width: 20px;
    height: 20px;
  }

  .tv__tile-title {
    font: 600 12px/1.3 var(--font-royal);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brown);
  }

  .tv__tile-summary {
    font-size: 13px;
    line-height: 1.4;
    color: var(--brown-soft);
  }

  .tv__ribbon {
    width: calc(100% + 6cqw);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px;
    background: var(--maroon);
    color: var(--ivory);
    box-shadow: inset 0 0 0 1px var(--gold);
    clip-path: polygon(0 0, 100% 0, 97% 50%, 100% 100%, 0 100%, 3% 50%);
  }

  .tv__ribbon-text {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 600 13px/1.2 var(--font-body);
  }

  .tv__ribbon-text svg,
  .tv__ribbon-btn svg {
    width: 18px;
    height: 18px;
  }

  .tv__ribbon-actions {
    display: flex;
    gap: 6px;
  }

  .tv__ribbon-btn {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0 10px;
    border: 1px solid var(--gold);
    border-radius: 999px;
    background: transparent;
    color: var(--ivory);
    font: 600 12px/1 var(--font-body);
    text-decoration: none;
  }

  .tv__ribbon-btn[aria-disabled='true'] {
    opacity: 0.6;
    border-style: dashed;
  }

  @container app (max-height: 699px) {
    .tv__intro {
      display: none;
    }

    .tv__tile {
      min-height: 9cqh;
      padding-block: 0.7cqh;
      gap: 2px;
    }

    .tv__tiles {
      gap: 2cqw;
    }

    .tv__tile-summary {
      font-size: 12px;
    }

    .tv__board {
      gap: 1cqh;
      padding-top: 5cqh;
    }
  }
</style>
