---
/** Contact details sheet for one Need Help card (PRD §6.17). Rendered at the app root; max 80% of the screen. */
import Icon from './Icon.astro';
import Ph from './Ph.astro';
import { contactEmblem, NUMBER_SOON } from '../lib/contacts';
import { whatsappLink } from '../lib/travel';
import { formatPhone } from '../lib/format';
import type { wedding } from '../data/wedding';

interface Props {
  contact: (typeof wedding.contacts)[number];
}

const { contact: c } = Astro.props;
const titleId = `contact-${c.id}-title`;
---

<div id={`contact-${c.id}`} class="sheet contact-sheet" role="dialog" aria-modal="true" aria-labelledby={titleId} hidden>
  <div class="sheet__panel">
    <span class="sheet__handle" aria-hidden="true"></span>
    <header class="sheet__header">
      <h2 id={titleId} class="sheet__title">{c.role}</h2>
      <button class="overlay__close" type="button" data-dialog-close data-autofocus aria-label="Close">
        <Icon name="close" />
      </button>
    </header>
    <div class="contact-sheet__body">
      <span class="contact-sheet__emblem" aria-hidden="true"><Icon name={contactEmblem[c.id] ?? 'lotus'} /></span>
      <p class="contact-sheet__name"><Ph value={c.name} label="Name" fallback="Name to be shared soon" /></p>
      {c.languages.length > 0 && <p class="contact-sheet__langs">Speaks {c.languages.join(', ')}</p>}

      <dl class="contact-sheet__rows">
        <div>
          <dt>Phone</dt>
          <dd>{c.phone ? formatPhone(c.phone) : <Ph value={null} label="Phone number" fallback={NUMBER_SOON} />}</dd>
        </div>
        <div>
          <dt>WhatsApp</dt>
          <dd>{c.whatsapp ? formatPhone(c.whatsapp) : <Ph value={null} label="WhatsApp number" fallback={NUMBER_SOON} />}</dd>
        </div>
      </dl>

      <div class="sheet__list">
        {
          c.phone ? (
            <a class="sheet__item" href={`tel:${c.phone}`}>
              <Icon name="phone" /> Call
            </a>
          ) : (
            <button class="sheet__item" type="button" aria-disabled="true" data-disabled-message={NUMBER_SOON}>
              <Icon name="phone" /> Call — {NUMBER_SOON.toLowerCase()}
            </button>
          )
        }
        {
          c.whatsapp ? (
            <a class="sheet__item" href={whatsappLink(c.whatsapp)} target="_blank" rel="noopener noreferrer">
              <Icon name="chat" /> WhatsApp
            </a>
          ) : (
            <button class="sheet__item" type="button" aria-disabled="true" data-disabled-message={NUMBER_SOON}>
              <Icon name="chat" /> WhatsApp — {NUMBER_SOON.toLowerCase()}
            </button>
          )
        }
        {
          c.phone ? (
            <button class="sheet__item" type="button" data-copy={c.phone} data-copy-message="Number copied">
              <Icon name="copy" /> Copy number
            </button>
          ) : (
            <button class="sheet__item" type="button" aria-disabled="true" data-disabled-message={NUMBER_SOON}>
              <Icon name="copy" /> Copy number
            </button>
          )
        }
      </div>
    </div>
  </div>
</div>

<style is:global>
  .contact-sheet .sheet__panel {
    max-height: 80%;
  }

  .contact-sheet .sheet__title {
    padding-inline: 44px;
    font-size: 13px;
    text-align: center;
  }

  .contact-sheet__body {
    display: grid;
    justify-items: center;
    gap: 8px;
    padding-top: 4px;
    text-align: center;
  }

  .contact-sheet__emblem {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--gold);
    background: radial-gradient(circle at 40% 35%, #fffaf0, var(--sandal-light));
    color: var(--gold-text);
  }

  .contact-sheet__emblem svg {
    width: 32px;
    height: 32px;
  }

  .contact-sheet__name {
    font: 600 22px/1.25 var(--font-display);
    color: var(--brown);
  }

  .contact-sheet__langs {
    font-size: 14px;
    color: var(--brown-soft);
  }

  .contact-sheet__rows {
    display: grid;
    gap: 6px;
    width: 100%;
    margin: 6px 0 10px;
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(244, 234, 214, 0.55);
    text-align: left;
  }

  .contact-sheet__rows div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .contact-sheet__rows dt {
    font: 500 11px/1.8 var(--font-royal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .contact-sheet__rows dd {
    font: 600 15px/1.5 var(--font-body);
    color: var(--brown);
    font-variant-numeric: tabular-nums;
  }

  .contact-sheet .sheet__list {
    width: 100%;
  }

  .contact-sheet .sheet__item[aria-disabled='true'] {
    color: var(--brown-soft);
    opacity: 0.75;
  }
</style>
