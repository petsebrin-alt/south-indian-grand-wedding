# Copy to .env.production (never commit real secrets). See supabase/README.md.

# Base URL of the Supabase Edge Functions, e.g. https://<project-ref>.supabase.co/functions/v1
# In development the dev server serves the same API at /api, so this can stay unset.
PUBLIC_API_BASE=

# Cloudflare Turnstile site key (public). Its secret goes in the Supabase secret TURNSTILE_SECRET.
PUBLIC_TURNSTILE_SITE_KEY=

# For the family admin page sign-in (Supabase Auth magic links). The anon key is public by design.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
